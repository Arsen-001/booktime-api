  status       String   @db.VarChar(12)
  data         Json
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([ownerStaffId, createdAt])
  @@index([businessId])
  @@map("integration_dev_apps")
}

/// Заявка партнёру напрямую (F-13-137: 2GIS, Earlyone, DOQ.kz — без листа подключения)
model IntegrationPartnerApplication {
  id         String   @id @db.VarChar(32)
  appId      String   @map("app_id") @db.VarChar(40)
  businessId String   @map("business_id") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([businessId, appId])
  @@map("integration_partner_applications")
}
// === end stage 21 (сдача, попытка 6) ===

// === stage 21 (сдача, попытка 6: чат через партнёра) ===
/// Переписка с клиентом через бота-партнёра (F-05-087/088). Настоящего обмена с партнёром нет (Р19): входящие
/// приходят демо-кнопкой «клиент написал» (место будущего вебхука партнёра), исходящие хранятся здесь.
model NotifyChatMessage {
  id             String    @id @db.VarChar(32)
  businessId     String    @map("business_id") @db.VarChar(32)
  phone          String    @db.VarChar(20)
  clientId       String?   @map("client_id") @db.VarChar(32)
  /// in | out
  direction      String    @db.VarChar(3)
  text           String    @db.Text
  attachmentName String?   @map("attachment_name") @db.VarChar(200)
  /// Входящее прочитано (счётчик «непрочитанных» F-05-088 — входящие без readAt)
  readAt         DateTime? @map("read_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId, phone, createdAt])
  @@index([businessId, direction, readAt])
  @@map("notify_chat_messages")
}
// === end stage 21 (сдача, попытка 6: чат через партнёра) ===

// === Заказы (03.10.2026, решение владельца): ателье, ремонт телефонов, химчистка, детейлинг ===
/// Заказ «сдал вещь — забрал готовую»: что принято, фото, срок, цена, предоплата, статус. Клиент видит статус по
/// публичной ссылке /o/<code> без входа и получает уведомление «готов». Номер — свой у бизнеса (1001, 1002, …).
model Order {
  id              String    @id @db.VarChar(32)
  businessId      String    @map("business_id") @db.VarChar(32)
  locationId      String?   @map("location_id") @db.VarChar(32)
  /// Номер для людей — уникален в бизнесе, с 1001 (order_counters)
  number          Int
  /// Публичный токен ссылки /o/<code>: 10 знаков base62 из crypto
  code            String    @unique @db.VarChar(16)
  clientId        String?   @map("client_id") @db.VarChar(32)
  clientName      String    @map("client_name") @db.VarChar(160)
  /// '+374XXXXXXXX'
  clientPhone     String    @map("client_phone") @db.VarChar(16)
  /// { title, qty, note? }[]
  items           Json
  /// string[] — адреса/data URI, как Business.photos
  photos          Json
  staffId         String?   @map("staff_id") @db.VarChar(32)
  /// received | in_progress | ready | issued | cancelled
  status          String    @default("received") @db.VarChar(12)
  /// 'YYYY-MM-DD'
  dueDate         String?   @map("due_date") @db.VarChar(10)
  /// Драмы, целые
  price           Int       @default(0)
  prepaid         Int       @default(0)
  /// Внутренний комментарий — клиенту не показывается
  comment         String?   @db.VarChar(2000)
  /// { at, status, by }[]
  history         Json
  readyNotifiedAt DateTime? @map("ready_notified_at") @db.DateTime(3)
  issuedAt            DateTime? @map("issued_at") @db.DateTime(3)
  /// Авто-напоминания «заказ готов и ждёт вас» за текущий «Готов» (04.10.2026; сбрасываются при новом переходе в ready)
  pickupReminderCount Int       @default(0) @map("pickup_reminder_count")
  pickupRemindedAt    DateTime? @map("pickup_reminded_at") @db.DateTime(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([businessId, number])
  @@index([status, pickupReminderCount])
  @@index([businessId, status, createdAt])
  @@index([businessId, createdAt])
  @@index([clientId])
  @@map("orders")
}

/// Последний выданный номер заказа бизнеса — атомарный UPDATE … +1 в транзакции создания заказа
model OrderCounter {
  businessId String @id @map("business_id") @db.VarChar(32)
  lastNumber Int    @map("last_number")

  @@map("order_counters")
}
// === end заказы ===

// === файлы и фото (04.10.2026) ===
/// Загруженное фото (POST /v1/biz/:businessId/uploads, /v1/me/uploads, /v1/platform/uploads): владелец — для квоты,
/// прав и будущей уборки неиспользуемых файлов. Сам файл — в хранилище (диск UPLOADS_DIR или S3) по `key`;
/// превью — тот же ключ с суффиксом _t. Поля фото в других таблицах по-прежнему строки-адреса.
model Upload {
  id         String   @id @db.VarChar(32)
  /// Бизнес-владелец (кабинет); null — фото человека (/v1/me) или нашей панели
  businessId String?  @map("business_id") @db.VarChar(32)
  /// Человек-владелец (/v1/me/uploads); null — фото бизнеса или панели
  userId     String?  @map("user_id") @db.VarChar(32)
  /// uploads/<владелец>/<sha256[:32]>.<jpg|webp> (фото) или client-files/<бизнес>/<sha256[:32]>.<ext> (документ клиента,
  /// закрытое хранилище) — по содержимому: тот же файл того же владельца → та же строка
  key        String   @unique @db.VarChar(200)
  /// image/jpeg, image/webp; документы клиентов (client-files/…) — application/pdf, Office и т.п.
  mime       String   @db.VarChar(120)
  /// Основной файл + превью, байт (для квоты)
  bytes      Int
  width      Int
  height     Int
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  /// staffId / userId / platformMemberId загрузившего
  createdBy  String?  @map("created_by") @db.VarChar(32)

  @@index([businessId, createdAt])
  @@index([userId, createdAt])
  /// Уборка неиспользуемых файлов (jobs/uploads-cleanup.ts): строки старше 7 дней
  @@index([createdAt])
  @@map("uploads")
}
// === end файлы и фото ===
