// BookTime — схема базы (MySQL, UTC). Модель — docs/backend/01-data-model.md фронта, перевод на MySQL — PLAN.md §4.
// Соглашения: id VARCHAR(32) "<префикс>_<ULID>"; деньги BIGINT драмы; время DATETIME(3) UTC; у каждой таблицы
// created_at / updated_at / created_by / updated_by / version; внешний ключ — всегда с индексом.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

/// Системные значения (версия схемы, флаги каркаса). Этап 0: чтобы миграции и связь с базой проверялись с первого дня.
model SystemSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(1)

  @@map("system_settings")
}

/// Журнал изменений «кто, когда, что» (docs/backend/01-data-model.md §11). Не правится и не чистится из интерфейса.
/// Добавление — в той же транзакции, что и сама правка (AuditService.record(tx, …)).
model AuditEvent {
  id         String   @id @db.VarChar(32)
  businessId String?  @map("business_id") @db.VarChar(32)
  networkId  String?  @map("network_id") @db.VarChar(32)
  /// staff | client | link_holder | system | platform
  actorType  String   @map("actor_type") @db.VarChar(16)
  actorId    String?  @map("actor_id") @db.VarChar(32)
  /// Имя на момент действия (снимок)
  actorName  String   @map("actor_name") @db.VarChar(191)
  /// create | update | delete | restore | status | login | export | …
  action     String   @db.VarChar(32)
  entityType String   @map("entity_type") @db.VarChar(40)
  entityId   String   @map("entity_id") @db.VarChar(32)
  /// Только изменённые поля: { поле: [было, стало] }
  diff       Json?
  requestId  String?  @map("request_id") @db.VarChar(64)
  ip         String?  @db.VarChar(64)
  device     String?  @db.VarChar(200)
  at         DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, at])
  @@index([entityType, entityId, at])
  @@index([actorId, at])
  @@map("audit_events")
}

// ─────────────────────────── Этап 2 · Вход и аккаунт (01 §1, 05 §6, PLAN Р8/Р11) ───────────────────────────

/// Человек. Один на все роли: клиент, мастер, владелец, администратор, команда платформы (01 §1).
/// Администратор салона может быть без телефона (входит логином, F-00-034) — поэтому phone необязателен.
model User {
  id                   String    @id @db.VarChar(32)
  /// '+374XXXXXXXX' (В-37: только армянские номера)
  phone                String?   @unique @db.VarChar(16)
  name                 String    @db.VarChar(120)
  /// ru | hy | en — язык пушей и писем (Р12)
  locale               String    @default("ru") @db.VarChar(2)
  /// Двухэтапная проверка входа по паролю (F-15-159): после пароля — код на телефон
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  /// «Завершить все сеансы» — когда нажато последний раз (F-15-152)
  sessionsRevokedAt    DateTime? @map("sessions_revoked_at") @db.DateTime(3)
  blockedAt            DateTime? @map("blocked_at") @db.DateTime(3)
  /// Удаление аккаунта через 25 дней, можно отменить (F-10-129, F-15-158)
  deleteRequestedAt    DateTime? @map("delete_requested_at") @db.DateTime(3)
  deletedAt            DateTime? @map("deleted_at") @db.DateTime(3)
  /// «Запрос на блокировку данных» (F-15-155) — этап 20, заявка на рассмотрение, юр. текст не решён (Р14-подобно)
  dataBlockRequestedAt DateTime? @map("data_block_requested_at") @db.DateTime(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy            String?   @map("created_by") @db.VarChar(32)
  updatedBy            String?   @map("updated_by") @db.VarChar(32)
  version              Int       @default(1)

  appProfile     AppProfile?
  sessions       Session[]
  staffLogins    StaffLogin[]
  platformMember PlatformMember?
  pushTokens     PushToken[]
  loginEvents    LoginEvent[]
  identities     UserIdentity[]
  staff          Staff[]
  networks       Network[]
  masterProfile  MasterProfile?
  networkUsers   NetworkUser[]

  @@map("users")
}

/// Профиль клиента приложения (= AppUser мока) + согласие при входе (F-14-008)
model AppProfile {
  userId                  String    @id @map("user_id") @db.VarChar(32)
  /// female | male | unknown (В-19: необязательный)
  gender                  String    @default("unknown") @db.VarChar(8)
  /// 'YYYY-MM-DD'
  birthday                String?   @db.VarChar(10)
  district                String?   @db.VarChar(40)
  photoUrl                String?   @map("photo_url") @db.VarChar(500)
  bigFont                 Boolean   @default(false) @map("big_font")
  /// '24h' | '12h'
  timeFormat              String    @default("24h") @map("time_format") @db.VarChar(3)
  /// Этап 21 (лейн client+online, попытка 2): пуш о новостях ПРОДУКТА (не о новостях компании-бизнеса) —
  /// client.ts::getNewsPushOptOut/setNewsPushOptOut, F-14-136
  newsPushOptOut          Boolean   @default(false) @map("news_push_opt_out")
  /// Этап 21 (лейн client+online, попытка 2): филиал сети по умолчанию (F-14-163) — { [networkId]: businessId }
  networkDefaultLocations Json?     @map("network_default_locations")
  consentAt               DateTime? @map("consent_at") @db.DateTime(3)
  consentVersion          String?   @map("consent_version") @db.VarChar(20)
  createdAt               DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version                 Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("app_profiles")
}

/// Сессия в базе (Р8): в браузере только случайный токен в httpOnly cookie, в базе — его sha256.
/// Отзыв (выход, «выйти везде», увольнение) действует со следующего запроса.
model Session {
  id                 String    @id @db.VarChar(32)
  tokenHash          String    @unique @map("token_hash") @db.Char(64)
  userId             String    @map("user_id") @db.VarChar(32)
  /// Каким входом открыта: client | business | platform
  app                String    @db.VarChar(10)
  /// Переключатель «Я клиент / Мой бизнес» (В-21): client | business
  mode               String    @default("client") @db.VarChar(10)
  /// Выбранный бизнес в режиме business (сверяется с членством на каждом запросе — этап 3)
  activeBusinessId   String?   @map("active_business_id") @db.VarChar(32)
  /// Вход логином администратора (F-00-034)
  staffLoginId       String?   @map("staff_login_id") @db.VarChar(32)
  /// Вход команды платформы (Р11)
  platformMemberId   String?   @map("platform_member_id") @db.VarChar(32)
  /// Пароль выдан владельцем и ещё не сменён — экран просит сменить (F-00-034)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  device             String    @db.VarChar(200)
  ip                 String    @db.VarChar(64)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt         DateTime  @default(now()) @map("last_seen_at") @db.DateTime(3)
  expiresAt          DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt          DateTime? @map("revoked_at") @db.DateTime(3)
  /// logout | logout_all | logout_others | password_changed | disabled | deleted | expired
  revokeReason       String?   @map("revoke_reason") @db.VarChar(20)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  staffLogin     StaffLogin?     @relation(fields: [staffLoginId], references: [id], onDelete: Cascade)
  platformMember PlatformMember? @relation(fields: [platformMemberId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([staffLoginId])
  @@index([platformMemberId])
  @@map("sessions")
}

/// Код входа / подтверждения (05 §6): только хэш кода, 4 цифры, 5 минут, 5 попыток
model OtpRequest {
  id                String    @id @db.VarChar(32)
  /// '+374…' — куда отправлен
  phone             String    @db.VarChar(16)
  /// login | phone_change | second_factor | platform
  purpose           String    @db.VarChar(16)
  /// telegram | whatsapp | sms
  channel           String    @db.VarChar(10)
  codeHash          String    @map("code_hash") @db.Char(64)
  /// Для второго шага: чей вход подтверждается (staff_login / platform_member)
  subjectId         String?   @map("subject_id") @db.VarChar(32)
  /// Для смены номера: чей номер меняем
  userId            String?   @map("user_id") @db.VarChar(32)
  attempts          Int       @default(0)
  /// sent | used | exhausted | superseded
  status            String    @default("sent") @db.VarChar(12)
  providerMessageId String?   @map("provider_message_id") @db.VarChar(100)
  ip                String    @db.VarChar(64)
  sentAt            DateTime  @default(now()) @map("sent_at") @db.DateTime(3)
  expiresAt         DateTime  @map("expires_at") @db.DateTime(3)
  usedAt            DateTime? @map("used_at") @db.DateTime(3)

  @@index([phone, purpose, sentAt])
  @@index([ip, sentAt])
  @@index([userId])
  @@map("otp_requests")
}

/// Логин и пароль администратора салона (F-00-034). staff_id — сотрудник бизнеса.
model StaffLogin {
  id                 String    @id @db.VarChar(32)
  /// Нижний регистр, без пробелов по краям
  login              String    @unique @db.VarChar(64)
  passwordHash       String    @map("password_hash") @db.VarChar(200)
  userId             String    @map("user_id") @db.VarChar(32)
  staffId            String?   @map("staff_id") @db.VarChar(32)
  businessId         String?   @map("business_id") @db.VarChar(32)
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.DateTime(3)
  /// Отключён владельцем (F-00-040): вход закрыт, сессии отозваны
  disabledAt         DateTime? @map("disabled_at") @db.DateTime(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy          String?   @map("created_by") @db.VarChar(32)
  updatedBy          String?   @map("updated_by") @db.VarChar(32)
  version            Int       @default(1)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  staff    Staff?    @relation(fields: [staffId], references: [id])
  sessions Session[]

  @@index([userId])
  @@index([staffId])
  @@index([businessId])
  @@map("staff_logins")
}

/// Команда платформы (Р11): логин + пароль + код на телефон человека (user.phone)
model PlatformMember {
  id             String    @id @db.VarChar(32)
  login          String    @unique @db.VarChar(64)
  passwordHash   String    @map("password_hash") @db.VarChar(200)
  userId         String    @unique @map("user_id") @db.VarChar(32)
  /// reviewer | admin
  role           String    @default("reviewer") @db.VarChar(16)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.DateTime(3)
  disabledAt     DateTime? @map("disabled_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy      String?   @map("created_by") @db.VarChar(32)
  updatedBy      String?   @map("updated_by") @db.VarChar(32)
  version        Int       @default(1)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@map("platform_members")
}

/// Журнал входов (F-10-106, F-15-159): удачные и неудачные попытки; хранится 1 год (F3)
model LoginEvent {
  id         String   @id @db.VarChar(32)
  userId     String?  @map("user_id") @db.VarChar(32)
  sessionId  String?  @map("session_id") @db.VarChar(32)
  /// code | password | platform | second_factor | google
  method     String   @db.VarChar(16)
  /// Вход кодом: куда код дошёл — telegram | whatsapp | sms (из otp_requests.channel); иначе null
  channel    String?  @db.VarChar(10)
  app        String   @db.VarChar(10)
  /// ok | wrong_code | wrong_password | locked | blocked | second_factor_sent | google_unlinked | google_invalid | google_linked | google_taken
  result     String   @db.VarChar(20)
  /// Что вводили (логин или номер с маской) — для неудачных попыток без userId
  identifier String?  @db.VarChar(64)
  ip         String   @db.VarChar(64)
  device     String   @db.VarChar(200)
  at         DateTime @default(now()) @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, at])
  @@index([at])
  @@map("login_events")
}

/// Внешний вход, привязанный к человеку (03.10.2026): «Войти через Google». Номер телефона остаётся главным — Google
/// привязывается к человеку только после кода на его номер (или из профиля вошедшего), сам номер не подтверждает.
model UserIdentity {
  id         String    @id @db.VarChar(32)
  /// google (потом — apple)
  provider   String    @db.VarChar(16)
  /// Постоянный id аккаунта у провайдера (sub из ID token); email может смениться, sub — нет
  subject    String    @db.VarChar(255)
  /// Почта аккаунта на момент последнего входа — только показать в профиле «Google: name@gmail.com»
  email      String?   @db.VarChar(254)
  userId     String    @map("user_id") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)
  /// Apple (04.10.2026): refresh token, зашифрованный SECRETS_KEY (common/crypto/secret-box.ts) — только чтобы отозвать
  /// вход при удалении аккаунта (App Store 5.1.1(v)); null — приложение не прислало authorizationCode или ключа нет
  refreshTokenEnc String? @map("refresh_token_enc") @db.Text
  /// client_id, которым выдан токен (bundle id / Services ID) — им же отзывается
  tokenClientId   String? @map("token_client_id") @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  /// Один аккаунт провайдера на человека: привязка нового заменяет прежний
  @@unique([userId, provider])
  @@map("user_identities")
}

/// Токены пушей (05 §4): Web Push (подписка JSON) и FCM
model PushToken {
  id           String    @id @db.VarChar(32)
  userId       String    @map("user_id") @db.VarChar(32)
  /// client | business
  app          String    @db.VarChar(10)
  /// web | android | ios
  platform     String    @db.VarChar(8)
  /// FCM-токен или endpoint Web Push; подписка целиком — в subscription
  token        String    @unique @db.VarChar(512)
  subscription Json?
  locale       String    @default("ru") @db.VarChar(2)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  invalidAt    DateTime? @map("invalid_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

// ─────────────────────────── Этап 3 · Бизнес, сеть, филиалы, сотрудники, права (01 §2–3, 03) ───────────────────────────

/// Сеть салонов (F-11-001…023): владелец — человек; филиалы — бизнесы с network_id
model Network {
  id             String    @id @db.VarChar(32)
  name           String    @db.VarChar(160)
  ownerUserId    String    @map("owner_user_id") @db.VarChar(32)
  /// Сотрудник-владелец (как Network.ownerStaffId во фронте) — строка staff владельца в одном из филиалов
  ownerStaffId   String?   @map("owner_staff_id") @db.VarChar(32)
  /// Главная локация сети (F-05-118, F-11-017); нет — первый филиал
  mainBusinessId String?   @map("main_business_id") @db.VarChar(32)
  /// Баланс главной локации для оплаты сетевых SMS-рассылок, драмы (F-11-057) — своей кассы у сети нет
  smsBalance     BigInt    @default(0) @map("sms_balance")
  /// Срок «потерянного клиента» сети, дней (F-11-072); умолч. как у бизнеса (60)
  lostClientDays Int       @default(60) @map("lost_client_days")
  deletedAt      DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy      String?   @map("created_by") @db.VarChar(32)
  updatedBy      String?   @map("updated_by") @db.VarChar(32)
  version        Int       @default(1)

  owner                User                         @relation(fields: [ownerUserId], references: [id])
  businesses           Business[]
  positions            Position[]
  networkUsers         NetworkUser[]
  fields               NetworkField[]
  serviceCategoryLinks NetworkServiceCategoryLink[]
  serviceLocks         NetworkServiceLock[]
  goodsCategoryLinks   NetworkGoodsCategoryLink[]
  planCells            NetworkPlanCell[]
  broadcasts           NetworkBroadcast[]
  // === stage 21 (lane network+reports) ===
  subdivisions         NetworkSubdivision[]
  offDayTypes          NetworkOffDayType[]
  staffOrder           NetworkStaffOrder?
  locationOrder        NetworkLocationOrder?
  positionDefs         NetworkPositionDef[]
  goodsArchive         NetworkGoodsArchiveEntry[]
  // === /stage 21 ===

  @@index([ownerUserId])
  @@map("networks")
}

/// Бизнес: мастер-индивидуал или салон (= Business мока). Филиал сети — бизнес с network_id.
model Business {
  id                            String    @id @db.VarChar(32)
  /// individual | salon
  kind                          String    @db.VarChar(12)
  name                          String    @db.VarChar(160)
  /// Адрес публичной страницы /b/<slug>
  slug                          String    @unique @db.VarChar(120)
  /// SphereId[]
  sphereIds                     Json      @map("sphere_ids")
  networkId                     String?   @map("network_id") @db.VarChar(32)
  ownerStaffId                  String?   @map("owner_staff_id") @db.VarChar(32)
  phone                         String    @db.VarChar(16)
  /// LocalizedText
  description                   Json?
  logoUrl                       String?   @map("logo_url") @db.MediumText
  /// Фото страницы салона, до 6 (F-00-087) — пока адреса/data URI; через модерацию — этап 19
  photos                        Json
  /// draft | moderation | active | frozen (В-02: после регистрации — draft до оплаты или промокода)
  status                        String    @default("draft") @db.VarChar(12)
  /// Ушёл с платформы (03 §5)
  leftAt                        DateTime? @map("left_at") @db.DateTime(3)
  /// Запрет домашних записей мастерам в часы смены (F-00-047)
  forbidHomeBookingsDuringShift Boolean   @default(false) @map("forbid_home_bookings_during_shift")
  /// Сайт и соцсети (F-14-028)
  socials                       Json?
  /// Правила отмены/переноса (В-04) — пишет раздел online
  bookingRules                  Json?     @map("booking_rules")
  /// Имя отправителя уведомлений (F-05-012)
  brandName                     String?   @map("brand_name") @db.VarChar(160)
  /// Получать предложения поставщиков (F-00-164)
  adsOptIn                      Boolean   @default(false) @map("ads_opt_in")
  /// Раздел «Заказы» (03.10.2026): null — по сфере (tailor/repair/drycleaning/detailing — включён), иначе как задал владелец
  ordersEnabled                 Boolean?  @map("orders_enabled")
  /// Напоминать клиенту, что заказ ждёт (04.10.2026): off | 3 | 3_7 (дней после «Готов»); null — по умолчанию 3_7
  orderPickupReminders          String?   @map("order_pickup_reminders") @db.VarChar(8)
  /// Промокод, введённый при регистрации — применит раздел подписки (этап 18)
  signupPromoCode               String?   @map("signup_promo_code") @db.VarChar(40)
  createdAt                     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy                     String?   @map("created_by") @db.VarChar(32)
  updatedBy                     String?   @map("updated_by") @db.VarChar(32)
  version                       Int       @default(1)

  network          Network?          @relation(fields: [networkId], references: [id])
  locations        Location[]
  staff            Staff[]
  positions        Position[]
  invites          StaffInvite[]
  settings         BusinessSetting[]
  categories       ServiceCategory[]
  services         Service[]
  resources        Resource[]
  clients          Client[]
  clientCategories ClientCategory[]

  @@index([status])
  @@index([networkId])
  @@map("businesses")
}

/// Филиал / место (= Location мока). Пояс — tz (по умолчанию Asia/Yerevan, F-02-074)
model Location {
  id            String    @id @db.VarChar(32)
  businessId    String    @map("business_id") @db.VarChar(32)
  /// LocalizedText
  name          Json
  /// LocalizedText (армянский целиком, F-00-172)
  address       Json
  district      String    @db.VarChar(40)
  yandexMapsUrl String?   @map("yandex_maps_url") @db.VarChar(1000)
  /// Точка из «Я сейчас на месте работы» (F-00-075)
  lat           Decimal?  @db.Decimal(9, 6)
  lng           Decimal?  @db.Decimal(9, 6)
  coordsAt      DateTime? @map("coords_at") @db.DateTime(3)
  phone         String?   @db.VarChar(16)
  extraPhones   Json?     @map("extra_phones")
  hoursText     String?   @map("hours_text") @db.VarChar(200)
  /// WeekTemplate — только витрина; рабочее время мастеров — в графиках
  openHours     Json?     @map("open_hours")
  /// individual | mixed | group (F-01-025)
  journalKind   String?   @map("journal_kind") @db.VarChar(12)
  tz            String    @default("Asia/Yerevan") @db.VarChar(40)
  sortOrder     Int       @default(0) @map("sort_order")
  deletedAt     DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     String?   @map("created_by") @db.VarChar(32)
  updatedBy     String?   @map("updated_by") @db.VarChar(32)
  version       Int       @default(1)

  business  Business        @relation(fields: [businessId], references: [id])
  staff     StaffLocation[]
  resources Resource[]

  @@index([businessId])
  @@index([district])
  @@index([lat, lng])
  @@map("locations")
}

/// Настройки разделов бизнеса одним JSON на раздел (01 §2, F4)
model BusinessSetting {
  businessId String   @map("business_id") @db.VarChar(32)
  area       String   @db.VarChar(40)
  data       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, area])
  @@map("business_settings")
}

/// Сотрудник бизнеса (= Staff мока + срез staff). Человек (users) может быть сотрудником нескольких бизнесов (F-00-045).
model Staff {
  id                   String    @id @db.VarChar(32)
  businessId           String    @map("business_id") @db.VarChar(32)
  /// Пусто — сотрудник без входа (F-15-032) или приглашён и не принял
  userId               String?   @map("user_id") @db.VarChar(32)
  name                 String    @db.VarChar(120)
  /// '+374…' или '' (администратор без телефона)
  phone                String    @default("") @db.VarChar(16)
  email                String?   @db.VarChar(160)
  // === stage 21 (lane rest) ===
  /// Почта подтверждена переходом по ссылке (F-15-150) — по умолчанию true (демо, письмо не требовалось до этапа 21)
  emailVerified        Boolean   @default(true) @map("email_verified")
  /// Письмо подтверждения отправлено, ссылку ещё не открывали (демо: кнопка «Я перешёл по ссылке»)
  emailConfirmSentAt   DateTime? @map("email_confirm_sent_at") @db.DateTime(3)
  // === /stage 21 ===
  /// owner | admin | master
  role                 String    @db.VarChar(8)
  /// 8 шаблонов (F-10-053): systemManager | viewer | specialist | admin | callCenter | accountant | manager | owner
  roleTemplateId       String?   @map("role_template_id") @db.VarChar(16)
  /// active | invited | disabled | fired
  status               String    @db.VarChar(10)
  /// LocalizedText — название должности (как во фронте: имя, а не ссылка)
  position             Json?
  positionId           String?   @map("position_id") @db.VarChar(32)
  specialty            Json?
  sphereIds            Json      @map("sphere_ids")
  avatarUrl            String?   @map("avatar_url") @db.MediumText
  bio                  Json?
  /// Портфолио (F-00-085) — копия уходит с мастером в master_profiles (C4)
  photos               Json
  materials            Json
  /// Workplace[] (F-00-073)
  workplaces           Json
  homeAddress          String?   @map("home_address") @db.VarChar(300)
  homeDistrict         String?   @map("home_district") @db.VarChar(40)
  visitDistricts       Json?     @map("visit_districts")
  /// all | women | men (F-00-069)
  accepts              String    @default("all") @db.VarChar(6)
  /// all | link | mine (F-00-065, В-22)
  calendarVisibility   String    @default("all") @map("calendar_visibility") @db.VarChar(5)
  /// free | busy (F-00-051)
  calendarMode         String    @default("free") @map("calendar_mode") @db.VarChar(5)
  /// instant | manual (В-03: по умолчанию manual)
  confirmMode          String    @default("manual") @map("confirm_mode") @db.VarChar(8)
  colorIndex           Int       @default(1) @map("color_index")
  /// Услуги мастера — до этапа 4 (staff_services) списком id
  serviceIds           Json      @map("service_ids")
  callHours            Json?     @map("call_hours")
  /// 'YYYY-MM-DD'
  hiredAt              String    @map("hired_at") @db.VarChar(10)
  onlineBookingEnabled Boolean   @default(true) @map("online_booking_enabled")
  hiddenInJournal      Boolean   @default(false) @map("hidden_in_journal")
  assistantOnly        Boolean   @default(false) @map("assistant_only")
  journalMarkupMin     Int?      @map("journal_markup_min")
  prepayment           Json?
  bookingRules         Json?     @map("booking_rules")
  contacts             Json?
  /// Порядок в списке и журнале (F-10-009/013)
  sortOrder            Int       @default(0) @map("sort_order")
  /// Доступ в кабинет (F-10-031): выключение закрывает вход, карточка остаётся
  accessEnabled        Boolean   @default(true) @map("access_enabled")
  accessInfo           String?   @map("access_info") @db.VarChar(500)
  /// { enabled, ranges[] } (F-10-091)
  ipRestriction        Json?     @map("ip_restriction")
  /// Грубые права, заданные владельцем (Permission[]) — у администратора заменяют шаблон (03 §2)
  permissions          Json?
  /// Тонкие права редактора (id строк каталога staff/permissions) и «▾»-ограничения (F-10-071)
  rights               Json?
  rightScopes          Json?     @map("right_scopes")
  /// Юр. информация (F-10-038) — только staff.manage
  legalInfo            Json?     @map("legal_info")
  cardSettings         Json?     @map("card_settings")
  /// Пуши мастера «на себя» (F-10-137)
  pushPrefs            Json?     @map("push_prefs")
  /// Увольнение (F-10-040/043): дата, причина, момент
  firedOn              String?   @map("fired_on") @db.VarChar(10)
  fireReason           String?   @map("fire_reason") @db.VarChar(500)
  firedAt              DateTime? @map("fired_at") @db.DateTime(3)
  /// Удалён (F-10-041): восстановление по правилу 24 ч / 30 дней (F-10-044)
  deletedAt            DateTime? @map("deleted_at") @db.DateTime(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy            String?   @map("created_by") @db.VarChar(32)
  updatedBy            String?   @map("updated_by") @db.VarChar(32)
  version              Int       @default(1)

  business     Business           @relation(fields: [businessId], references: [id])
  user         User?              @relation(fields: [userId], references: [id])
  locations    StaffLocation[]
  invites      StaffInvite[]
  logins       StaffLogin[]
  serviceTerms StaffServiceTerm[]
  schedules    WorkSchedule[]
  marks        CalendarMark[]

  @@index([businessId, status])
  @@index([userId])
  @@index([phone])
  @@map("staff")
}

/// В каких филиалах работает сотрудник (Staff.locationIds)
model StaffLocation {
  staffId    String @map("staff_id") @db.VarChar(32)
  locationId String @map("location_id") @db.VarChar(32)

  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@id([staffId, locationId])
  @@index([locationId])
  @@map("staff_locations")
}

/// Должности (F-10-046…052, F-11-104…107): бизнеса или сети
model Position {
  id          String   @id @db.VarChar(32)
  businessId  String?  @map("business_id") @db.VarChar(32)
  networkId   String?  @map("network_id") @db.VarChar(32)
  name        Json
  /// Нижний регистр ru-имени — для «уже есть такая»
  nameNorm    String   @map("name_norm") @db.VarChar(120)
  description String?  @db.VarChar(500)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  version     Int      @default(1)

  business Business? @relation(fields: [businessId], references: [id])
  network  Network?  @relation(fields: [networkId], references: [id])

  @@index([businessId, nameNorm])
  @@index([networkId])
  @@map("positions")
}

/// Приглашение в бизнес только с согласием (F-00-042, F-10-020): ссылка с токеном, в базе — sha256
model StaffInvite {
  id         String    @id @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  staffId    String    @map("staff_id") @db.VarChar(32)
  /// admin | master
  role       String    @db.VarChar(8)
  phone      String?   @db.VarChar(16)
  email      String?   @db.VarChar(160)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  /// pending | accepted | declined | revoked | expired
  status     String    @default("pending") @db.VarChar(10)
  expiresAt  DateTime  @map("expires_at") @db.DateTime(3)
  sentAt     DateTime  @default(now()) @map("sent_at") @db.DateTime(3)
  answeredAt DateTime? @map("answered_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?   @map("created_by") @db.VarChar(32)
  updatedBy  String?   @map("updated_by") @db.VarChar(32)
  version    Int       @default(1)

  business Business @relation(fields: [businessId], references: [id])
  staff    Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([staffId])
  @@index([phone, status])
  @@map("staff_invites")
}

// ─────────────────────────── Этап 4 · Услуги и ресурсы (01 §4, PLAN §6 №4) ───────────────────────────

/// Категория услуг (= ServiceCategory мока). Своё имя для витрины (F-03-131) — на самой категории, без надстройки.
model ServiceCategory {
  id                String   @id @db.VarChar(32)
  businessId        String   @map("business_id") @db.VarChar(32)
  /// LocalizedText
  name              Json
  onlineNameEnabled Boolean  @default(false) @map("online_name_enabled")
  /// LocalizedText — имя для онлайн-записи, когда включено (F-03-131)
  onlineName        Json?    @map("online_name")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy         String?  @map("created_by") @db.VarChar(32)
  updatedBy         String?  @map("updated_by") @db.VarChar(32)
  version           Int      @default(1)

  business Business  @relation(fields: [businessId], references: [id])
  services Service[]

  @@index([businessId])
  @@map("service_categories")
}

/// Услуга (= Service мока). Пакет «Комплекс» (F-16-107…135) — та же строка с заполненным servicePackage/packageExtra
/// (01 §4: «хозяин — services»); kind у пакета остаётся individual. staffIds — денормализованный список (мастер ×
/// услуга — 01 §4 staff_services, срок цены/длительности мастера — staff_service_terms).
model Service {
  id                 String   @id @db.VarChar(32)
  businessId         String   @map("business_id") @db.VarChar(32)
  /// Пусто — категория удалена (F-16-171: удаление категории мока не блокирует и не переносит услуги;
  /// на сервере FK этого не разрешает, поэтому категория при удалении снимается — SetNull, не запрет)
  categoryId         String?  @map("category_id") @db.VarChar(32)
  sphereId           String   @map("sphere_id") @db.VarChar(40)
  /// LocalizedText
  name               Json
  description        Json?
  /// individual | group
  kind               String   @default("individual") @db.VarChar(10)
  durationMin        Int      @map("duration_min")
  /// «От–до» (F-00-057); нет поля — фиксированная длительность
  durationMax        Int?     @map("duration_max")
  /// Драмы
  priceMin           BigInt   @map("price_min")
  /// «От–до»; нет поля — фиксированная цена
  priceMax           BigInt?  @map("price_max")
  /// Запас после услуги; null — общая настройка локации («shared»), 0 — без перерыва (F-02-060 — различать!)
  bufferAfterMin     Int?     @map("buffer_after_min")
  /// «Пора снова», дней (F-00-084)
  repeatIntervalDays Int?     @map("repeat_interval_days")
  /// off | custom — нет поля — общая настройка notify (F-05-037)
  winbackReminder    String?  @map("winback_reminder") @db.VarChar(6)
  /// Мест в событии — только у групповых
  capacity           Int?
  photos             Json
  materials          Json
  /// Id мастеров, привязанных к услуге — держит services/staff.service.ts в паре с Staff.serviceIds
  staffIds           Json     @map("staff_ids")
  workplaces         Json
  onlineBookable     Boolean  @default(true) @map("online_bookable")
  active             Boolean  @default(true)
  /// Порядок в категории; у пакета — Date.now() при создании (как во фронте), поэтому bigint
  order              BigInt   @default(0)
  /// required | preferred — выбор оттенка при записи (F-00-094…096); нет поля — шага нет
  shadeChoice        String?  @map("shade_choice") @db.VarChar(10)
  /// { items: {serviceId, order}[], mode } — состав пакета (нет поля — обычная услуга)
  servicePackage     Json?    @map("service_package")
  /// «Доступна ограниченное время» для онлайн-записи (F-02-067) — ServiceSlotWindow без serviceId
  onlineWindow       Json?    @map("online_window")
  /// Надстройка пакета — способ цены, окно доступности, предоплата, ресурсы «на весь пакет» (PackageExtra фронта)
  packageExtra       Json?    @map("package_extra")
  /// Автоперевод/чек/выбор варианта при записи — ServiceExtra фронта (F-03-115, F-15-141, F-07-149)
  extra              Json?
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy          String?  @map("created_by") @db.VarChar(32)
  updatedBy          String?  @map("updated_by") @db.VarChar(32)
  version            Int      @default(1)

  business Business           @relation(fields: [businessId], references: [id])
  category ServiceCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  terms    StaffServiceTerm[]

  @@index([businessId, order])
  @@index([categoryId])
  @@map("services")
}

/// Своя цена/длительность мастера по услуге (F-02-058, F-16-030) — пара «мастер × услуга»; сама привязка
/// (список кто вообще делает услугу) — денормализованные Service.staffIds / Staff.serviceIds.
model StaffServiceTerm {
  staffId     String   @map("staff_id") @db.VarChar(32)
  serviceId   String   @map("service_id") @db.VarChar(32)
  /// Драмы; нет строки/поля — цена и длительность услуги
  price       BigInt?
  durationMin Int?     @map("duration_min")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([staffId, serviceId])
  @@index([serviceId])
  @@map("staff_service_terms")
}

/// Ресурс — кресло/кабинет/аппарат (= Resource мока). Экземпляры и привязанные услуги — JSON-массивы прямо на
/// строке, как во фронте (Resource.instances/serviceIds); отдельная таблица занятости — этап 6/7 (availability).
model Resource {
  id          String   @id @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  locationId  String   @map("location_id") @db.VarChar(32)
  /// LocalizedText
  name        Json
  /// chair | room | device | box | hall | other
  kind        String   @db.VarChar(10)
  /// { id, name }[] — «Кресло 1», «Кресло 2» (F-16-004); новый ресурс получает первый экземпляр сразу
  instances   Json
  serviceIds  Json     @map("service_ids")
  /// Надстройка своего среза (F-16-002) — не в ядре мока
  description String?  @db.VarChar(2000)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  version     Int      @default(1)

  business Business @relation(fields: [businessId], references: [id])
  location Location @relation(fields: [locationId], references: [id])

  @@index([businessId])
  @@index([locationId])
  @@map("resources")
}

// ─────────────────────────── Этап 5 · Клиенты / CRM (01 §5, PLAN §6 №5) ───────────────────────────

/// Клиент — карточка в базе КОНКРЕТНОГО бизнеса (= Client мока + профиль среза clients.profiles), ключ — телефон
/// в пределах бизнеса (F-00-128). Не пользователь приложения: у одного человека может быть карточка в N салонах.
/// Уникальность (businessId, phone) — не задаётся индексом (MySQL не умеет частичный WHERE deleted_at IS NULL без
/// генерируемой колонки, PLAN §4.1: A12 прямо разрешает свободный номер после удаления карточки — «unique среди
/// неудалённых» здесь и не нужен). Проверка дубля — в приложении перед вставкой (createClient), как и у имени
/// категории/услуги этапа 4 — без блокировки строки: создание клиентов не на «замке на мастера» §4.2.
model Client {
  id                     String    @id @db.VarChar(32)
  businessId             String    @map("business_id") @db.VarChar(32)
  phone                  String    @db.VarChar(20)
  name                   String    @db.VarChar(160)
  lastName               String?   @map("last_name") @db.VarChar(80)
  middleName             String?   @map("middle_name") @db.VarChar(80)
  /// female | male | unknown
  gender                 String    @default("unknown") @db.VarChar(8)
  /// 'YYYY-MM-DD'
  birthday               String?   @db.VarChar(10)
  email                  String?   @db.VarChar(160)
  note                   String?   @db.VarChar(2000)
  /// string[] — категории (= теги ядра мока, F-04-029); справочник цветов — ClientCategory
  tags                   Json
  additionalPhone        String?   @map("additional_phone") @db.VarChar(20)
  /// data URL, как Staff.avatarUrl (F-04-069)
  avatarUrl              String?   @map("avatar_url") @db.MediumText
  discountPercent        Int       @default(0) @map("discount_percent")
  /// gold | silver | bronze
  importanceClass        String?   @map("importance_class") @db.VarChar(8)
  cardNumber             String?   @map("card_number") @db.VarChar(40)
  /// Внесено сверх оплат визитов (F-04-059/166); «Оплачено» = оплаты визитов (этап 7) + это число
  paidAmount             BigInt    @default(0) @map("paid_amount")
  /// «Продано» из импорта, прибавляется к визитам, а не заменяет их (F-04-129/177)
  importedSold           BigInt    @default(0) @map("imported_sold")
  /// 12 цифр, необязательный (F-04-192)
  nationalId             String?   @map("national_id") @db.VarChar(12)
  /// ConsentRecord: { given, at, method, recordedBy } (F-04-153/227)
  adConsent              Json?     @map("ad_consent")
  birthdayGreetingOptOut Boolean?  @map("birthday_greeting_opt_out")
  /// Язык клиента без приложения (F-04-228); с приложением — язык берётся из users.locale
  locale                 String?   @db.VarChar(2)
  /// call | wa | tg | viber (F-04-066)
  preferredContact       String?   @map("preferred_contact") @db.VarChar(6)
  /// Запрет онлайн-записи (F-04-056 / F-00-189)
  blocked                Boolean?
  /// Наличие приложения — вычисляется на лету (users.phone = clients.phone, P1); здесь — только запись
  /// «запись сделана этим пользователем через приложение» ставит booking (этап 7/8), не карточка клиента.
  appUserId              String?   @map("app_user_id") @db.VarChar(32)
  /// Меняет только запись визита «Не пришёл» / поздняя отмена (этап 7); здесь всегда 0 до тех пор
  noShowCount            Int       @default(0) @map("no_show_count")
  /// Свои доп. поля клиента (F-04-060) — { fieldId: value } (01 §5 предлагает отдельную таблицу
  /// client_field_values; JSON на строке — то же намеренное упрощение, что Resource.instances этапа 4:
  /// значений немного, правка всегда идёт с самой карточкой)
  customFieldValues      Json?     @map("custom_field_values")
  /// F-00-130: приглашение из CRM в приложение — когда отправлено (сама отправка сообщения — этап 10)
  invitedAt              DateTime? @map("invited_at") @db.DateTime(3)
  /// F-04-211: обезличен по требованию клиента (purgeClientData) — телефон анонимизирован, возврата нет
  purgedAt               DateTime? @map("purged_at") @db.DateTime(3)
  /// manual | import | chat | widget — как заведена карточка
  source                 String?   @db.VarChar(20)
  /// Мягкое удаление (F-04-074, A12): история остаётся у этой карточки, номер свободен для новой
  deletedAt              DateTime? @map("deleted_at") @db.DateTime(3)
  deletedBy              String?   @map("deleted_by") @db.VarChar(32)
  createdAt              DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy              String?   @map("created_by") @db.VarChar(32)
  updatedBy              String?   @map("updated_by") @db.VarChar(32)
  version                Int       @default(1)

  business Business        @relation(fields: [businessId], references: [id])
  comments ClientComment[]
  files    ClientFile[]

  @@index([businessId, phone])
  @@index([businessId, deletedAt])
  @@index([appUserId])
  @@map("clients")
}

/// Справочник категорий клиентов бизнеса (F-04-109/110): имя + цвет; счёт клиентов по категории — на лету
model ClientCategory {
  businessId String   @map("business_id") @db.VarChar(32)
  name       String   @db.VarChar(80)
  color      String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  business Business @relation(fields: [businessId], references: [id])

  @@id([businessId, name])
  @@map("client_categories")
}

/// История комментариев карточки (F-04-070)
model ClientComment {
  id         String    @id @db.VarChar(32)
  clientId   String    @map("client_id") @db.VarChar(32)
  authorId   String?   @map("author_id") @db.VarChar(32)
  authorName String    @map("author_name") @db.VarChar(120)
  text       String    @db.VarChar(2000)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  deletedAt  DateTime? @map("deleted_at") @db.DateTime(3)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@map("client_comments")
}

/// Файлы клиента (F-04-086) — как фото каталога, data URL прямо на строке (та же причина, что Service.photos)
model ClientFile {
  id         String   @id @db.VarChar(32)
  clientId   String   @map("client_id") @db.VarChar(32)
  name       String   @db.VarChar(200)
  ext        String   @db.VarChar(10)
  size       Int
  /// Старые строки и мок: файл целиком data: URL. Новые (04.10.2026) — null, файл в закрытом хранилище (storageKey)
  dataUrl    String?  @map("data_url") @db.LongText
  /// client-files/<бизнес>/<sha256[:32]>.<ext> в закрытом хранилище (uploads/document.ts); раздаётся только
  /// GET /v1/biz/:businessId/clients/:id/files/:fileId/content с правом clients.view
  storageKey String?  @map("storage_key") @db.VarChar(200)
  /// Тип по сигнатуре файла (application/pdf, image/jpeg…) — для storageKey
  mime       String?  @db.VarChar(120)
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.DateTime(3)
  uploadedBy String   @map("uploaded_by") @db.VarChar(120)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([storageKey])
  @@map("client_files")
}

/// Тонкие права «Клиентская база» поверх грубых clients.* (F-04-194…204) — свой срез поверх permissions.ts
model ClientFineRights {
  staffId    String   @id @map("staff_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// Partial<ClientsFineRights> — только то, что владелец переопределил; остальное — умолчание роли
  rights     Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId])
  @@map("client_fine_rights")
}

/// Колонки таблицы клиентов — свои у каждого сотрудника (F-04-004/005); staffId = '' — общая настройка бизнеса
model ClientColumnsPref {
  businessId String @map("business_id") @db.VarChar(32)
  staffId    String @default("") @map("staff_id") @db.VarChar(32)
  visible    Json
  pinned     Json

  @@id([businessId, staffId])
  @@map("client_columns_prefs")
}

/// Прогон импорта клиентов из Excel/CSV (F-04-126…129) — журнал раздела, «видно в отчёте сообщений» их не касается
model ClientImportRun {
  id            String   @id @db.VarChar(32)
  businessId    String   @map("business_id") @db.VarChar(32)
  authorName    String   @map("author_name") @db.VarChar(120)
  /// paste | file
  method        String   @db.VarChar(6)
  totalRows     Int      @map("total_rows")
  createdCount  Int      @map("created_count")
  updatedCount  Int      @map("updated_count")
  rejectedCount Int      @map("rejected_count")
  at            DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, at])
  @@map("client_import_runs")
}

/// Выгрузка данных (P4: закрыта по умолчанию, право `clients.export`) — общий журнал, не только для клиентов
model DataExport {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// clients | … (будущие разделы)
  area       String   @db.VarChar(20)
  authorId   String?  @map("author_id") @db.VarChar(32)
  authorName String   @map("author_name") @db.VarChar(120)
  count      Int
  fileName   String?  @map("file_name") @db.VarChar(200)
  at         DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, area, at])
  @@map("data_exports")
}

/// Что уходит с мастером (C4, F-00-044): портфолио, дипломы, материалы привязаны к человеку, а не к салону
model MasterProfile {
  userId    String   @id @map("user_id") @db.VarChar(32)
  photos    Json
  diplomas  Json
  materials Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version   Int      @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("master_profiles")
}

// ───────────────────────── Этап 6: график и окна (docs/backend/01 §6, §7.2; 04; PLAN §4.2) ─────────────────────────

/// График мастера на одном месте работы (WorkSchedule ядра): шаблон недели + конец графика (F-00-055).
/// Исключения по датам — schedule_days (было WorkSchedule.overrides).
model WorkSchedule {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  staffId    String   @map("staff_id") @db.VarChar(32)
  locationId String   @map("location_id") @db.VarChar(32)
  /// salon | home | visit | hall | online
  workplace  String   @db.VarChar(8)
  /// WeekTemplate: { "0": DayHours, … "6": DayHours }, 0 = пн
  week       Json
  /// 'YYYY-MM-DD' — после этой даты окон нет (F-00-055, F-02-021)
  openUntil  String?  @map("open_until") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  staff Staff         @relation(fields: [staffId], references: [id])
  days  ScheduleDay[]

  @@index([businessId])
  @@index([staffId])
  @@index([locationId])
  @@map("work_schedules")
}

/// Часы графика на дату (исключение важнее недели). hours = [] — выходной по исключению.
model ScheduleDay {
  scheduleId String   @map("schedule_id") @db.VarChar(32)
  /// 'YYYY-MM-DD'
  date       String   @db.VarChar(10)
  businessId String   @map("business_id") @db.VarChar(32)
  staffId    String   @map("staff_id") @db.VarChar(32)
  /// DayHours
  hours      Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  schedule WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@id([scheduleId, date])
  @@index([staffId, date])
  @@map("schedule_days")
}

/// Тип дня человека-сотрудника (F-02-010): work | sick | vacation | … | not_working | custom:<id>.
/// Отдельно от часов: тип дня один на сотрудника в дату, а часы — у каждого графика (салон/дом).
model StaffDayType {
  staffId       String   @map("staff_id") @db.VarChar(32)
  date          String   @db.VarChar(10)
  businessId    String   @map("business_id") @db.VarChar(32)
  typeId        String   @map("type_id") @db.VarChar(40)
  /// «В отпуске до…» (F-00-054)
  vacationUntil String?  @map("vacation_until") @db.VarChar(10)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([staffId, date])
  @@index([businessId, date])
  @@map("staff_day_types")
}

/// Отметка календаря (F-00-051): busy — «занято» в режиме free; free — «открыто» в режиме busy.
/// Отметка busy дополнительно проецируется в busy_blocks (source mark_busy) — чужой бизнес видит «занято».
model CalendarMark {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  staffId    String   @map("staff_id") @db.VarChar(32)
  date       String   @db.VarChar(10)
  fromTime   String   @map("from_time") @db.VarChar(5)
  toTime     String   @map("to_time") @db.VarChar(5)
  /// busy | free
  kind       String   @db.VarChar(4)
  workplace  String?  @db.VarChar(8)
  note       String?  @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)

  staff Staff @relation(fields: [staffId], references: [id])

  @@index([staffId, date])
  @@index([businessId, date])
  @@map("calendar_marks")
}

/// Свой шаблон графика (F-02-006…009)
model ScheduleTemplate {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  name       String   @db.VarChar(120)
  /// weekdays | shifts
  kind       String   @db.VarChar(10)
  weekdays   Json?
  shiftWork  Int?     @map("shift_work")
  shiftOff   Int?     @map("shift_off")
  hours      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  version    Int      @default(1)

  @@index([businessId])
  @@map("schedule_templates")
}

/// История правок графика и правил онлайн-записи (F-02-102) — HistoryEntry фронта
model ScheduleHistory {
  id             String   @id @db.VarChar(32)
  businessId     String   @map("business_id") @db.VarChar(32)
  at             DateTime @default(now()) @db.DateTime(3)
  /// set_hours | apply_template | delete_days | copy_schedule | set_mode | toggle_mark | set_column_config | slot_rules
  action         String   @db.VarChar(20)
  targetStaffIds Json     @map("target_staff_ids")
  dates          Json
  summary        String   @default("") @db.VarChar(500)
  details        Json?
  actorName      String   @map("actor_name") @db.VarChar(120)
  actorStaffId   String?  @map("actor_staff_id") @db.VarChar(32)

  @@index([businessId, at])
  @@map("schedule_history")
}

/// Правила онлайн-записи (F-02-041…055): на филиал (scope=location) или на мастера (scope=staff).
/// Одна строка на scope: список правил (первое — основное), недоступные дни, запас между клиентами.
model OnlineSlotRuleSet {
  /// location | staff
  scope       String   @db.VarChar(8)
  scopeId     String   @map("scope_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  /// SlotRule[]; null — правила по умолчанию (у мастера — «общее по локации»)
  rules       Json?
  /// Только scope=staff: «Персонально» (F-02-041)
  ownRules    Boolean  @default(false) @map("own_rules")
  /// UnavailableRange[] (F-02-042/043)
  unavailable Json?
  /// Запас между клиентами, мин (F-02-059); null — не задан
  bufferMin   Int?     @map("buffer_min")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  version     Int      @default(1)

  @@id([scope, scopeId])
  @@index([businessId])
  @@map("online_slot_rules")
}

/// «Замок на мастера» (PLAN §4.2): одна строка на человека; SELECT … FOR UPDATE в порядке person_key
model PersonLock {
  personKey String @id @map("person_key") @db.VarChar(32)

  @@map("person_locks")
}

/// Замок на ресурс (PLAN §4.2): одна строка на ресурс (экземпляры считаются внутри)
model ResourceLock {
  resourceId String @id @map("resource_id") @db.VarChar(32)

  @@map("resource_locks")
}

/// Занятость ЧЕЛОВЕКА во всех его бизнесах (01 §7.2). Пишет только availability/occupy.ts.
model BusyBlock {
  id              String    @id @db.VarChar(32)
  /// users.id мастера; без аккаунта — staff.id
  personKey       String    @map("person_key") @db.VarChar(32)
  staffId         String    @map("staff_id") @db.VarChar(32)
  businessId      String    @map("business_id") @db.VarChar(32)
  locationId      String?   @map("location_id") @db.VarChar(32)
  workplace       String?   @db.VarChar(8)
  /// UTC. Конец — с запасом после услуги и дорогой
  startAt         DateTime  @map("start_at") @db.DateTime(3)
  endAt           DateTime  @map("end_at") @db.DateTime(3)
  /// Конец самой услуги (без запаса) — для показа
  serviceEndAt    DateTime  @map("service_end_at") @db.DateTime(3)
  /// booking | group_event | mark_busy | travel
  source          String    @db.VarChar(12)
  sourceId        String    @map("source_id") @db.VarChar(32)
  /// Что видно чужому бизнесу: home | salon | visit | busy — без имени и суммы
  visibilityLabel String    @map("visibility_label") @db.VarChar(6)
  active          Boolean   @default(true)
  /// Запись «не пришёл»: при «онлайн-запись поверх неявок» (F-02-066) окно клиенту снова открыто
  noShow          Boolean   @default(false) @map("no_show")
  /// «Ждёт предоплату/подтверждения»: держит время до этого момента (B13)
  holdUntil       DateTime? @map("hold_until") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([personKey, active, startAt, endAt])
  @@index([source, sourceId])
  @@index([businessId, startAt])
  @@map("busy_blocks")
}

/// Занятость ресурса (F-00-149, F-02-070): сколько экземпляров занято одновременно
model ResourceBusy {
  id         String    @id @db.VarChar(32)
  resourceId String    @map("resource_id") @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  startAt    DateTime  @map("start_at") @db.DateTime(3)
  endAt      DateTime  @map("end_at") @db.DateTime(3)
  source     String    @db.VarChar(12)
  sourceId   String    @map("source_id") @db.VarChar(32)
  /// Конкретный экземпляр (кресло 2), если запись выбрала его (F-16-013, Booking.resourceIds); нет — любой свободный
  instanceId String?   @map("instance_id") @db.VarChar(40)
  active     Boolean   @default(true)
  noShow     Boolean   @default(false) @map("no_show")
  holdUntil  DateTime? @map("hold_until") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([resourceId, active, startAt, endAt])
  @@index([source, sourceId])
  @@map("resource_busy")
}

// ─────────────────────────── Этап 7: журнал и записи (docs/backend/01 §7, 02 §4, 04 §4) ───────────────────────────

/// Запись (Booking ядра + срез journal.extras). Время — UTC; в API — местное время филиала.
/// Строки услуг (`services`) и доп. данные визита (`extras`) — JSON на строке, как Resource.instances (этап 4):
/// правятся всегда вместе с записью; денежные агрегаты, по которым ищут, вынесены колонками (total, paid_amount).
model Booking {
  id                  String    @id @db.VarChar(32)
  businessId          String    @map("business_id") @db.VarChar(32)
  locationId          String    @map("location_id") @db.VarChar(32)
  /// Главный мастер записи
  staffId             String    @map("staff_id") @db.VarChar(32)
  clientId            String?   @map("client_id") @db.VarChar(32)
  appUserId           String?   @map("app_user_id") @db.VarChar(32)
  startAt             DateTime  @map("start_at") @db.DateTime(3)
  /// Конец услуги (без запаса) = start + duration
  endAt               DateTime  @map("end_at") @db.DateTime(3)
  durationMin         Int       @map("duration_min")
  /// awaiting_confirmation | awaiting_prepayment | scheduled | client_confirmed | arrived | no_show | cancelled_by_client | cancelled_by_master
  status              String    @db.VarChar(24)
  /// BookingServiceLine[]
  services            Json
  total               BigInt    @default(0)
  /// Экземпляры/ресурсы (Booking.resourceIds)
  resourceIds         Json      @map("resource_ids")
  /// salon | home | visit | hall | online
  workplace           String    @default("salon") @db.VarChar(8)
  /// journal | app | link | widget | phone | import | external
  source              String    @db.VarChar(10)
  /// id сотрудника или 'client'
  createdByRef        String    @map("created_by_ref") @db.VarChar(32)
  /// self | child | pet | other
  forWhom             String    @default("self") @map("for_whom") @db.VarChar(6)
  visitorName         String?   @map("visitor_name") @db.VarChar(160)
  comment             String?   @db.Text
  /// { amount, paid, holdUntil? } (F-00-097)
  prepayment          Json?
  /// Держит окно до этого момента: «ждёт предоплату» (В-05, 30 мин) или «ждёт подтверждения» (В-03)
  holdUntil           DateTime? @map("hold_until") @db.DateTime(3)
  /// Срок ответа мастера на заявку (В-03): min(создание + 2 ч, начало − 1 ч)
  confirmDeadline     DateTime? @map("confirm_deadline") @db.DateTime(3)
  /// Отмена клиентом позже срока (В-04, F-00-098)
  cancelledLate       Boolean   @default(false) @map("cancelled_late")
  /// prepayment_expired | confirmation_expired
  cancelReason        String?   @map("cancel_reason") @db.VarChar(24)
  /// client | staff | system
  cancelledBy         String?   @map("cancelled_by") @db.VarChar(8)
  groupEventId        String?   @map("group_event_id") @db.VarChar(32)
  seriesId            String?   @map("series_id") @db.VarChar(32)
  visitId             String?   @map("visit_id") @db.VarChar(32)
  /// specific | any (F-01-028)
  staffAssignment     String?   @map("staff_assignment") @db.VarChar(8)
  /// BookingExtras без deletion: категории, цвет, доп. поля, товары, скидки строк, оплаты, автосписание, пакет…
  extras              Json
  /// Сумма оплат визита (extras.payments) — для «оплаченная запись» и сводки дня
  paidAmount          BigInt    @default(0) @map("paid_amount")
  /// Технический перерыв под записью, мин (F-01-032); null — по услуге/настройке
  breakOverrideMin    Int?      @map("break_override_min")
  /// Неугадываемый хэш для «моя запись без входа» (B19: 128 бит, в базе — sha256); только у онлайн-записи
  accessHash          String?   @unique @map("access_hash") @db.Char(64)
  /// Срок ссылки (B8: до конца визита + 7 дней); истёк — ссылка мертва, сама запись остаётся
  accessHashExpiresAt DateTime? @map("access_hash_expires_at") @db.DateTime(3)
  /// OnlineBookingMeta без bookingId/accessHash (этап 8, F-03-091…139): откуда пришла запись — ссылка/форма,
  /// устройство, e-mail/фамилия/отчество, свои поля виджета, «специалист не важен», адрес выезда
  onlineMeta          Json?     @map("online_meta")
  /// BookingNotifyOverride фронта (F-05-009/082, этап 21 «notify+integrations», попытка 3) — ручная правка
  /// уведомлений ОДНОЙ записи (какой канал напоминания и за сколько часов); нет строки — DEFAULT_BOOKING_NOTIFY_OVERRIDE
  notifyOverride      Json?     @map("notify_override")
  // === stage 21 (lane rest) ===
  /// BookingReminder фронта (F-04-100): своё напоминание клиенту и свой срок приглашения на повторный визит для
  /// ОДНОЙ записи — {remindAt?, revisitInviteDays?}; нет строки — используются общие настройки уведомлений
  reminderOverride    Json?     @map("reminder_override")
  // === /stage 21 ===
  deletedAt           DateTime? @map("deleted_at") @db.DateTime(3)
  deletedBy           String?   @map("deleted_by") @db.VarChar(32)
  deletedByName       String?   @map("deleted_by_name") @db.VarChar(160)
  deletedByClient     Boolean   @default(false) @map("deleted_by_client")
  /// Что удаление обнулило (деньги, расходники, посещение) — возвращается при «Восстановить» (F-01-120/121)
  deletionRestore     Json?     @map("deletion_restore")
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy           String?   @map("created_by") @db.VarChar(32)
  updatedBy           String?   @map("updated_by") @db.VarChar(32)
  version             Int       @default(1)

  @@index([businessId, startAt])
  @@index([staffId, startAt])
  @@index([clientId, startAt])
  @@index([appUserId, startAt])
  @@index([locationId, startAt])
  @@index([status, holdUntil])
  @@index([groupEventId])
  @@index([seriesId])
  @@index([visitId])
  @@map("bookings")
}

/// Журнал событий записей (BookingEvent ядра): создана / статус / перенесена / удалена / мастер задерживается.
/// Лента клиента, колокольчик, лист ожидания («окно освободилось», F-00-101) и история статусов (F-00-068).
model BookingEvent {
  id          String   @id @db.VarChar(32)
  bookingId   String   @map("booking_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  staffId     String   @map("staff_id") @db.VarChar(32)
  clientId    String?  @map("client_id") @db.VarChar(32)
  appUserId   String?  @map("app_user_id") @db.VarChar(32)
  /// created | status | moved | deleted | delayed
  kind        String   @db.VarChar(8)
  fromStatus  String?  @map("from_status") @db.VarChar(24)
  toStatus    String?  @map("to_status") @db.VarChar(24)
  /// Местное 'YYYY-MM-DDTHH:mm'
  prevStart   String?  @map("prev_start") @db.VarChar(16)
  prevStaffId String?  @map("prev_staff_id") @db.VarChar(32)
  /// { staffId, locationId, start, durationMin } — освободившееся время
  freed       Json?
  /// id сотрудника | client | system
  byRef       String   @map("by_ref") @db.VarChar(32)
  late        Boolean?
  reason      String?  @db.VarChar(24)
  delayMin    Int?     @map("delay_min")
  /// Начало записи в момент события (местное)
  startLocal  String   @map("start_local") @db.VarChar(16)
  at          DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, at])
  @@index([appUserId, at])
  @@index([bookingId, at])
  @@index([staffId, at])
  @@map("booking_events")
}

/// История изменений записи (F-01-096) — строки «кто, что стало», пишет окно записи и сервер
model BookingHistory {
  id         String   @id @db.VarChar(32)
  bookingId  String   @map("booking_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  authorName String   @map("author_name") @db.VarChar(160)
  /// created | updated | statusChanged | deleted | restored
  action     String   @db.VarChar(16)
  summary    String   @db.VarChar(1000)
  at         DateTime @default(now()) @db.DateTime(3)

  @@index([bookingId, at])
  @@index([businessId, at])
  @@map("booking_history")
}

/// Групповое событие (GroupEvent ядра, F-01-035, F-16-036…). Участники — записи с group_event_id.
model GroupEvent {
  id          String   @id @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  locationId  String   @map("location_id") @db.VarChar(32)
  serviceId   String   @map("service_id") @db.VarChar(32)
  staffId     String   @map("staff_id") @db.VarChar(32)
  startAt     DateTime @map("start_at") @db.DateTime(3)
  durationMin Int      @map("duration_min")
  capacity    Int
  resourceIds Json     @map("resource_ids")
  onlineUrl   String?  @map("online_url") @db.VarChar(1000)
  seriesId    String?  @map("series_id") @db.VarChar(32)
  /// stage 21: EventExtra + EventJoinInfo фронта — { colorIndex?, categoryIds, comment?, joinInstructions?,
  /// joinSentAt?: ISODateTime[] } (F-16-039, F-16-081/082); url самого «присоединиться» — уже есть onlineUrl выше
  extras      Json?
  /// scheduled | cancelled
  status      String   @default("scheduled") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  version     Int      @default(1)

  @@index([businessId, startAt])
  @@index([staffId, startAt])
  @@index([seriesId])
  @@map("group_events")
}

/// Серия записей: правило «каждые N дней / по дню недели» (kind=rule, F-00-064 — 6 недель вперёд, продление ночью)
/// или повтор записи из окна (kind=recurrence, F-01-100…107 — даты считаются сразу, копии самостоятельны)
model BookingSeries {
  id            String   @id @db.VarChar(32)
  businessId    String   @map("business_id") @db.VarChar(32)
  locationId    String   @map("location_id") @db.VarChar(32)
  staffId       String   @map("staff_id") @db.VarChar(32)
  /// rule | recurrence
  kind          String   @db.VarChar(10)
  /// SeriesRule (kind=rule) | { rule: RecurrenceRule, sourceBookingId } (kind=recurrence)
  rule          Json
  active        Boolean  @default(true)
  /// Последняя дата, до которой записи уже созданы (местная)
  createdUntil  String?  @map("created_until") @db.VarChar(10)
  createdByName String   @default("") @map("created_by_name") @db.VarChar(160)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     String?  @map("created_by") @db.VarChar(32)
  version       Int      @default(1)

  @@index([businessId])
  @@index([active, kind])
  @@index([staffId])
  @@map("booking_series")
}

/// Пакет (комплекс) связанных записей (F-01-113, F-01-134…136)
model PackageGroup {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// parallel | sequential_one
  orderMode  String   @map("order_mode") @db.VarChar(16)
  bookingIds Json     @map("booking_ids")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId])
  @@map("package_groups")
}

/// Лист ожидания бизнеса — ОДИН (владелец, 30.09.2026): полный экран /biz/waitlist и панель журнала (F-16-149…168,
/// F-01-156…162), «сообщить об окне» из приложения (F-00-102, appUserId) и первая волна раздачи окна (В-18, FreedSlot).
/// Бывшая вторая таблица resources_waitlist_entries влита сюда миграцией 20260930120000_one_waitlist.
model WaitlistEntry {
  id            String    @id @db.VarChar(32)
  businessId    String    @map("business_id") @db.VarChar(32)
  locationId    String?   @map("location_id") @db.VarChar(32)
  clientName    String    @map("client_name") @db.VarChar(160)
  clientPhone   String    @map("client_phone") @db.VarChar(20)
  clientId      String?   @map("client_id") @db.VarChar(32)
  /// Встал сам из приложения (F-00-102)
  appUserId     String?   @map("app_user_id") @db.VarChar(32)
  /// Откуда заявка: staff (экран листа, панель журнала) | app (приложение клиента) | widget (виджет онлайн-записи).
  /// С 01.10.2026 в этот лист пишут все входы — бывшие online_records kind='waitlist' перенесены миграцией 20261001233000.
  source        String    @default("staff") @db.VarChar(16)
  serviceIds    Json      @map("service_ids")
  /// Пусто — любой специалист
  staffIds      Json      @map("staff_ids")
  /// WaitlistWish[]: { date?, time?, intervals? }; пусто — «любое время»; без date — любой день
  wishes        Json
  comment       String    @default("") @db.VarChar(2000)
  /// Метки заявки (string[])
  tags          Json
  /// Закрыта: из заявки создана запись (F-01-159, F-16-163)
  bookingId     String?   @map("booking_id") @db.VarChar(32)
  /// Когда последний раз предложено окно (В-18, ручное «Проверить лист», «Предложить окно»)
  notifiedAt    DateTime? @map("notified_at") @db.DateTime(3)
  /// Все отметки «Уведомлён» — ISODateTime[] (F-16-166…168)
  notifiedTimes Json?     @map("notified_times")
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     String?   @map("created_by") @db.VarChar(32)
  version       Int       @default(1)

  @@index([businessId, createdAt])
  @@index([appUserId])
  @@map("waitlist_entries")
}

/// Освободившееся окно и его раздача (В-18): лист ожидания сразу → через 30 мин подписчики → за 3 ч «горящее»
model FreedSlot {
  id              String    @id @db.VarChar(32)
  businessId      String    @map("business_id") @db.VarChar(32)
  staffId         String    @map("staff_id") @db.VarChar(32)
  locationId      String?   @map("location_id") @db.VarChar(32)
  startAt         DateTime  @map("start_at") @db.DateTime(3)
  endAt           DateTime  @map("end_at") @db.DateTime(3)
  durationMin     Int       @map("duration_min")
  /// Какая запись освободила
  sourceBookingId String    @map("source_booking_id") @db.VarChar(32)
  /// waitlist | subscribers | hot | taken | expired
  stage           String    @db.VarChar(12)
  /// id заявок листа ожидания, которым окно предложено первой волной
  waitlistIds     Json      @map("waitlist_ids")
  subscribersAt   DateTime? @map("subscribers_at") @db.DateTime(3)
  hotAt           DateTime? @map("hot_at") @db.DateTime(3)
  /// Скидка «горящего» окна, % — настройка мастера, по умолчанию 0 (В-18)
  discountPct     Int       @default(0) @map("discount_pct")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([stage, startAt])
  @@index([businessId, startAt])
  @@index([staffId, startAt])
  @@map("freed_slots")
}

/// «Закрыть окно» ссылкой из переписки (F-00-107): срабатывает только для вошедшего мастера этого окна
model SlotClaim {
  token         String   @id @db.VarChar(40)
  businessId    String   @map("business_id") @db.VarChar(32)
  staffId       String   @map("staff_id") @db.VarChar(32)
  serviceId     String?  @map("service_id") @db.VarChar(32)
  /// Местное 'YYYY-MM-DDTHH:mm'
  startLocal    String   @map("start_local") @db.VarChar(16)
  startAt       DateTime @map("start_at") @db.DateTime(3)
  clientName    String?  @map("client_name") @db.VarChar(160)
  clientPhone   String?  @map("client_phone") @db.VarChar(20)
  /// pending | used
  status        String   @default("pending") @db.VarChar(8)
  usedBookingId String?  @map("used_booking_id") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([staffId, startAt])
  @@map("slot_claims")
}

/// «Текущий приём» — заключение по визиту (F-01-189), медицинские сферы
model MedicalVisitNote {
  bookingId  String   @id @map("booking_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// Поля заключения (MedicalVisitNote фронта без bookingId/updatedAt)
  data       Json
  authorName String   @map("author_name") @db.VarChar(160)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId])
  @@map("medical_visit_notes")
}

/// «Медкарта» пациента (F-01-190)
model MedicalCard {
  clientId   String   @id @map("client_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  data       Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId])
  @@map("medical_cards")
}

/// «План лечения» (F-01-191)
model TreatmentPlan {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  clientId   String   @map("client_id") @db.VarChar(32)
  title      String   @db.VarChar(300)
  /// TreatmentPlanItem[]
  items      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([clientId])
  @@index([businessId])
  @@map("treatment_plans")
}

// ─────────────────────────── Этап 8: онлайн-запись и страница по ссылке (docs/backend/02 §3, PLAN §6 №8) ───────────────────────────

/// Ссылка на запись / форма (F-03-003…037): страница /b/<Business.slug>[/f/<formId>]. Настройки шагов, дизайна,
/// кнопки на сайте, аналитики и домена — JSON на строке (config), как Resource.instances (этап 4): правятся
/// только вместе со всей ссылкой на одном экране кабинета, отдельных выборок «по полю конфигурации» нет.
model BookingLink {
  id            String   @id @db.VarChar(32)
  businessId    String   @map("business_id") @db.VarChar(32)
  locationId    String?  @map("location_id") @db.VarChar(32)
  /// Сеть, чьи филиалы клиент выбирает первым шагом — только kind='network' (F-03-008)
  networkId     String?  @map("network_id") @db.VarChar(32)
  /// Видно только сотрудникам кабинета (F-03-006)
  name          String   @db.VarChar(160)
  description   String?  @db.VarChar(2000)
  /// normal | network
  kind          String   @db.VarChar(8)
  /// individual | group | mixed
  bookingType   String   @map("booking_type") @db.VarChar(10)
  defaultLocale String   @map("default_locale") @db.VarChar(2)
  /// Ссылка «для сотрудника» — ведёт сразу к нему (F-03-005)
  staffId       String?  @map("staff_id") @db.VarChar(32)
  primary       Boolean  @default(false)
  /// Короткий номер формы: часть адреса /b/<slug>/f/<formId> (F-03-009)
  formId        String   @map("form_id") @db.VarChar(20)
  /// Остальные поля BookingLink фронта: bookingFlow, stepOrder/Hidden/Labels, preselectedStaffId/ServiceId,
  /// staffDisplayField, categoryDisplay, staffForAllBookings, theme, widgetButtonColor, hidePrice/Duration,
  /// submitButtonLabel, heroImageUrl/Status, websiteButton, subdomain, domain, аналитика, onlineSalesNetworkId
  config        Json
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     String?  @map("created_by") @db.VarChar(32)
  updatedBy     String?  @map("updated_by") @db.VarChar(32)
  version       Int      @default(1)

  @@unique([businessId, formId])
  @@index([businessId])
  @@map("booking_links")
}

// ─────────────────────────── Этап 9 — приложение клиента (docs/backend/02 §2, PLAN §6 №9) ───────────────────────────
// Каталог/карточки считаются live (AvailabilityService.cached — тот же Redis-кеш с версией бизнеса, что виджет
// онлайн-записи этапа 8, 04 §6); ниже — только то, что клиент копит сам: избранное, звёздочка, дневник, лист
// ожидания «от себя», лента и заявки без входа. appUserId — без внешнего ключа, как у Booking/WaitlistEntry.

/// ❤ подписка на мастера/место = избранное + новости (F-00-113, F-00-115)
model Favorite {
  id         String   @id @db.VarChar(32)
  appUserId  String   @map("app_user_id") @db.VarChar(32)
  /// staff | business
  targetType String   @map("target_type") @db.VarChar(10)
  targetId   String   @map("target_id") @db.VarChar(32)
  newsMuted  Boolean  @default(false) @map("news_muted")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([appUserId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("favorites")
}

/// ★ звёздочка мастеру (F-00-116): одна на клиента на мастера, только после визита «пришёл»
model StarRating {
  id        String   @id @db.VarChar(32)
  appUserId String   @map("app_user_id") @db.VarChar(32)
  staffId   String   @map("staff_id") @db.VarChar(32)
  bookingId String   @map("booking_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@unique([appUserId, staffId])
  @@index([staffId])
  @@map("star_ratings")
}

/// Дневник клиента (F-00-122) — только ручные строки; визиты «пришёл» добавляются на лету при чтении, не дублируются тут
model DiaryEntry {
  id          String   @id @db.VarChar(32)
  appUserId   String   @map("app_user_id") @db.VarChar(32)
  serviceName String   @map("service_name") @db.VarChar(200)
  masterName  String   @map("master_name") @db.VarChar(160)
  /// 'YYYY-MM-DD', как ISODate ядра (birthday-конвенция 04.1)
  date        String   @db.VarChar(10)
  amount      BigInt   @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([appUserId, date])
  @@map("diary_entries")
}

/// «Попросить перезвонить», когда кнопка звонка закрыта (F-00-106)
model CallbackRequest {
  id         String    @id @db.VarChar(32)
  staffId    String    @map("staff_id") @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  phone      String    @db.VarChar(20)
  name       String?   @db.VarChar(160)
  seenAt     DateTime? @map("seen_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId, createdAt])
  @@index([staffId])
  @@map("callback_requests")
}

/// «Не нашли? Сообщить, когда появится» (F-00-112, F-00-180) — своя заявка + строка отчёта спроса нашей панели
model DemandLead {
  id        String   @id @db.VarChar(32)
  query     String   @db.VarChar(200)
  sphereId  String?  @map("sphere_id") @db.VarChar(20)
  district  String?  @db.VarChar(20)
  phone     String?  @db.VarChar(20)
  appUserId String?  @map("app_user_id") @db.VarChar(32)
  /// Попросил «сообщить, когда появится» (этап 19 продолжение: поле мока не хватало — getDemandReport считает notify)
  notify    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([createdAt])
  @@map("demand_leads")
}

/// «Обращение к нам» из приложения (F-00-182) — очередь читает наша панель (этап 19: number/name/channel/section/
/// topic/messages/updatedAt добавлены тем же этапом; subject/message — прежние поля, submitSupport их не бросил)
model SupportTicket {
  id        String   @id @db.VarChar(32)
  /// Единая нумерация с BizRequest(kind=help) — общий счётчик platform_counters(key='support')
  number    Int?
  appUserId String?  @map("app_user_id") @db.VarChar(32)
  name      String?  @db.VarChar(160)
  phone     String?  @db.VarChar(20)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  /// app | cabinet | phone | whatsapp | telegram | email
  channel   String   @default("app") @db.VarChar(10)
  section   String?  @db.VarChar(20)
  topic     String   @default("other") @db.VarChar(12)
  status    String   @default("open") @db.VarChar(12)
  /// SupportMessage[] фронта — {id, author: them|us, text, at}; создание кладёт первое сообщение сюда
  messages  Json?
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([appUserId, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

/// Лента /v1/me/inbox (F-14-055): статусы своих записей, которые пишет BookingsService.logEvents/reportDelay.
/// Напоминания (E1) и новости бизнеса (E3, broadcast) — этап 10, тот же стол, kind ещё не занят.
model InboxItem {
  id         String    @id @db.VarChar(32)
  appUserId  String    @map("app_user_id") @db.VarChar(32)
  /// booking_created | salon_confirmed | salon_moved | salon_deleted | cancelled_by_master | master_delayed | prepayment_expired
  kind       String    @db.VarChar(24)
  businessId String?   @map("business_id") @db.VarChar(32)
  staffId    String?   @map("staff_id") @db.VarChar(32)
  bookingId  String?   @map("booking_id") @db.VarChar(32)
  /// Параметры для строки перевода (delayMin, start…) — client.notifications.kind.<kind> фронта
  params     Json?
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  readAt     DateTime? @map("read_at") @db.DateTime(3)

  @@index([appUserId, createdAt])
  @@map("inbox_items")
}

// ─────────────────────────── Этап 10 · Уведомления (05) ───────────────────────────

/// Очередь/журнал отправок (05 §4): событие пишет строку здесь же (в своей транзакции); notify.dispatch
/// (воркер) берёт готовые (send_at ≤ now) и шлёт push. dedupe_key уникален — повторная попытка того же
/// события (перезапуск задачи, повторный вызов) не создаёт вторую строку (createMany skipDuplicates / upsert).
model NotifyOutbox {
  id              String    @id @db.VarChar(32)
  /// Чей это разговор — для журнала `GET /v1/biz/{b}/notify/log`; пусто у чисто личных системных пушей (нет пока)
  businessId      String?   @map("business_id") @db.VarChar(32)
  /// client | business — тот же признак, что PushToken.app: чьи токены слать
  app             String    @db.VarChar(10)
  /// Ключ типа — свой словарь этого раздела (05 §3), не Altegio-нумерация: reminder24h, reminder2h,
  /// booking_created, salon_confirmed, salon_moved, salon_deleted, cancelled_by_master, prepayment_expired,
  /// waitlist_available, news, staff_new_booking, staff_client_cancelled, staff_client_rescheduled,
  /// staff_empty_week
  kind            String    @db.VarChar(24)
  recipientUserId String    @map("recipient_user_id") @db.VarChar(32)
  title           String    @db.VarChar(200)
  body            String    @db.VarChar(600)
  /// Куда ведёт тап — путь сайта (PushMessage.url)
  url             String?   @db.VarChar(300)
  dedupeKey       String    @unique @map("dedupe_key") @db.VarChar(160)
  sendAt          DateTime  @map("send_at") @db.DateTime(3)
  /// queued | sent | skipped | failed
  status          String    @default("queued") @db.VarChar(8)
  attempts        Int       @default(0)
  lastError       String?   @map("last_error") @db.VarChar(300)
  /// Параметры для журнала/отладки (businessId/staffId/bookingId и т.п.) — не персональные данные сверх нужного
  meta            Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  sentAt          DateTime? @map("sent_at") @db.DateTime(3)

  @@index([status, sendAt])
  @@index([businessId, createdAt])
  @@index([recipientUserId, createdAt])
  @@map("notify_outbox")
}

/// Telegram-бот напоминаний (решение владельца 30.09.2026: бесплатный канал для клиентов без нашего приложения).
/// Один чат — один номер; у номера может быть несколько чатов (телефон и компьютер в разных аккаунтах).
model TelegramLink {
  id           String    @id @db.VarChar(32)
  /// chat.id из Telegram (личный чат с ботом) — строкой, число бывает больше 2^31
  chatId       String    @unique @map("chat_id") @db.VarChar(32)
  /// '+374XXXXXXXX' — по нему бот находит записи клиента (Client.phone / User.phone)
  phone        String    @db.VarChar(16)
  /// Человек нашего приложения с этим номером, если есть (для справки; напоминания решаются по номеру)
  appUserId    String?   @map("app_user_id") @db.VarChar(32)
  /// language_code из Telegram, приведённый к ru | hy | en
  languageCode String?   @map("language_code") @db.VarChar(8)
  /// /stop или бот заблокирован в Telegram (403) — больше не пишем, пока снова не нажмёт /start
  blockedAt    DateTime? @map("blocked_at") @db.DateTime(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([phone])
  @@index([appUserId])
  @@map("telegram_links")
}

/// Новость подписчикам (F-00-114) — своя строка на отправку; лимит считает NewsQuota той же неделей
model NewsPost {
  id              String   @id @db.VarChar(32)
  businessId      String   @map("business_id") @db.VarChar(32)
  /// Календарная неделя по Еревану, 'YYYY-\'W\'ww' (§5: лимит на бизнес, не на мастера)
  weekKey         String   @map("week_key") @db.VarChar(8)
  /// LocalizedText
  text            Json
  recipientsCount Int      @default(0) @map("recipients_count")
  createdBy       String?  @map("created_by") @db.VarChar(32)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  /// Этап 21 (сдача, попытка 6): новость из кабинета (client.ts::createNewsPost) идёт через нашу проверку —
  /// pending_review → sent | rejected; уведомления из раздела «Уведомления» (этап 10) сразу 'sent'
  status          String    @default("sent") @db.VarChar(16)
  photoUrl        String?   @map("photo_url") @db.LongText
  /// Сверх 3 бесплатных за 7 дней — оплачено монетами (F-00-027)
  paidWithCoins   Boolean   @default(false) @map("paid_with_coins")
  sentAt          DateTime? @map("sent_at") @db.DateTime(3)
  moderationItemId String?  @map("moderation_item_id") @db.VarChar(32)

  @@index([businessId, createdAt])
  @@index([businessId, weekKey])
  @@map("news_posts")
}

/// Счётчик недели — строка с блокировкой (SELECT … FOR UPDATE), чтобы два администратора не отправили 4-ю
/// одновременно (§5, тот же приём «замка», что PersonLock у availability, PLAN.md §4.2)
model NewsQuota {
  businessId String @map("business_id") @db.VarChar(32)
  weekKey    String @map("week_key") @db.VarChar(8)
  sent       Int    @default(0)

  @@id([businessId, weekKey])
  @@map("news_quota")
}

/// Что приходит сотруднику (F-05-055…060) — минимальная матрица «событие → включено», по умолчанию всё включено
model StaffNotifyPref {
  staffId   String   @id @map("staff_id") @db.VarChar(32)
  /// Record<событие, boolean> — new_booking | client_cancelled | client_rescheduled | empty_week
  events    Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("staff_notify_prefs")
}

/// Настройки уведомлений на клиента (F-04-087…090) — отказ от маркетинга, каналы
model ClientNotifyPref {
  clientId          String   @id @map("client_id") @db.VarChar(32)
  marketingOptOut   Boolean  @default(false) @map("marketing_opt_out")
  /// {push, sms, email} — какие каналы разрешены этому клиенту
  channels          Json
  /// number[] — отключённые клиентом типы из CLIENT_DISABLEABLE_TYPES фронта (F-05-090); этап 21 «notify+integrations»
  disabledTypeCodes Json?    @map("disabled_type_codes")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("client_notify_prefs")
}

/// Колокольчик кабинета (F-05-061) — общий на бизнес (как в моке `s.inboxRead[businessId]`), не персональный на
/// сотрудника; сама лента считается на лету из booking_events (та же логика, что мок), тут только «прочитано»
model BizInboxRead {
  businessId String @map("business_id") @db.VarChar(32)
  eventId    String @map("event_id") @db.VarChar(32)

  @@id([businessId, eventId])
  @@map("biz_inbox_read")
}

// === stage 21 (лейн notify+integrations), попытка 3 ===
// Настройки-«одиночки» раздела notify, которые не зависят от каталога типов Altegio (см. NotifyMiscService
// докстринг, попытка 2): язык/тихие часы, витрина подарка партнёра, сводки от партнёров, WhatsApp через
// Altegio, флаги внешнего агента, расписание Open Slots, время напоминания на услугу, свои вебхуки — все на
// area = 'notify-<name>' той же BusinessSetting (см. notify-more.service.ts) — своих таблиц под них не заводим.
//
// Решение владельца (28.09, в ответ на вопрос попытки 2): каталог типов уведомлений строим ПОД экран, а не
// наоборот — 29 настраиваемых + 2 служебных типа `src/areas/notify/lib/registry.ts` (TYPE_REGISTRY), НЕ 88
// Altegio (то было верхней границей нумерации, не количеством). Реестр (имена/описания/дефолты/шаблоны на
// ru/hy/en) статичен и живёт в коде (`notify-type-registry.ts`, порт TYPE_REGISTRY) — тут только правки бизнеса
// поверх дефолта, одна строка на business+code. НЕ путать с `StaffNotifyPref`/`kinds.ts`/`NotifyTypesService`
// выше — те питают НАСТОЯЩУЮ отправку (13 своих kind, docs/backend/05 §3) и их трогать нельзя; это отдельная,
// более богатая модель ТОЛЬКО для экрана настройки каталога (docs/PROGRESS.md, этап 21, разбор лейна).
model NotifyTypeOverride {
  businessId String   @map("business_id") @db.VarChar(32)
  code       Int
  /// Патч поверх TypeDef.enabledDefault — нет строки/поля → действует дефолт реестра
  enabled    Boolean?
  /// NotifyChannelSetting[] — патч поверх TypeDef.defaultScenario
  channels   Json?
  /// Partial<Record<NotifyChannel, LocalizedText>> — патч поверх шаблона реестра (мержится по каналу)
  templates  Json?
  /// EmailExtra
  emailExtra Json?    @map("email_extra")
  /// TypeConditions — патч поверх TypeDef.conditionsDefault; serviceTimingHours сюда НЕ пишем (Ув15,
  /// своя область AREA_SERVICE_REMINDER_HOURS в notify-more.service.ts — независимо от каталога)
  conditions Json?
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)

  @@id([businessId, code])
  @@map("notify_type_overrides")
}

// === end stage 21 (лейн notify+integrations), попытка 3 ===

// ═══════════════════════════ Этап 11 — Лояльность (02-api.md §11, F-06-*) ═══════════════════════════
// Владелец программы — сеть (F-06-002); у одиночного бизнеса owner_id = business_id. `ownerId` — то, что
// PLAN §2 называет /v1/org/{orgId}: сеть, если у создавшего бизнеса есть networkId, иначе сам бизнес
// (см. loyalty.owner.ts). Маршруты всё равно висят на /v1/biz/:businessId (PLAN §2 резервирует /v1/net
// отдельно, но не просит для этого раздела) — видимость между филиалами сети даёт общий ownerId, не путь.
// Программа скидок/классов/категорий локации (F-04-114…122) — старый, отдельный движок, живёт в
// business_settings area='loyalty-program' (F4-приём, как resources/notify-types) — не здесь.

/// Типы карт (F-06-020…030)
model LoyaltyCardType {
  id                   String   @id @db.VarChar(32)
  ownerId              String   @map("owner_id") @db.VarChar(32)
  businessId           String   @map("business_id") @db.VarChar(32)
  name                 String   @db.VarChar(160)
  /// Работает во всех бизнесах сети, не только там, где выдана (В-09, по отметке владельца)
  networkWide          Boolean  @default(false) @map("network_wide")
  /// Автосписание бонусов ограничено % от чека при оплате; 0 = без ограничения (F-06-027)
  paymentLimitPercent  Int      @default(0) @map("payment_limit_percent")
  paymentLimitFixed    BigInt   @default(0) @map("payment_limit_fixed")
  /// Кэшбэк виден клиенту в приложении (F-06-028)
  cashbackVisibleInApp Boolean  @default(true) @map("cashback_visible_in_app")
  /// Сгорание баланса без визита N дней; null — не применяется (F-06-025)
  burnDays             Int?     @map("burn_days")
  /// В-40: «В архив» вместо удаления — не выдаётся/не продаётся, выданные карты продолжают работать;
  /// жёсткое удаление (delete()) отказывает, если есть хоть одна выданная карта (has_issued_cards)
  archived             Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy            String?  @map("created_by") @db.VarChar(32)
  updatedBy            String?  @map("updated_by") @db.VarChar(32)
  version              Int      @default(1)

  cards LoyaltyCard[]
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data  Json?

  @@index([ownerId])
  @@map("loyalty_card_types")
}

/// Карта клиента (F-06-051…060): бонусный баланс
model LoyaltyCard {
  id         String   @id @db.VarChar(32)
  cardTypeId String   @map("card_type_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  clientId   String?  @map("client_id") @db.VarChar(32)
  /// Заведена клиентом через приложение (В-06: своя видимость) — как и без CRM-карточки
  appUserId  String?  @map("app_user_id") @db.VarChar(32)
  number     String   @db.VarChar(40)
  balance    BigInt   @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  cardType LoyaltyCardType @relation(fields: [cardTypeId], references: [id])
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data     Json?

  @@unique([businessId, number])
  @@index([businessId, clientId])
  @@index([appUserId])
  @@index([cardTypeId])
  @@map("loyalty_cards")
}

/// Акции (F-06-031…050): правило на типе(ах) карты — скидка/кэшбэк, разовый или накопительный размер.
/// Мастер из 5 шагов фронта — один POST (02-api.md §11): шаги свёрнуты в поля одной формы, не в 5 запросов.
model Promotion {
  id           String   @id @db.VarChar(32)
  ownerId      String   @map("owner_id") @db.VarChar(32)
  businessId   String   @map("business_id") @db.VarChar(32)
  name         String   @db.VarChar(160)
  /// discountFixed | discountAccumVisits | discountAccumSum | discountConditional | cashbackFixed |
  /// cashbackAccumVisits | cashbackAccumSum | cashbackVisit (PromotionKind фронта, domain/loyalty.ts)
  kind         String   @db.VarChar(24)
  cardTypeIds  Json     @map("card_type_ids")
  /// percent | fixed
  valueType    String   @map("value_type") @db.VarChar(8)
  value        Int      @default(0)
  /// PromotionThreshold[] { from, value } — таблица порогов накопительных видов (F-06-038…044)
  thresholds   Json?
  serviceScope Json?    @map("service_scope")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy    String?  @map("created_by") @db.VarChar(32)
  updatedBy    String?  @map("updated_by") @db.VarChar(32)
  version      Int      @default(1)
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data         Json?

  @@index([ownerId])
  @@map("promotions")
}

/// Журнал движений лояльности (F-06-076/077): начисление/списание/выпуск по карте/сертификату/абонементу/счёту
model LoyaltyTx {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  clientId   String?  @map("client_id") @db.VarChar(32)
  /// card | certificate | membership | account
  source     String   @db.VarChar(12)
  refId      String   @map("ref_id") @db.VarChar(32)
  /// issue | accrual | charge | apply | topup | refund | freeze | unfreeze | confirm | reject
  kind       String   @db.VarChar(12)
  amount     BigInt   @default(0)
  bookingId  String?  @map("booking_id") @db.VarChar(32)
  note       String?  @db.VarChar(400)
  staffId    String?  @map("staff_id") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data       Json?

  @@index([businessId, createdAt])
  @@index([clientId])
  @@index([source, refId])
  @@map("loyalty_tx")
}

/// Реферальная программа (F-06-081…085) — одна строка на владельца (сеть/бизнес); у рефералки нет типа
/// карты (F-06-082) — награда начисляется прямым бонусом на счёт лояльности приглашённого/пригласившего.
model ReferralProgram {
  ownerId        String   @id @map("owner_id") @db.VarChar(32)
  enabled        Boolean  @default(false)
  giverReward    BigInt   @default(0) @map("giver_reward")
  receiverReward BigInt   @default(0) @map("receiver_reward")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy      String?  @map("updated_by") @db.VarChar(32)
  version        Int      @default(1)

  @@map("referral_programs")
}

/// «Пригласи подругу» (наше решение 01.10.2026, F-06-081…084): личный код клиента бизнеса для ссылки
/// /b/<slug>?ref=<код>. Один код на карточку клиента, заводится при первом показе ссылки; код уникален во всей базе.
model ReferralCode {
  code       String   @id @db.VarChar(12)
  businessId String   @map("business_id") @db.VarChar(32)
  clientId   String   @unique @map("client_id") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId])
  @@map("referral_codes")
}

/// Кто кого привёл: новый клиент записался по личной ссылке. Один пригласивший на клиента (ключ — приглашённый),
/// только новый клиент, не сам себя — правила rules/referral фронта, проверяет единый поток записи (place()).
/// Награда — по настройкам рефералки бизнеса при оплате первого визита (port: getReferralEligibility).
model ClientReferral {
  inviteeClientId  String   @id @map("invitee_client_id") @db.VarChar(32)
  businessId       String   @map("business_id") @db.VarChar(32)
  referrerClientId String   @map("referrer_client_id") @db.VarChar(32)
  code             String   @db.VarChar(12)
  /// Запись, с которой пришла привязка
  bookingId        String?  @map("booking_id") @db.VarChar(32)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId, referrerClientId])
  @@index([referrerClientId])
  @@map("client_referrals")
}

/// Типы сертификатов (F-06-086…104)
model CertificateType {
  id          String   @id @db.VarChar(32)
  ownerId     String   @map("owner_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  name        String   @db.VarChar(160)
  faceValue   BigInt   @map("face_value")
  validDays   Int      @map("valid_days")
  networkWide Boolean  @default(false) @map("network_wide")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  version     Int      @default(1)

  certificates Certificate[]
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data         Json?

  @@index([ownerId])
  @@map("certificate_types")
}

/// Проданный/выданный сертификат — продажа, баланс, срок, возврат (F-06-086…104). В-17: заявка клиента из
/// приложения рождается статусом pending_confirmation (без clientId — привязывается при подтверждении).
model Certificate {
  id         String   @id @db.VarChar(32)
  typeId     String   @map("type_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  clientId   String?  @map("client_id") @db.VarChar(32)
  appUserId  String?  @map("app_user_id") @db.VarChar(32)
  code       String   @db.VarChar(40)
  total      BigInt
  balance    BigInt
  /// active | pending_confirmation | rejected | refunded
  status     String   @default("active") @db.VarChar(20)
  soldAt     DateTime @map("sold_at") @db.DateTime(3)
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  type CertificateType @relation(fields: [typeId], references: [id])
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data Json?

  @@unique([businessId, code])
  @@index([businessId, clientId])
  @@index([appUserId])
  @@map("certificates")
}

/// Типы абонементов (F-06-105…134)
model MembershipType {
  id          String   @id @db.VarChar(32)
  ownerId     String   @map("owner_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  name        String   @db.VarChar(160)
  /// null — безлимитный на срок, а не по визитам
  totalVisits Int?     @map("total_visits")
  price       BigInt
  validDays   Int      @map("valid_days")
  serviceIds  Json     @map("service_ids")
  networkWide Boolean  @default(false) @map("network_wide")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  version     Int      @default(1)

  sales MembershipSale[]
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data  Json?

  @@index([ownerId])
  @@map("membership_types")
}

/// Проданный абонемент — продажа, заморозка, автосписание визита, возврат (F-06-105…134); В-17 как Certificate.
model MembershipSale {
  id              String    @id @db.VarChar(32)
  typeId          String    @map("type_id") @db.VarChar(32)
  businessId      String    @map("business_id") @db.VarChar(32)
  clientId        String?   @map("client_id") @db.VarChar(32)
  appUserId       String?   @map("app_user_id") @db.VarChar(32)
  code            String    @db.VarChar(40)
  totalVisits     Int?      @map("total_visits")
  remainingVisits Int?      @map("remaining_visits")
  /// active | pending_confirmation | rejected | frozen | expired | refunded
  status          String    @default("active") @db.VarChar(20)
  soldAt          DateTime  @map("sold_at") @db.DateTime(3)
  expiresAt       DateTime  @map("expires_at") @db.DateTime(3)
  frozenUntil     DateTime? @map("frozen_until") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy       String?   @map("created_by") @db.VarChar(32)
  updatedBy       String?   @map("updated_by") @db.VarChar(32)
  version         Int       @default(1)

  type    MembershipType     @relation(fields: [typeId], references: [id])
  freezes MembershipFreeze[]
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data    Json?

  @@unique([businessId, code])
  @@index([businessId, clientId])
  @@index([appUserId])
  @@map("membership_sales")
}

/// Журнал заморозок абонемента (F-06-* заморозка/автосписание)
model MembershipFreeze {
  id           String   @id @db.VarChar(32)
  membershipId String   @map("membership_id") @db.VarChar(32)
  fromAt       DateTime @map("from_at") @db.DateTime(3)
  toAt         DateTime @map("to_at") @db.DateTime(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy    String?  @map("created_by") @db.VarChar(32)

  membership MembershipSale @relation(fields: [membershipId], references: [id])

  @@index([membershipId])
  @@map("membership_freezes")
}

/// Типы счетов клиентов (F-06-135…146)
model ClientAccountType {
  id          String   @id @db.VarChar(32)
  ownerId     String   @map("owner_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  name        String   @db.VarChar(160)
  networkWide Boolean  @default(false) @map("network_wide")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)
  version     Int      @default(1)

  accounts ClientAccount[]
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data     Json?

  @@index([ownerId])
  @@map("client_account_types")
}

/// Личный счёт клиента — пополнение/списание в долг (F-06-135…146)
model ClientAccount {
  id         String   @id @db.VarChar(32)
  typeId     String   @map("type_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  clientId   String   @map("client_id") @db.VarChar(32)
  balance    BigInt   @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  type ClientAccountType @relation(fields: [typeId], references: [id])
  ops  ClientAccountOp[]
  /// Полная форма сущности фронта (domain/loyalty.ts) — этап 21, лейн loyalty; колонки выше — её проекция
  data Json?

  @@index([businessId, clientId])
  @@map("client_accounts")
}

/// Операция по счёту (F-06-135…146): пополнение / списание / возврат
model ClientAccountOp {
  id        String   @id @db.VarChar(32)
  accountId String   @map("account_id") @db.VarChar(32)
  /// topup | charge | refund
  kind      String   @db.VarChar(8)
  amount    BigInt
  bookingId String?  @map("booking_id") @db.VarChar(32)
  note      String?  @db.VarChar(400)
  staffId   String?  @map("staff_id") @db.VarChar(32)
