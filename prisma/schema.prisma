  parentId  String?  @map("parent_id") @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  network Network @relation(fields: [networkId], references: [id])

  @@index([networkId])
  @@map("network_goods_category_links")
}

/// План по филиалу/месяцу (F-11-077/078) — ключ месяца 'YYYY-MM'
model NetworkPlanCell {
  networkId  String   @map("network_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// revenue | clients | avgCheck
  kind       String   @db.VarChar(10)
  month      String   @db.VarChar(7)
  value      BigInt   @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)

  network Network @relation(fields: [networkId], references: [id])

  @@id([networkId, businessId, kind, month])
  @@map("network_plan_cells")
}

/// Журнал сетевой рассылки (F-11-054…061) — сама отправка идёт через notify-outbox (push) / BusinessMessenger
/// (sms, В-08); здесь только факт, для тоста и истории (F-11-060/164)
model NetworkBroadcast {
  id         String   @id @db.VarChar(32)
  networkId  String   @map("network_id") @db.VarChar(32)
  /// sms | push
  channel    String   @db.VarChar(6)
  /// selected | found
  scope      String   @db.VarChar(10)
  text       String   @db.VarChar(600)
  recipients Int
  /// Исключены по «Не отправлять» / нет согласия (F-11-058)
  optedOut   Int      @default(0) @map("opted_out")
  /// Драмы; 0 у push (F-11-057)
  cost       BigInt   @default(0)
  /// sent | insufficientFunds
  status     String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)

  network Network @relation(fields: [networkId], references: [id])

  @@index([networkId, createdAt])
  @@map("network_broadcasts")
}

// === stage 21 (lane network+reports) ===

/// Подразделение сети (F-11-080) — своя коллекция, на неё ссылается NetworkServiceCategoryLink.subdivisionId
/// (без FK — тот же приём, что categoryKey у сетевых услуг). categoryIds — F-11-080 «состав» (id категорий),
/// экран/мок хранит списком id, сервер — тем же JSON (id услуг не участвуют в поиске/фильтрах по этому полю).
model NetworkSubdivision {
  id          String   @id @db.VarChar(32)
  networkId   String   @map("network_id") @db.VarChar(32)
  name        String   @db.VarChar(120)
  categoryIds Json     @default("[]") @map("category_ids")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)

  network Network @relation(fields: [networkId], references: [id])

  @@index([networkId])
  @@map("network_subdivisions")
}

/// Свой тип нерабочего дня сети (F-11-108) — показывается рядом с системными (sick/vacation/…) в панели графика
model NetworkOffDayType {
  id          String   @id @db.VarChar(32)
  networkId   String   @map("network_id") @db.VarChar(32)
  name        String   @db.VarChar(120)
  comment     String?  @db.VarChar(400)
  /// 1..8 — тот же токен chart-N, что и цвет сотрудника в журнале
  colorIndex  Int      @default(1) @map("color_index")
  businessIds Json     @default("[]") @map("business_ids")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy   String?  @map("created_by") @db.VarChar(32)

  network Network @relation(fields: [networkId], references: [id])

  @@index([networkId])
  @@map("network_off_day_types")
}

/// Порядок сотрудников сети (F-11-100) — один общий список ключей на сеть, применяется в журнале/записи
model NetworkStaffOrder {
  networkId   String   @id @map("network_id") @db.VarChar(32)
  orderedKeys Json     @default("[]") @map("ordered_keys")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)

  network Network @relation(fields: [networkId], references: [id])

  @@map("network_staff_order")
}

/// Порядок филиалов в настройках сети (F-11-016) — «Локации», одна строка на сеть; своего поля порядка у
/// Business/Network нет (join по createdAt), мок хранит массив businessId в extras[networkId].order
model NetworkLocationOrder {
  networkId   String   @id @map("network_id") @db.VarChar(32)
  orderedIds  Json     @default("[]") @map("ordered_ids")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy   String?  @map("updated_by") @db.VarChar(32)

  network Network @relation(fields: [networkId], references: [id])

  @@map("network_location_order")
}

/// Сетевая должность (F-11-104…106, NetworkPosition фронта) — НЕ то же самое, что Position.networkId (этап 3,
/// простая должность-строка): тут требования/«только в сети»/услуги должности/филиалы, своя форма
model NetworkPositionDef {
  id                   String   @id @db.VarChar(32)
  networkId            String   @map("network_id") @db.VarChar(32)
  name                 String   @db.VarChar(120)
  description          String?  @db.VarChar(500)
  /// string[] — обязательные кадровые поля (F-11-105)
  requirements         Json     @default("[]")
  /// «Назначать только в сети» — нельзя выбрать в филиале как обычную должность
  networkOnly          Boolean  @default(false) @map("network_only")
  /// Id[] филиалов, где действует (по умолчанию — нигде)
  businessIds          Json     @default("[]") @map("business_ids")
  /// off | strict (F-11-106)
  servicesMode         String   @default("off") @map("services_mode") @db.VarChar(12)
  serviceIds           Json     @default("[]") @map("service_ids")
  keepPriceAndDuration Boolean  @default(true) @map("keep_price_and_duration")
  createdAt            DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy            String?  @map("created_by") @db.VarChar(32)
  updatedBy            String?  @map("updated_by") @db.VarChar(32)
  version              Int      @default(1)

  network Network @relation(fields: [networkId], references: [id])

  @@index([networkId])
  @@map("network_position_defs")
}

/// Архив товаров сети (F-11-118, NetworkGoodsArchiveEntry фронта) — карточка «был архивирован», ключ по ИМЕНИ
/// (как весь каталог товаров сети): «Восстановить» доступно, только пока товар с тем же именем остаётся
/// сетевым (2+ филиала) — считается на чтении из живых Product, тут только факт архивации и когда
model NetworkGoodsArchiveEntry {
  id         String   @id @db.VarChar(32)
  networkId  String   @map("network_id") @db.VarChar(32)
  /// category | good — сейчас пишем только 'good' (архивация категорий сети не построена)
  kind       String   @default("good") @db.VarChar(8)
  name       String   @db.VarChar(200)
  archivedAt DateTime @default(now()) @map("archived_at") @db.DateTime(3)

  network Network @relation(fields: [networkId], references: [id])

  @@index([networkId])
  @@map("network_goods_archive")
}

// === /stage 21 ===

// ───────────────────────── Этап 16: отчёты (docs/backend/02 §16, PLAN §6 №16) ─────────────────────────

/// Звёздочка шапки отчёта (F-12-003) — per-сотрудник, не per-бизнес: сотрудник видит свои избранные на любом месте.
model ReportFavorite {
  staffId   String   @map("staff_id") @db.VarChar(32)
  slug      String   @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([staffId, slug])
  @@map("report_favorites")
}

/// Галочки группы «Отчёты» (F-12-084…089) + «Учитывать в заполненности» (F-12-008) — своя мелкая JSON-таблица
/// per-сотрудник, как ReportsStaffPermissions фронта; отдельно от 39 прав бизнеса (тот же приём, что у сети — этап 15).
model StaffReportsPermission {
  staffId   String   @id @map("staff_id") @db.VarChar(32)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy String?  @map("updated_by") @db.VarChar(32)

  @@map("staff_reports_permissions")
}

/// Выгрузка отчёта — тяжёлая работает задачей в воркере (PLAN §6 №16): строка ставится 'queued' синхронным
/// запросом, worker.ts пересчитывает отчёт и пишет CSV через FileStorage, помечает 'ready'/'failed'.
model ReportExport {
  id         String    @id @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  staffId    String    @map("staff_id") @db.VarChar(32)
  staffName  String    @map("staff_name") @db.VarChar(120)
  /// Имя отчёта из reports/{name} (F-12-074: тип для журнала «Операции с данными»)
  name       String    @db.VarChar(24)
  params     Json
  /// queued | ready | failed
  status     String    @default("queued") @db.VarChar(8)
  fileName   String?   @map("file_name") @db.VarChar(200)
  storageKey String?   @map("storage_key") @db.VarChar(300)
  rowCount   Int?      @map("row_count")
  error      String?   @db.VarChar(300)
  /// upload | copyFromExcel | emailLink | browserDownload (F-12-074…080, этап 21 «network+reports»); null на
  /// старых строках очереди воркера (§16) — читается как 'browserDownload' (reports-export.service.ts::toDto)
  operation  String?   @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  readyAt    DateTime? @map("ready_at") @db.DateTime(3)

  @@index([businessId, createdAt])
  @@index([status])
  @@map("report_exports")
}

// === stage 17 ===
// ───────────────────────── Этап 17: интеграции (docs/backend/02 §17, 01-data-model.md §13, PLAN §6 №17) ─────────────────────────
// Р19: своё — настоящее (api_keys, webhooks+доставки), чужие — только «подключено/нет» + настройки без
// настоящего обмена. Каталог сторонних приложений (имя/описание/цена/FAQ, ~40 карточек в 3 языках,
// кабинет разработчика — В-28 «позже») НЕ переносится на сервер: это витринный контент, а не данные бизнеса,
// и остаётся в src/mock/slices/integrations.ts фронта даже в режиме api (см. PROGRESS.md, «Не строил»).

/// Своё — настоящее: API-ключи/токены для внешних систем (F-13-052 партнёрский Bearer, F-13-053 User token,
/// F-13-071/072 ИИ-ассистент/MCP). Секрет живёт только в момент выпуска (arch-a1) — в базе sha256-хеш и
/// превью последних 4 символов для списка (экран сам маскирует `token` через `maskToken()`, поэтому список
/// отдаёт превью в том же поле — не различить от полноценного секрета на экране, см. PROGRESS.md).
model ApiKey {
  id           String    @id @db.VarChar(32)
  businessId   String    @map("business_id") @db.VarChar(32)
  /// partner | userToken | aiAssistant
  kind         String    @db.VarChar(12)
  label        String?   @db.VarChar(120)
  /// aiAssistant: read | readWrite (F-13-072)
  scope        String?   @db.VarChar(10)
  tokenHash    String    @map("token_hash") @db.VarChar(64)
  tokenPreview String    @map("token_preview") @db.VarChar(8)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  createdBy    String?   @map("created_by") @db.VarChar(32)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)

  @@index([businessId, kind])
  @@map("api_keys")
}

/// Своё — настоящее: настройки вебхука бизнеса (F-13-062…070) — включено, какие из 16 сущностей, секрет
/// подписи (HMAC-SHA256, заголовок X-BookTime-Signature). Один на бизнес.
model Webhook {
  businessId String   @id @map("business_id") @db.VarChar(32)
  enabled    Boolean  @default(false)
  /// WebhookEntity[] — 16 значений домена фронта (WEBHOOK_ENTITIES)
  entities   Json
  secret     String   @db.VarChar(64)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)

  @@map("webhooks")
}

/// F-13-065: адреса, заданные до блокировки новых, продолжают работать («legacy»); экран не предлагает
/// добавить новый (WEBHOOK_NEW_ADDRESS_BLOCKED фронта) — сервер тоже не создаёт их вне сида демо-бизнеса.
model WebhookAddress {
  id            String    @id @db.VarChar(32)
  businessId    String    @map("business_id") @db.VarChar(32)
  url           String    @db.VarChar(500)
  legacy        Boolean   @default(true)
  /// И13 (этап 21): секрет подписи HMAC — целиком в ответе на создание/поворот; `getConfig` отдаёт его как
  /// есть, маскирует фронт (`maskWebhookConfig`); легаси-адрес сида без секрета — null
  signingSecret String?   @map("signing_secret") @db.VarChar(64)
  /// И13: когда адрес последний раз ответил 2xx на проверочный запрос
  verifiedAt    DateTime? @map("verified_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId])
  @@map("webhook_addresses")
}

/// Журнал доставки — по-настоящему подписывается и отправляется `jobs/webhooks-dispatch.ts` (до 5 попыток,
/// растущий отступ), но заполняется НЕ отдельной кнопкой экрана, а fan-out'ом прямо из AuditService.record
/// (common/audit/webhook-fanout.ts) на события, которые уже пишут аудит (booking/client/staff/…). Экран
/// показывает только `delivered`/`failed` — `pending` не выводится, чтобы не заводить третье состояние
/// значка/i18n, которого нет в моке (см. PROGRESS.md).
model WebhookDelivery {
  id            String    @id @db.VarChar(32)
  businessId    String    @map("business_id") @db.VarChar(32)
  addressId     String    @map("address_id") @db.VarChar(32)
  url           String    @db.VarChar(500)
  entity        String    @db.VarChar(20)
  action        String    @db.VarChar(8)
  objectLabel   String    @map("object_label") @db.VarChar(200)
  payload       Json
  /// pending | delivered | failed
  status        String    @default("pending") @db.VarChar(10)
  attempts      Int       @default(0)
  nextAttemptAt DateTime? @map("next_attempt_at") @db.DateTime(3)
  lastError     String?   @map("last_error") @db.VarChar(300)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  deliveredAt   DateTime? @map("delivered_at") @db.DateTime(3)

  @@index([businessId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// Чужие — статус и настройки БЕЗ настоящего обмена (Р19): подключение каталожного приложения к филиалу.
/// `appId` — строковый код из каталога фронта (каталог остаётся там, см. заголовок блока) — 'ia_builtin_client'
/// и т.п. для встроенных, случайный id мока для маркетплейса; сервер не проверяет его существование в
/// каталоге (контента каталога здесь нет), только хранит статус.
model IntegrationConnection {
  id             String    @id @db.VarChar(32)
  businessId     String    @map("business_id") @db.VarChar(32)
  locationId     String    @map("location_id") @db.VarChar(32)
  appId          String    @map("app_id") @db.VarChar(60)
  /// pendingActivation | connected | error | disconnected | autoDisconnected
  status         String    @db.VarChar(20)
  grantedScopes  Json      @map("granted_scopes")
  connectedAt    DateTime  @map("connected_at") @db.DateTime(3)
  activatesBy    DateTime? @map("activates_by") @db.DateTime(3)
  activatedAt    DateTime? @map("activated_at") @db.DateTime(3)
  disconnectedAt DateTime? @map("disconnected_at") @db.DateTime(3)
  paidUntil      DateTime? @map("paid_until") @db.DateTime(3)
  systemUserId   String?   @map("system_user_id") @db.VarChar(32)
  errorText      String?   @map("error_text") @db.VarChar(200)
  /// И2 (этап 21, ревью 27.09): «работает ли» — последний обмен данными с партнёром
  lastEventAt    DateTime? @map("last_event_at") @db.DateTime(3)
  /// sync | message | booking (InstallEventKind фронта)
  lastEventKind  String?   @map("last_event_kind") @db.VarChar(10)
  /// InstallErrorEntry[] — храним 30 дней, экран показывает 7 (recentInstallErrors)
  recentErrors   Json?     @map("recent_errors")
  /// InstallTestResult ({ at, ok, reason? }) последнего «Отправить тест»
  lastTest       Json?     @map("last_test")
  /// Этап 21 (лейн notify+integrations, попытка 3): b03/b04 настройки КОНКРЕТНОГО приложения (AppInstall
  /// фронта, поля после «b03: настройки конкретных приложений») — authKey/senderName/senderNameStatus,
  /// whatsappNumberMode/metaTemplatesApproved, cascadeOrder, negativeReviewIntercept, gaStreams,
  /// kommoSyncMode/kommoDedupe. Один JSON вместо колонки на каждое поле — их набор целиком зависит от appId
  /// каталога (свой на SMS-агрегатор/чат-бот/GA/Kommo), а каталог сознательно остаётся на фронте (Р19,
  /// комментарий модели выше) — своя колонка под каждое поле привязала бы схему к содержимому каталога.
  config         Json?

  @@index([businessId, locationId])
  @@index([appId])
  @@map("integration_connections")
}

// === stage 18 ===
// ───────────────────────── Этап 18: настройки, подписка, монеты, промокоды (docs/backend/06 §2–5, 02 §18) ─────────────────────────

/// Цены и сроки платформы (В-01: «цены храним в таблице, не в коде»; В-15, В-02). Ключи: individual, masterSeat,
/// adminExtraSeat, minPaidMasters, coinPrice, graceDays, freeMonthDays, promoValidDays, photoSlotCoins.
model PlatformPrice {
  key       String   @id @db.VarChar(40)
  value     BigInt
  note      String?  @db.VarChar(200)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy String?  @map("updated_by") @db.VarChar(32)

  @@map("platform_prices")
}

/// Объявленные изменения цен (F-15-048/056/066): действуют только с новой покупки
model PriceRuleChange {
  id             String   @id @db.VarChar(32)
  /// 'YYYY-MM-DD' — с какого дня действует
  effectiveFrom  String   @map("effective_from") @db.VarChar(10)
  announcedAt    String   @map("announced_at") @db.VarChar(10)
  descriptionKey String   @map("description_key") @db.VarChar(40)
  oldPrice       BigInt   @map("old_price")
  newPrice       BigInt   @map("new_price")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("price_rule_changes")
}

/// Подписка бизнеса (06 §3.2) — одна на бизнес; у филиала сети своя (филиал = бизнес).
model Subscription {
  businessId        String    @id @map("business_id") @db.VarChar(32)
  /// unpaid (черновик до этапа пробного периода) | trial (сам зарегистрировался: 7 дней, 01.10.2026) | trial_free |
  /// active | grace | frozen | cancelled | left
  status            String    @db.VarChar(12)
  /// Конец оплаченного/бесплатного срока (UTC, начало следующего дня по Еревану)
  paidUntil         DateTime  @map("paid_until") @db.DateTime(3)
  freeUntil         DateTime? @map("free_until") @db.DateTime(3)
  autoRenew         Boolean   @default(true) @map("auto_renew")
  savedCardId       String?   @map("saved_card_id") @db.VarChar(32)
  /// Промокод регистрации (В-13): снимок ступеней на момент применения — отзыв кода скидку не отнимает
  promoRedemptionId String?   @map("promo_redemption_id") @db.VarChar(32)
  promoCode         String?   @map("promo_code") @db.VarChar(40)
  promoTiers        Json?     @map("promo_tiers")
  /// Скидка потрачена на первую оплату (F-00-021) — дальше обычная цена
  promoUsedAt       DateTime? @map("promo_used_at") @db.DateTime(3)
  paymentDocsEmail  Boolean   @default(true) @map("payment_docs_email")
  /// Отсрочка (В-02: 3 дня → только чтение)
  graceUntil        DateTime? @map("grace_until") @db.DateTime(3)
  /// За сколько дней уже предупредили (7/3/1) в текущем периоде — чтобы не слать дважды
  warnedDays        Int?      @map("warned_days")
  /// Следующая попытка списания после неудачи (раз в сутки)
  retryAt           DateTime? @map("retry_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy         String?   @map("updated_by") @db.VarChar(32)
  version           Int       @default(1)

  @@index([status, paidUntil])
  @@map("subscriptions")
}

/// Списание за подписку (06 §3.2) — строка «Истории лицензии» (F-15-072)
model SubscriptionCharge {
  id           String    @id @db.VarChar(32)
  businessId   String    @map("business_id") @db.VarChar(32)
  periodStart  DateTime  @map("period_start") @db.DateTime(3)
  periodEnd    DateTime  @map("period_end") @db.DateTime(3)
  months       Int
  seatsMasters Int       @map("seats_masters")
  seatsAdmins  Int       @map("seats_admins")
  baseAmount   BigInt    @map("base_amount")
  discountPct  Int       @default(0) @map("discount_pct")
  amount       BigInt
  /// card | idram | telcell | invoice | promo | freeMonth | platform
  method       String    @db.VarChar(12)
  /// pending | paid | failed | refunded
  status       String    @db.VarChar(10)
  provider     String    @db.VarChar(12)
  providerRef  String?   @map("provider_ref") @db.VarChar(80)
  invoiceId    String?   @map("invoice_id") @db.VarChar(32)
  /// auto — автопродление воркером; manual — «Оплатить»
  trigger      String    @default("manual") @db.VarChar(8)
  attemptedAt  DateTime  @default(now()) @map("attempted_at") @db.DateTime(3)
  paidAt       DateTime? @map("paid_at") @db.DateTime(3)
  createdBy    String?   @map("created_by") @db.VarChar(32)

  @@index([businessId, attemptedAt])
  @@map("subscription_charges")
}

/// Счёт/чек за подписку, монеты, рекламу (F-15-073/087/088, В-33: нефискальный документ)
model BillingInvoice {
  id         String    @id @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  number     String    @unique @db.VarChar(20)
  /// subscription | coins | ads
  purpose    String    @db.VarChar(12)
  amount     BigInt
  /// paid | unpaid | cancelled
  status     String    @db.VarChar(10)
  periodFrom String?   @map("period_from") @db.VarChar(10)
  periodTo   String?   @map("period_to") @db.VarChar(10)
  method     String?   @db.VarChar(12)
  /// Снимок реквизитов плательщика на момент выставления
  payer      Json?
  /// Что куплено за монеты: id пакета
  refId      String?   @map("ref_id") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  paidAt     DateTime? @map("paid_at") @db.DateTime(3)

  @@index([businessId, createdAt])
  @@map("billing_invoices")
}

/// Счётчики нумерации (номер счёта) — строка на ключ, инкремент под блокировкой строки
model BillingCounter {
  key   String @id @db.VarChar(20)
  value Int

  @@map("billing_counters")
}

/// Сохранённый способ оплаты (06 §3.2): токен провайдера, маска
model SavedCard {
  id          String   @id @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  provider    String   @db.VarChar(12)
  /// card | idram | telcell
  method      String   @db.VarChar(12)
  token       String   @db.VarChar(200)
  label       String   @db.VarChar(40)
  unavailable Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId])
  @@map("saved_cards")
}

/// Бесплатные дни (06 §5): visit — подключили на визите, first — первому, promo, manual
model FreePeriodGrant {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  days       Int
  reason     String   @db.VarChar(8)
  by         String   @db.VarChar(32)
  note       String?  @db.VarChar(300)
  at         DateTime @default(now()) @db.DateTime(3)

  @@index([businessId])
  @@map("free_period_grants")
}

/// Промокод (06 §4.2, В-13: 10/15/25% за 3/6/12 мес., на один бизнес, 30 дней)
model PromoCode {
  id         String    @id @db.VarChar(32)
  /// Всегда в верхнем регистре
  code       String    @unique @db.VarChar(24)
  /// discount | freeMonth
  kind       String    @db.VarChar(10)
  /// [{months, percent}]
  tiers      Json
  freeDays   Int?      @map("free_days")
  personal   Boolean   @default(true)
  /// {name, phone?, visitId?, businessId?}
  issuedTo   Json?     @map("issued_to")
  issuedAt   DateTime? @map("issued_at") @db.DateTime(3)
  validUntil String?   @map("valid_until") @db.VarChar(10)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  note       String?   @db.VarChar(300)
  createdBy  String    @map("created_by") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@map("promo_codes")
}

/// Применение промокода — уникальный индекс держит «одноразовый» (два салона в одну секунду → второй promo_used)
model PromoRedemption {
  id          String   @id @db.VarChar(32)
  promoCodeId String   @unique @map("promo_code_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  redeemedAt  DateTime @default(now()) @map("redeemed_at") @db.DateTime(3)

  @@index([businessId])
  @@map("promo_redemptions")
}

/// Кошелёк монет бизнеса — кэш баланса, строка блокируется при списании (06 §2.2)
model CoinWallet {
  businessId String   @id @map("business_id") @db.VarChar(32)
  balance    Int      @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("coin_wallets")
}

/// Журнал движений монет (06 §2.2): баланс = SUM(amount)
model CoinEntry {
  id             String   @id @db.VarChar(32)
  businessId     String   @map("business_id") @db.VarChar(32)
  /// + пришло, − ушло
  amount         Int
  /// topup | charge | refund | gift (как CoinMove.kind фронта)
  kind           String   @db.VarChar(8)
  reason         String   @db.VarChar(40)
  area           String   @db.VarChar(20)
  refId          String?  @map("ref_id") @db.VarChar(32)
  /// Фактическая цена в драмах для покупки пакета
  price          BigInt?
  idempotencyKey String?  @unique @map("idempotency_key") @db.VarChar(80)
  by             String   @db.VarChar(32)
  at             DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, at])
  @@map("coin_entries")
}

/// Пакеты монет (В-15: 1 монета = 10 ֏, пакеты 100 / 500 (+5%) / 2000 (+10%))
model CoinPackage {
  id           String  @id @db.VarChar(20)
  coins        Int
  price        BigInt
  bonusPercent Int     @default(0) @map("bonus_percent")
  popular      Boolean @default(false)
  sort         Int     @default(0)
  active       Boolean @default(true)

  @@map("coin_packages")
}

/// Журнал правок настроек компании (F-15-180): «было → стало» по полю
model SettingsChangeLog {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// brand | contacts | legal | system | categories
  section    String   @db.VarChar(12)
  fieldKey   String   @map("field_key") @db.VarChar(40)
  before     String   @db.Text
  after      String   @db.Text
  staffId    String   @map("staff_id") @db.VarChar(32)
  staffName  String   @map("staff_name") @db.VarChar(160)
  at         DateTime @default(now()) @db.DateTime(3)

  @@index([businessId, at])
  @@map("settings_change_log")
}

/// Обращения бизнеса к нам: help — помощь (F-15-001), mobileApp — «хочу своё приложение» (В-29).
/// number/reply/repliedAt/updatedAt — этап 19: kind=help сливается в одну очередь поддержки с SupportTicket
/// (F-00-182), нить — одно входящее + один ответ (упрощение против многоходовой SupportMessage[] мока, честно
/// не то же самое — записано в PROGRESS.md).
model BizRequest {
  id            String    @id @db.VarChar(32)
  businessId    String    @map("business_id") @db.VarChar(32)
  authorStaffId String    @map("author_staff_id") @db.VarChar(32)
  /// help | mobileApp
  kind          String    @db.VarChar(10)
  topic         String?   @db.VarChar(12)
  message       String?   @db.Text
  /// open | answered | closed
  status        String    @default("open") @db.VarChar(10)
  /// Единая нумерация с SupportTicket — общий счётчик platform_counters(key='support'); только kind=help
  number        Int?
  reply         String?   @db.Text
  repliedAt     DateTime? @map("replied_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId, kind, createdAt])
  @@index([kind, status, updatedAt])
  @@map("biz_requests")
}

/// «Моей сферы нет» / новая сфера на год (F-15-005, F-00-151/152, В-14: не готова за 60 дней → возврат или сдвиг).
/// kind/phone/sphereName/needs — этап 19: наша панель заводит заявки и от людей без бизнеса ещё (kind=newSphere,
/// businessId пуст); заявки из кабинета (kind по умолчанию noSphere) продолжают работать без этих полей.
model SphereRequest {
  id            String    @id @db.VarChar(32)
  businessId    String?   @map("business_id") @db.VarChar(32)
  authorStaffId String?   @map("author_staff_id") @db.VarChar(32)
  /// noSphere — из кабинета, «моей сферы нет» | newSphere — заведена нами (визит/звонок), без бизнеса
  kind          String    @default("noSphere") @db.VarChar(10)
  name          String    @db.VarChar(160)
  phone         String?   @db.VarChar(20)
  /// Профессия своими словами (F-00-151) — для заявок из кабинета совпадает с name
  sphereName    String?   @map("sphere_name") @db.VarChar(160)
  /// string[] — что нужно, согласовано письменно (F-00-152)
  needs         Json?
  message       String?   @db.Text
  /// open | answered | closed (кабинет) — панель показывает через STATUS_RANK open|agreed|inProgress|done
  status        String    @default("open") @db.VarChar(10)
  /// [{id, labelKey, done}]
  checklist     Json?
  etaDate       String?   @map("eta_date") @db.VarChar(10)
  readyAt       String?   @map("ready_at") @db.VarChar(10)
  note          String?   @db.VarChar(500)
  decidedAt     DateTime? @map("decided_at") @db.DateTime(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId, createdAt])
  @@index([kind, status, createdAt])
  @@map("sphere_requests")
}

/// Личные настройки сотрудника в кабинете (F-15-150…157): уведомления, стартовая страница
model StaffAccountPref {
  staffId           String   @id @map("staff_id") @db.VarChar(32)
  notificationPrefs Json     @map("notification_prefs")
  startPage         String?  @map("start_page") @db.VarChar(20)
  startLocationId   String?  @map("start_location_id") @db.VarChar(32)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("staff_account_prefs")
}

// === end stage 18 ===

// === stage 19 ===
// ───────────────────────── Этап 19: модерация и наша панель (docs/backend/06 §1, 02 §19) ─────────────────────────

/// Справочник причин отказа (F-00-170) — история отказов хранит подпись, скрытая причина не меняет прошлое
model RejectReason {
  id     String  @id @db.VarChar(32)
  /// LocalizedText
  label  Json
  active Boolean @default(true)
  /// Порядок в списке при выборе
  order  Int     @default(0)

  @@map("reject_reasons")
}

/// Очередь проверки (F-00-168…171, F-00-179) — одна таблица на все виды материала (фото/услуга/текст/диплом/
/// сторис/жалоба/отзыв), refId — ключ каталога подключает docs 06 §1.3 отдельным проходом (P7, не в этом этапе):
/// сейчас submitForModeration/isVisibleToClients — самостоятельный контракт, ничего снаружи модуля его не читает.
/// imageUrl — LongText (как ClientFile.dataUrl, этап 5): фото приходят data URI до 4 МБ, не короткой ссылкой.
model ModerationItem {
  id           String    @id @db.VarChar(32)
  /// staffPhoto | salonPhoto | servicePhoto | service | text | diploma | story | complaint | review
  kind         String    @db.VarChar(16)
  businessId   String    @map("business_id") @db.VarChar(32)
  staffId      String?   @map("staff_id") @db.VarChar(32)
  serviceId    String?   @map("service_id") @db.VarChar(32)
  /// Что именно проверяем — id фото/услуги/текста/документа/сторис/жалобы (ключ вызывающей стороны, не сама картинка)
  refId        String    @map("ref_id") @db.VarChar(64)
  label        String?   @db.VarChar(200)
  text         String?   @db.Text
  imageUrl     String?   @map("image_url") @db.LongText
  /// Плитка без картинки — цвет 1..8 (мок-приём для сидов, сервер тоже допускает)
  tone         Int?
  /// Платный материал: сколько монет списано (место под фото, сторис) — возвращается при отказе
  paidCoins    Int?      @map("paid_coins")
  /// pending | approved | rejected | auto
  status       String    @default("pending") @db.VarChar(10)
  /// user | visit | template | reuse
  source       String    @default("user") @db.VarChar(10)
  reasonId     String?   @map("reason_id") @db.VarChar(32)
  reasonNote   String?   @map("reason_note") @db.VarChar(300)
  /// Для жалобы — на какой материал (id другого ModerationItem)
  targetItemId String?   @map("target_item_id") @db.VarChar(32)
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.DateTime(3)
  decidedAt    DateTime? @map("decided_at") @db.DateTime(3)
  /// ModerationEvent[] фронта — {id, at, kind, note?, coins?}
  history      Json

  @@index([businessId, submittedAt])
  @@index([status, kind, submittedAt])
  @@index([refId])
  @@map("moderation_items")
}

/// Наши сведения о бизнесе (06 §5, P2, F-00-183) — то, чего нет в Business/Subscription: как узнали о салоне,
/// кто из команды ведёт, данные выданы при уходе. adsOptIn и leftAt уже в Business (F-00-164, 03 §5) — не дублируем;
/// freeUntil — в Subscription (этап 18). Строки нет — бизнес зарегистрировался сам, без заметок (source='self').
model BizMeta {
  businessId    String    @id @map("business_id") @db.VarChar(32)
  /// visit — подключили мы на визите; self — зарегистрировался сам
  source        String    @default("self") @db.VarChar(6)
  responsibleId String?   @map("responsible_id") @db.VarChar(32)
  /// Промокод, который выдали именно на визите (может отличаться от Subscription.promoRedemptionId по времени)
  promoCodeId   String?   @map("promo_code_id") @db.VarChar(32)
  dataHandedAt  DateTime? @map("data_handed_at") @db.DateTime(3)
  note          String?   @db.VarChar(500)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("biz_meta")
}

/// Копия данных бизнеса «на всякий случай» (F-00-183) — счётчики строк, не архив байт (честно, как в моке;
/// настоящий бэкап — средствами хостинга целиком, этап 21/20)
model BackupCopy {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// auto | manual
  kind       String   @default("manual") @db.VarChar(8)
  /// BackupCounts фронта — {clients, bookings, services, staff}
  counts     Json
  sizeKb     Int      @map("size_kb")
  at         DateTime @default(now()) @map("at") @db.DateTime(3)

  @@index([businessId, at])
  @@map("backup_copies")
}

/// Идеи бизнесов (F-00-009) — заводит кабинет (POST /v1/biz/{b}/ideas), очередь и статус — наша панель
model Idea {
  id         String    @id @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  authorName String    @map("author_name") @db.VarChar(160)
  text       String    @db.VarChar(2000)
  votes      Int       @default(0)
  /// Id[] бизнесов, уже проголосовавших — против повторного голоса
  voterIds   Json      @map("voter_ids")
  /// considering | inProgress | done
  status     String    @default("considering") @db.VarChar(12)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  decidedAt  DateTime? @map("decided_at") @db.DateTime(3)
  notifiedAt DateTime? @map("notified_at") @db.DateTime(3)

  @@index([businessId])
  @@map("ideas")
}

/// Визиты нашей команды к салонам (F-00-177) — CRM обхода, отдельно от MedicalVisitNote (тот же смысл, что
/// 'vis'-визит журнала, префикс здесь свой, чтобы не путать два разных «визита»). История — Json, как везде
/// у некрупных сущностей (FinOp.history, этап 12), отдельная таблица событий не оправдана при таком объёме.
model SalesVisit {
  id            String   @id @db.VarChar(32)
  placeName     String   @map("place_name") @db.VarChar(160)
  contactName   String?  @map("contact_name") @db.VarChar(160)
  phone         String?  @db.VarChar(20)
  district      String?  @db.VarChar(20)
  address       String?  @db.VarChar(300)
  sphereId      String?  @map("sphere_id") @db.VarChar(40)
  /// connected | thinking | refused
  status        String   @default("thinking") @db.VarChar(10)
  /// 'YYYY-MM-DD'
  visitedAt     String   @map("visited_at") @db.VarChar(10)
  callbackDate  String?  @map("callback_date") @db.VarChar(10)
  refusalReason String?  @map("refusal_reason") @db.VarChar(300)
  note          String?  @db.VarChar(2000)
  /// dikidi | altegio | whatsapp | notebook | other | nothing
  currentTool   String?  @map("current_tool") @db.VarChar(10)
  /// Драмы в месяц — сколько готовы платить
  willingToPay  BigInt?  @map("willing_to_pay")
  responsibleId String   @map("responsible_id") @db.VarChar(32)
  businessId    String?  @map("business_id") @db.VarChar(32)
  promoCodeId   String?  @map("promo_code_id") @db.VarChar(32)
  /// Место из базы «Места» (Prospect), к которому ходили; статус места выводится из последнего визита
  prospectId    String?  @map("prospect_id") @db.VarChar(32)
  /// VisitEvent[] фронта — {id, at, kind, status?, date?, text?}
  history       Json
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, callbackDate])
  @@index([businessId])
  @@index([prospectId])
  @@map("sales_visits")
}

/// «Места» (03.10.2026): база заведений Еревана, куда отдел продаж может предложить BookTime. Наполняется импортом
/// (JSON от сборщиков данных, upsert по dedupKey) и правкой в панели. Статус («не были / думает / подключили /
/// отказ / работает в BookTime») не хранится — выводится из последнего SalesVisit с этим prospectId.
model Prospect {
  id            String   @id @db.VarChar(32)
  name          String   @db.VarChar(200)
  /// beauty | nails | barber | hair | brows_lashes | cosmetology | massage_spa | clinic | dental | other
  category      String   @default("other") @db.VarChar(16)
  /// DistrictId фронта (kentron, achapnyak, malatia-sebastia…) или unknown
  district      String   @default("unknown") @db.VarChar(20)
  address       String?  @db.VarChar(300)
  branches      Int?
  staffEstimate Int?     @map("staff_estimate")
  /// Откуда оценка числа мастеров (сайт, Instagram, Google…)
  staffSource   String?  @map("staff_source") @db.VarChar(300)
  /// phone_whatsapp | instagram | emly_off | unknown | own_site | emly | booker | altegio | dikidi | fresha | sonline | booksy | other_online | medical_platform
  bookingSystem String   @default("unknown") @map("booking_system") @db.VarChar(20)
  bookingUrl    String?  @map("booking_url") @db.VarChar(500)
  website       String?  @db.VarChar(500)
  instagram     String?  @db.VarChar(500)
  /// Общий телефон заведения (не личный)
  phone         String?  @db.VarChar(40)
  /// { rating?, count?, text? }
  reviews       Json?
  /// string[] — где нашли сведения
  sourceUrls    Json     @map("source_urls")
  note          String?  @db.VarChar(2000)
  /// string[]
  tags          Json?
  /// Нормализованное «имя|адрес» (нижний регистр, без знаков) — ключ дедупликации импорта
  dedupKey      String   @unique @map("dedup_key") @db.VarChar(255)
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([bookingSystem])
  @@index([category])
  @@index([district])
  @@index([staffEstimate])
  @@map("prospects")
}

/// Общий счётчик последовательных номеров панели (сейчас — только 'support': единая нумерация
/// SupportTicket + BizRequest(kind=help), F-00-182). Инкремент — `UPDATE … SET value = value + 1` под транзакцией.
model PlatformCounter {
  key   String @id @db.VarChar(20)
  value Int    @default(0)

  @@map("platform_counters")
}

// ─── Этап 19 (продолжение, попытка 2): спрос/first-award, реклама+сторис, заметки основателя (02 §19) ───
// DemandLead уже был (этап 9, поле notify добавлено там же выше) — здесь только FirstAward. AdPlacement —
// статичный справочник в коде (4 места, ads.constants.ts), как PLACEMENTS мок-контракта, не таблица.

/// Достижение «первый в районе/сфере» (F-00-181) — по одному на (scope, sphereId, district): второй раз тот же
/// слот не выдаётся (проверка в сервисе, не уникальный индекс — MySQL не различает NULL в district одинаково
/// для двух вставок; частота вызова — ручная кнопка панели раз на бизнес, гонка не имеет практического веса).
model FirstAward {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// sphere | district
  scope      String   @db.VarChar(8)
  sphereId   String   @map("sphere_id") @db.VarChar(20)
  district   String?  @db.VarChar(20)
  freeDays   Int      @map("free_days")
  coins      Int
  at         DateTime @default(now()) @db.DateTime(3)

  @@index([scope, sphereId, district])
  @@index([businessId])
  @@map("first_awards")
}

/// Реклама (F-00-163…166): баннеры клиенту, предложения поставщиков кабинету — ставим только мы, рекламодатель
/// без аккаунта (имя+контакт). targetSphereIds/targetDistricts — SphereId[]/DistrictId[] (пусто = все).
model Ad {
  id                String   @id @db.VarChar(32)
  /// banner | supplier
  kind              String   @db.VarChar(8)
  title             String   @db.VarChar(200)
  text              String?  @db.VarChar(2000)
  imageUrl          String?  @map("image_url") @db.MediumText
  ctaUrl            String?  @map("cta_url") @db.VarChar(1000)
  advertiserName    String   @map("advertiser_name") @db.VarChar(160)
  advertiserContact String   @map("advertiser_contact") @db.VarChar(160)
  placementId       String   @map("placement_id") @db.VarChar(20)
  targetSphereIds   Json     @map("target_sphere_ids")
  targetDistricts   Json     @map("target_districts")
  /// any | individual | salonSmall | salonLarge
  targetSize        String   @default("any") @map("target_size") @db.VarChar(12)
  targetMinStars    Int?     @map("target_min_stars")
  /// Товары/бренды — только для места pl_stock (F-00-165)
  productKeywords   Json     @map("product_keywords")
  startDate         String   @map("start_date") @db.VarChar(10)
  endDate           String   @map("end_date") @db.VarChar(10)
  price             BigInt
  paused            Boolean  @default(false)
  supportTicketId   String?  @map("support_ticket_id") @db.VarChar(32)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([placementId, paused, startDate, endDate])
  @@map("ads")
}

/// Счётчики показов/нажатий по дням (F-00-166, P10 07-mock-only) — своя таблица, не JSON на Ad: показ/клик
/// растут атомарным upsert-инкрементом (`INSERT … ON DUPLICATE KEY UPDATE views = views + 1`), не
/// read-modify-write — иначе параллельные показы клиентам теряли бы счёт (мок писал в JSON браузера — там
/// гонок не было, потому что один браузер = одна вкладка).
model AdDayStat {
  adId   String @map("ad_id") @db.VarChar(32)
  date   String @db.VarChar(10)
  views  Int    @default(0)
  clicks Int    @default(0)

  @@id([adId, date])
  @@map("ad_day_stats")
}

/// Настройки мест сторис (F-00-160) — одна строка (id='singleton'), правит наша панель; pricePerDay — монеты,
/// не драмы (Money — только для рекламы поставщиков, здесь коротко Int, как в моке).
model StoryConfig {
  id               String   @id @default("singleton") @db.VarChar(10)
  places           Int      @default(6)
  /// district | city
  scope            String   @default("city") @db.VarChar(8)
  pricePerDay      Int      @default(2000) @map("price_per_day")
  lastPlacesCount  Int      @default(2) @map("last_places_count")
  lastPlacesMarkup Int      @default(50) @map("last_places_markup")
  queueMarkup      Int      @default(30) @map("queue_markup")
  daysAhead        Int      @default(14) @map("days_ahead")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("story_config")
}

/// Бронирования мест сторис (F-00-159…162). Покупка кабинетом ещё не построена во фронте (только чтение
/// getStoryBoard/getStoryPlaces — P9 07-mock-only, K18 картинка сторис тоже не решена) — таблица и «замок на
/// день» ниже готовы принять первую настоящую покупку без новой миграции, очередь дня сейчас у всех пуста.
model StoryBooking {
  id                String   @id @db.VarChar(32)
  businessId        String   @map("business_id") @db.VarChar(32)
  date              String   @db.VarChar(10)
  district          String?  @db.VarChar(40)
  /// place | queue
  mode              String   @db.VarChar(6)
  price             Int
  /// active | cancelled | rejected
  status            String   @default("active") @db.VarChar(10)
  /// template | photo
  source            String   @default("photo") @db.VarChar(10)
  moderationItemId  String?  @map("moderation_item_id") @db.VarChar(32)
  views             Int      @default(0)
  clicks            Int      @default(0)
  bookingsFromStory Int      @default(0) @map("bookings_from_story")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  /// Этап 21 (сдача, попытка 6): покупка сторис кабинетом (client.ts::purchaseStory, F-00-155…163) — сама картинка
  /// (data URI до 4 МБ), до какого момента показ, и поля Story фронта (lang/showStaffNames/windows/bookingTarget/caption)
  imageUrl          String?   @map("image_url") @db.LongText
  expiresAt         DateTime? @map("expires_at") @db.DateTime(3)
  data              Json?

  @@index([date, status])
  @@index([businessId])
  @@map("story_bookings")
}

/// «Замок на день» очереди сторис (PLAN §4.2 приём — своя таблица, не пересечение времени, а счётчик мест
/// одного дня+области): INSERT IGNORE + SELECT…FOR UPDATE перед подсчётом занятых мест, как person_locks.
model StoryDayLock {
  dayKey String @id @map("day_key") @db.VarChar(50)

  @@map("story_day_locks")
}

/// Заметки основателя — план запуска, окупаемость, имя (01 §8, F-00-203…208): рабочий документ, не продуктовая
/// функция конечных пользователей. Одна строка, одним JSON-документом (02 §19: «…/notes, одним документом») —
/// проще отдельных таблиц под волны/имена/окупаемость, экран правит их вместе. payingNow — не хранится, считается
/// каждый раз заново от Business/Subscription (F-00-206: «не вводим руками»).
model PlatformNotes {
  id        String   @id @default("singleton") @db.VarChar(10)
  /// { waveItems, prelaunchItems, paybackInputs, nameCandidates, brand } — LaunchNotesDoc фронта
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("platform_notes")
}

/// Подключение салона на визите за 10 минут (F-00-176, F-00-171, F-00-052) — черновик по шагам, «Подключить»
/// делает всё одной транзакцией (PLAN §9): бизнес+филиал+владелец+приглашённые мастера+услуги+часы+фото(auto)+
/// бесплатный месяц+промокод+визит→connected (connect.service.ts). Без version/createdBy (как SalesVisit/
/// PlatformNotes этого же этапа) — рабочий документ одного человека из команды, гонка не имеет практического веса.
model ConnectDraft {
  id            String    @id @db.VarChar(32)
  /// draft | done
  status        String    @default("draft") @db.VarChar(6)
  /// Текущий шаг мастера (с 0) — только для возврата на то же место при перезагрузке
  step          Int       @default(0)
  /// individual | salon
  kind          String    @default("salon") @db.VarChar(12)
  name          String    @default("") @db.VarChar(160)
  sphereId      String?   @map("sphere_id") @db.VarChar(40)
  ownerName     String    @default("") @map("owner_name") @db.VarChar(160)
  ownerPhone    String    @default("") @map("owner_phone") @db.VarChar(20)
  district      String?   @db.VarChar(40)
  address       String    @default("") @db.VarChar(300)
  yandexMapsUrl String    @default("") @map("yandex_maps_url") @db.VarChar(1000)
  /// Точка из «Я на месте» — без карт (F-00-176)
  lat           Decimal?  @db.Decimal(9, 6)
  lng           Decimal?  @db.Decimal(9, 6)
  coordsAt      DateTime? @map("coords_at") @db.DateTime(3)
  /// string[] data URI, как Business.photos
  photos        Json
  /// ConnectInvite[] фронта — {id, name, phone}; масters получают настоящие staff_invites при «Подключить»
  invites       Json
  /// ConnectServiceLine[] — шаблон услуг сферы, отмечены/сняты (F-00-083)
  services      Json
  /// WeekTemplate — часы владельца; салону календарь всегда 'free', индивидуал выбирает (F-00-052)
  hours         Json
  /// free | busy — только для kind='individual' (connectIssues фронта требует явный выбор)
  calendarMode  String?   @map("calendar_mode") @db.VarChar(5)
  promoCodeId   String?   @map("promo_code_id") @db.VarChar(32)
  visitId       String?   @map("visit_id") @db.VarChar(32)
  /// Кто из команды ведёт подключение (SalesVisit.responsibleId — тот же смысл)
  responsibleId String    @map("responsible_id") @db.VarChar(32)
  businessId    String?   @map("business_id") @db.VarChar(32)
  startedAt     DateTime  @default(now()) @map("started_at") @db.DateTime(3)
  finishedAt    DateTime? @map("finished_at") @db.DateTime(3)

  @@index([status])
  @@index([visitId])
  @@index([businessId])
  @@map("connect_drafts")
}

