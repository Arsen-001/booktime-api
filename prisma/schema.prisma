/// Категория товаров, дерево (F-08-010…014)
model StockCategory {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  locationId String   @map("location_id") @db.VarChar(32)
  name       String   @db.VarChar(160)
  parentId   String?  @map("parent_id") @db.VarChar(32)
  sku        String?  @db.VarChar(60)
  comment    String?  @db.VarChar(400)
  archived   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  @@index([businessId, locationId, archived])
  @@index([parentId])
  @@map("product_categories")
}

/// Товар/расходник (F-08-015…027, F-00-134, F-00-140, F-00-144) — «Good» фронта
model Product {
  id                     String    @id @db.VarChar(32)
  businessId             String    @map("business_id") @db.VarChar(32)
  locationId             String    @map("location_id") @db.VarChar(32)
  categoryId             String    @map("category_id") @db.VarChar(32)
  name                   String    @db.VarChar(200)
  /// «Название в чеке» — пусто ⇒ берётся name
  receiptName            String?   @map("receipt_name") @db.VarChar(200)
  sku                    String?   @db.VarChar(60)
  barcode                String?   @db.VarChar(64)
  markingCode            String?   @map("marking_code") @db.VarChar(64)
  saleUnit               String    @map("sale_unit") @db.VarChar(16)
  writeoffUnit           String    @map("writeoff_unit") @db.VarChar(16)
  /// Единиц списания в одной единице продажи (F-08-020)
  unitRatio              Float     @default(1) @map("unit_ratio")
  massNetG               Int?      @map("mass_net_g")
  massGrossG             Int?      @map("mass_gross_g")
  salePrice              BigInt    @default(0) @map("sale_price")
  costPrice              BigInt    @default(0) @map("cost_price")
  /// default | general
  taxSystem              String    @default("default") @map("tax_system") @db.VarChar(10)
  /// default | rate20 | none
  taxRate                String    @default("default") @map("tax_rate") @db.VarChar(10)
  /// В единицах продажи, 0 = выключено (F-08-024)
  criticalStock          Float     @default(0) @map("critical_stock")
  /// В единицах продажи, 0 = выключено (F-08-025)
  desiredStock           Float     @default(0) @map("desired_stock")
  brand                  String?   @db.VarChar(120)
  shade                  String?   @db.VarChar(80)
  shadeColorIndex        Int?      @map("shade_color_index")
  expiryDate             DateTime? @map("expiry_date") @db.DateTime(3)
  purchaseDate           DateTime? @map("purchase_date") @db.DateTime(3)
  shelfLifeAfterOpenDays Int?      @map("shelf_life_after_open_days")
  /// ⭐ F-00-144: показывать в приложении клиента
  showToClients          Boolean   @default(false) @map("show_to_clients")
  /// ⭐ F-00-172: LocalizedText, только когда showToClients
  clientName             Json?     @map("client_name")
  /// F-08-130/135: сетевая копия — общий id у всех филиалов, редактируется в филиале только NETWORK_LOCAL_FIELDS
  networkGroupId         String?   @map("network_group_id") @db.VarChar(32)
  isNetworkSource        Boolean   @default(false) @map("is_network_source")
  comment                String?   @db.VarChar(400)
  archived               Boolean   @default(false)
  createdAt              DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy              String?   @map("created_by") @db.VarChar(32)
  updatedBy              String?   @map("updated_by") @db.VarChar(32)
  version                Int       @default(1)

  @@index([businessId, locationId, archived])
  @@index([categoryId])
  @@index([businessId, barcode])
  @@index([networkGroupId])
  @@map("products")
}

/// Документ складской операции (F-08-046…061, F-00-135/137/138) — «OperationDoc» фронта
model StockOp {
  id                 String    @id @db.VarChar(32)
  businessId         String    @map("business_id") @db.VarChar(32)
  locationId         String    @map("location_id") @db.VarChar(32)
  number             String    @db.VarChar(20)
  /// income | sale | writeoffService | writeoffProduct | move
  type               String    @db.VarChar(16)
  date               DateTime  @db.DateTime(3)
  warehouseId        String    @map("warehouse_id") @db.VarChar(32)
  /// Только для move
  toWarehouseId      String?   @map("to_warehouse_id") @db.VarChar(32)
  counterpartyName   String?   @map("counterparty_name") @db.VarChar(160)
  clientId           String?   @map("client_id") @db.VarChar(32)
  staffId            String?   @map("staff_id") @db.VarChar(32)
  serviceId          String?   @map("service_id") @db.VarChar(32)
  bookingId          String?   @map("booking_id") @db.VarChar(32)
  paid               Boolean   @default(true)
  /// Только для sale: cash | card | loyalty | unpaid
  paymentMethod      String?   @map("payment_method") @db.VarChar(10)
  /// F-08-075…077: SaleExtraLine[] — абонементы/сертификаты этой продажи (ссылка на loyalty)
  extraLines         Json?     @map("extra_lines")
  /// F-08-041/042: документ — автосписание по норме техкарты; идемпотентность по bookingId
  autoWriteoff       Boolean   @default(false) @map("auto_writeoff")
  cancelledAt        DateTime? @map("cancelled_at") @db.DateTime(3)
  /// Операция finance, которую создал этот документ (оплаченный приход/продажа)
  financeOperationId String?   @map("finance_operation_id") @db.VarChar(32)
  /// norm | manual | defect | expired
  reason             String?   @db.VarChar(10)
  comment            String?   @db.VarChar(400)
  /// Проведена этой инвентаризацией
  inventoryId        String?   @map("inventory_id") @db.VarChar(32)
  /// move: ссылка на документ-разворот отмены
  cancelledByDocId   String?   @map("cancelled_by_doc_id") @db.VarChar(32)
  /// move: этот документ — разворот отменённого (или откат автосписания)
  cancelsDocId       String?   @map("cancels_doc_id") @db.VarChar(32)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy          String?   @map("created_by") @db.VarChar(32)
  updatedBy          String?   @map("updated_by") @db.VarChar(32)
  version            Int       @default(1)

  @@index([businessId, locationId, date])
  @@index([businessId, number])
  @@index([bookingId])
  @@index([warehouseId])
  @@index([inventoryId])
  @@map("stock_ops")
}

/// Строка складского документа — количество в единицах продажи, расход отрицательный (F-08-047)
model StockOpLine {
  id          String @id @db.VarChar(32)
  opId        String @map("op_id") @db.VarChar(32)
  businessId  String @map("business_id") @db.VarChar(32)
  goodId      String @map("good_id") @db.VarChar(32)
  qtySale     Float  @map("qty_sale")
  unitPrice   BigInt @map("unit_price")
  discountPct Int?   @map("discount_pct")
  costTotal   BigInt @map("cost_total")
  /// З9: продавец строки продажи (товар визита — его продавец); null — продавец документа (StockOp.staffId)
  sellerId    String? @map("seller_id") @db.VarChar(32)

  @@index([opId])
  @@index([businessId, goodId])
  @@map("stock_op_lines")
}

/// Технологическая карта услуги — у каждого мастера своя (F-08-036…045, F-08-136, F-00-136)
model TechCard {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  locationId String   @map("location_id") @db.VarChar(32)
  serviceId  String   @map("service_id") @db.VarChar(32)
  staffId    String   @map("staff_id") @db.VarChar(32)
  /// TechCardLine[]: { goodId, warehouseId, qtyWriteoff }
  lines      Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  @@unique([businessId, serviceId, staffId])
  @@index([businessId, locationId])
  @@map("tech_cards")
}

/// Инвентаризация (F-08-079…089, F-00-135)
model Inventory {
  id            String   @id @db.VarChar(32)
  businessId    String   @map("business_id") @db.VarChar(32)
  locationId    String   @map("location_id") @db.VarChar(32)
  number        String   @db.VarChar(20)
  warehouseId   String   @map("warehouse_id") @db.VarChar(32)
  /// Пусто = «Все категории»
  categoryId    String?  @map("category_id") @db.VarChar(32)
  date          DateTime @db.DateTime(3)
  comment       String?  @db.VarChar(400)
  /// draft | done
  status        String   @default("draft") @db.VarChar(8)
  /// InventoryLine[]: { goodId, calcQty, actualQty? }
  lines         Json
  writeoffDocId String?  @map("writeoff_doc_id") @db.VarChar(32)
  incomeDocId   String?  @map("income_doc_id") @db.VarChar(32)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     String?  @map("created_by") @db.VarChar(32)
  updatedBy     String?  @map("updated_by") @db.VarChar(32)
  version       Int      @default(1)

  @@index([businessId, locationId, date])
  @@index([warehouseId])
  @@map("inventories")
}

/// Оборудование (⭐ F-00-141)
model Equipment {
  id                    String    @id @db.VarChar(32)
  businessId            String    @map("business_id") @db.VarChar(32)
  locationId            String    @map("location_id") @db.VarChar(32)
  name                  String    @db.VarChar(160)
  category              String?   @db.VarChar(80)
  purchaseDate          DateTime  @map("purchase_date") @db.DateTime(3)
  warrantyUntil         DateTime? @map("warranty_until") @db.DateTime(3)
  serviceIntervalMonths Int?      @map("service_interval_months")
  lastServiceDate       DateTime? @map("last_service_date") @db.DateTime(3)
  replaceReminderDate   DateTime? @map("replace_reminder_date") @db.DateTime(3)
  comment               String?   @db.VarChar(400)
  archived              Boolean   @default(false)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy             String?   @map("created_by") @db.VarChar(32)
  updatedBy             String?   @map("updated_by") @db.VarChar(32)
  version               Int       @default(1)

  @@index([businessId, locationId, archived])
  @@map("equipment")
}

/// ⭐ F-00-142: «своими словами» — единственный персистентный вид напоминания (остальные виды считаются на лету)
model StockReminder {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  locationId String   @map("location_id") @db.VarChar(32)
  staffId    String?  @map("staff_id") @db.VarChar(32)
  text       String   @db.VarChar(500)
  date       DateTime @db.DateTime(3)
  done       Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)

  @@index([businessId, locationId, date])
  @@map("stock_reminders")
}

/// Настройки склада (F-08-096…100), одна строка на бизнес
model StockSettings {
  businessId        String   @id @map("business_id") @db.VarChar(32)
  /// lastPurchase | average | fromGoodSettings
  costMethod        String   @default("lastPurchase") @map("cost_method") @db.VarChar(20)
  forbidOnShortage  Boolean  @default(false) @map("forbid_on_shortage")
  expiryWarningDays Int      @default(14) @map("expiry_warning_days")
  adsOptIn          Boolean  @default(false) @map("ads_opt_in")
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy         String?  @map("updated_by") @db.VarChar(32)

  @@map("stock_settings")
}

// ─────────────────────────── Этап 14: Зарплата (docs/backend/02-api.md §14, domain/payroll.ts) ───────────────────────────

/// «Основные настройки» филиала (F-09-004/005/007/008/009/100/101) — одна строка на локацию, заводится лениво
/// (ensureSettings), как касса/склад этапов 12/13. Хранит GeneralSettings мока один в один.
model PayrollSettings {
  locationId                String   @id @map("location_id") @db.VarChar(32)
  businessId                String   @map("business_id") @db.VarChar(32)
  /// visit | received
  accrualDateBasis          String   @default("visit") @map("accrual_date_basis") @db.VarChar(8)
  /// staffAssistBusiness | staffBusiness | staffAssist | staffOnly | businessOnly
  bankCommissionSplit       String   @default("businessOnly") @map("bank_commission_split") @db.VarChar(20)
  assistCompensationEnabled Boolean  @default(false) @map("assist_compensation_enabled")
  multipleAssistantsAllowed Boolean  @default(false) @map("multiple_assistants_allowed")
  /// fullEach | shared
  assistantSplitRule        String   @default("shared") @map("assistant_split_rule") @db.VarChar(10)
  /// simplified | classic
  payrollModel              String   @default("simplified") @map("payroll_model") @db.VarChar(10)
  statementApprovalEnabled  Boolean  @default(false) @map("statement_approval_enabled")
  payrollFundTargetPct      Int      @default(30) @map("payroll_fund_target_pct")
  payrollFundWarnPct        Int      @default(40) @map("payroll_fund_warn_pct")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy                 String?  @map("updated_by") @db.VarChar(32)
  version                   Int      @default(1)

  @@index([businessId])
  @@map("payroll_settings")
}

/// Упрощённая схема сотрудника (F-09-002/010…048) — шесть блоков как JSON, форма PayrollScheme мока минус
/// staffId/createdAt/updatedAt (те — колонки строки: createdAt не трогается правкой, F-09-037 условие 3).
model PayrollScheme {
  staffId    String   @id @map("staff_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// { personalServices, productSales, workday, records, extraServiceRevenue, extraProductRevenue }
  data       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  @@index([businessId])
  @@map("payroll_schemes")
}

/// Классическая модель — «Правила расчёта» (F-09-049/050): те же блоки, что у упрощённой схемы (общий движок,
/// ruleAsScheme мока), плюс себестоимость услуги.
model PayrollRule {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  name       String   @db.VarChar(120)
  /// { personalServices, serviceCostBasis, productSales, workday, records, extraServiceRevenue, extraProductRevenue }
  data       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)
  version    Int      @default(1)

  @@index([businessId])
  @@map("payroll_rules")
}

/// Классическая модель — «Критерии» (F-09-052): условие плана («оборот сотрудника за месяц > X»).
model PayrollCriterion {
  id               String   @id @db.VarChar(32)
  businessId       String   @map("business_id") @db.VarChar(32)
  name             String   @db.VarChar(120)
  /// month | day
  period           String   @default("month") @db.VarChar(5)
  /// turnover | profit | count
  metric           String   @default("turnover") @db.VarChar(10)
  /// staff | location
  scope            String   @default("staff") @db.VarChar(10)
  byServices       Boolean  @default(true) @map("by_services")
  byProducts       Boolean  @default(false) @map("by_products")
  /// Сумма (драмы) для turnover/profit, штуки для count
  threshold        BigInt   @default(0)
  includeDiscounts Boolean  @default(true) @map("include_discounts")
  countCategoryIds Json     @map("count_category_ids")
  countItemIds     Json     @map("count_item_ids")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        String?  @map("created_by") @db.VarChar(32)
  updatedBy        String?  @map("updated_by") @db.VarChar(32)
  version          Int      @default(1)

  @@index([businessId])
  @@map("payroll_criteria")
}

/// Классическая модель — «Схемы расчёта» (плановые графики, F-09-054): standard — всегда одно правило;
/// planned — строки «критерий → правило» сверху вниз, первая выполненная побеждает.
model PayrollChart {
  id             String   @id @db.VarChar(32)
  businessId     String   @map("business_id") @db.VarChar(32)
  name           String   @db.VarChar(120)
  /// standard | planned
  type           String   @default("standard") @db.VarChar(10)
  standardRuleId String?  @map("standard_rule_id") @db.VarChar(32)
  /// PayrollChartPlanRow[]: { criterionId, ruleId }
  planRows       Json     @map("plan_rows")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy      String?  @map("created_by") @db.VarChar(32)
  updatedBy      String?  @map("updated_by") @db.VarChar(32)
  version        Int      @default(1)

  @@index([businessId])
  @@map("payroll_charts")
}

/// Назначение схемы сотруднику с датой начала (F-09-055/099) — действует запись с наибольшей startDate ≤ дате расчёта.
model PayrollChartAssignment {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  chartId    String   @map("chart_id") @db.VarChar(32)
  staffId    String   @map("staff_id") @db.VarChar(32)
  startDate  DateTime @map("start_date") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy  String?  @map("created_by") @db.VarChar(32)

  @@index([businessId, staffId, startDate])
  @@map("payroll_chart_assignments")
}

/// Справочник «Премии и штрафы» (F-09-072) — шаблоны с суммой по умолчанию; удаление шаблона не трогает уже
/// начисленные PayrollSettlementEntry (F-09-072).
model BonusPenaltyType {
  id            String   @id @db.VarChar(32)
  businessId    String   @map("business_id") @db.VarChar(32)
  /// bonus | penalty
  kind          String   @db.VarChar(7)
  name          String   @db.VarChar(120)
  defaultAmount BigInt   @default(0) @map("default_amount")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId])
  @@map("bonus_penalty_types")
}

/// Взаиморасчёты с сотрудником (F-07-159…162/F-09-066…080) — ведомость (kind=sheet), премия/штраф/внеочередное
/// начисление, выплата (kind=payout, привязана к FinOp.id операции «Зарплата персонала»). Сумма всегда
/// положительная — знак вклада в баланс даёт settlementEntrySign(kind) на чтении (penalty/payout = минус).
model PayrollSettlementEntry {
  id          String    @id @db.VarChar(32)
  businessId  String    @map("business_id") @db.VarChar(32)
  locationId  String?   @map("location_id") @db.VarChar(32)
  staffId     String    @map("staff_id") @db.VarChar(32)
  /// sheet | bonus | penalty | adjustment | payout
  kind        String    @db.VarChar(10)
  amount      BigInt    @default(0)
  label       String    @db.VarChar(200)
  comment     String?   @db.VarChar(400)
  periodFrom  DateTime? @map("period_from") @db.DateTime(3)
  periodTo    DateTime? @map("period_to") @db.DateTime(3)
  /// Связанный FinOp — только у payout (F-07-160)
  operationId String?   @map("operation_id") @db.VarChar(32)
  /// draft | accrued — только у kind=sheet (F-09-069); null у остальных = не бывает черновиком
  status      String?   @db.VarChar(8)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  createdBy   String?   @map("created_by") @db.VarChar(32)

  @@index([businessId, staffId, createdAt])
  @@map("payroll_settlement_entries")
}

/// Согласование ведомости (F-09-100) — ключ - id PayrollSettlementEntry(kind=sheet). Без строки — «не начато».
model PayrollStatementApproval {
  sheetId    String   @id @map("sheet_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// pendingReview | reviewed | approved | sentToStaff | signed | paid
  status     String   @default("pendingReview") @db.VarChar(14)
  /// { status, at, by? }[]
  history    Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId])
  @@map("payroll_statement_approvals")
}

// === stage 21 (лейн services+rest) ===
/// Права на раздел «Зарплата» на сотрудника (F-09-085…089) — тонкие права раздела, как StaffReportsPermission
/// у reports (этап 16) и client_fine_rights у clients (этап 5): без права `staff.manage` их не меняет никто,
/// кроме владельца/тех, кому дали schemesAccess (сама точка входа проверяется на сервисе, не здесь).
model PayrollStaffRights {
  staffId    String   @id @map("staff_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// { schemesAccess, calcAccess, accrueAccess, ownOnlyStaffId? } — PayrollStaffRights мока минус staffId/updatedAt
  data       Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)

  @@index([businessId])
  @@map("payroll_staff_rights")
}

// ─────────────────────────── Этап 15 · Сеть (02 §15, PLAN §6 №15) ───────────────────────────
// Устройство сети/филиалов — Network/Business (этап 3). Здесь — то, чего у бизнеса нет: пользователи сети
// без своей строки staff (F-11-024…039), общая клиентская база (F-11-040…053, application-level по businessId
// IN network — своей таблицы не заводит), рассылки (F-11-054…061), планы (F-11-077/078), поля (F-11-126…134) и
// сетевые каталоги услуг/товаров. Услуги/товары сети — ПО ИМЕНИ, как в моке (b03 domain/network.ts): группа —
// это несколько Service/Product с одинаковым именем в разных Business сети, здесь — только то, чего у самой
// строки нет (запрет правки цены/описания, товарная networkGroupId уже на Product с этапа 13).

/// Доступ к сетевым разделам без своей строки staff (F-11-024…035) — свой список прав `NetworkPermissionKey`,
/// НЕ пересекается с 39 правами бизнеса (common/permissions). Владелец сети (Network.ownerUserId) видит всё и
/// строки здесь не имеет — только приглашённые (F-11-024 «Владелец — есть всегда» рисуется на фронте отдельно).
model NetworkUser {
  id                  String    @id @db.VarChar(32)
  networkId           String    @map("network_id") @db.VarChar(32)
  /// этап 21: null пока приглашение по телефону не подтверждено (pending=true, F-11-025)
  userId              String?   @map("user_id") @db.VarChar(32)
  name                String    @db.VarChar(160)
  /// этап 21: необязателен — пользователь с логином+паролем (F-11-026) может не иметь телефона вовсе
  phone               String?   @db.VarChar(16)
  email               String?   @db.VarChar(160)
  /// NetworkPermissionKey[] (network.schemas.ts) — плоский список, как ALL_NETWORK_PERMISSIONS мока
  permissions         Json
  /// Сеть7: филиалы, к которым доступ (string[]); null — все филиалы сети, включая будущие
  businessIds         Json?     @map("business_ids")
  /// off | daily | weekly | monthly (F-11-030)
  planReportFrequency String?   @map("plan_report_frequency") @db.VarChar(8)
  lastVisitAt         DateTime? @map("last_visit_at") @db.DateTime(3)
  // === stage 21 (лейн network+reports) ===
  /// F-11-025: приглашение по телефону отправлено, аккаунта ещё нет — userId=null, ждёт саморегистрации
  pending             Boolean   @default(false)
  /// F-11-026: вход логином+паролем (владелец решил — не телефон+код, ANSWERS.md 28.09) — id строки StaffLogin
  /// с businessId=null/staffId=null (та же модель входа, что у администратора бизнеса, common/passwords.ts);
  /// без формальной Prisma-relation — StaffLogin не «свой» для этого лейна, схему той модели не трогаем.
  staffLoginId        String?   @map("staff_login_id") @db.VarChar(32)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy           String?   @map("created_by") @db.VarChar(32)
  updatedBy           String?   @map("updated_by") @db.VarChar(32)
  version             Int       @default(1)

  network Network @relation(fields: [networkId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@unique([networkId, userId])
  @@index([userId])
  @@index([staffLoginId])
  @@map("network_users")
}

/// Поле записи/клиента сети (F-11-126…134) — одна форма для обоих kind, как во фронте (NetworkField)
model NetworkField {
  id                        String   @id @db.VarChar(32)
  networkId                 String   @map("network_id") @db.VarChar(32)
  /// booking | client
  kind                      String   @db.VarChar(8)
  name                      String   @db.VarChar(160)
  /// text | number | list | date | datetime
  dataType                  String   @map("data_type") @db.VarChar(10)
  /// только латиница/цифры/«. - _» (F-11-127)
  apiKey                    String   @map("api_key") @db.VarChar(60)
  /// string[] — только у dataType=list
  listOptions               Json     @map("list_options")
  editableByUser            Boolean  @default(false) @map("editable_by_user")
  showInAdmin               Boolean  @default(true) @map("show_in_admin")
  alwaysShowInBookingWindow Boolean  @default(false) @map("always_show_in_booking_window")
  requiredOnCreate          Boolean  @default(false) @map("required_on_create")
  requiredOnArrived         Boolean  @default(false) @map("required_on_arrived")
  /// только у kind=client (F-11-128)
  alwaysShowInClientCard    Boolean  @default(false) @map("always_show_in_client_card")
  /// «Дата и время» никогда не выводится в виджет (F-11-129), даже если true
  showInWidget              Boolean  @default(false) @map("show_in_widget")
  requiredInWidget          Boolean  @default(false) @map("required_in_widget")
  /// Id бизнесов сети, где поле действует
  businessIds               Json     @map("business_ids")
  createdAt                 DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy                 String?  @map("created_by") @db.VarChar(32)
  updatedBy                 String?  @map("updated_by") @db.VarChar(32)
  version                   Int      @default(1)

  network Network @relation(fields: [networkId], references: [id])

  @@unique([networkId, kind, apiKey])
  @@index([networkId, kind])
  @@map("network_fields")
}

/// Сетевая категория услуг — надстройка сверх ServiceCategory (F-11-079/080): группа — совпадение имени по
/// нижнему регистру (`key`) среди категорий businessId IN network; здесь — только то, чего у ServiceCategory
/// нет (подразделение, «имя для онлайн-записи» отдельное от самой категории).
model NetworkServiceCategoryLink {
  networkId     String   @map("network_id") @db.VarChar(32)
  key           String   @db.VarChar(160)
  subdivisionId String?  @map("subdivision_id") @db.VarChar(32)
  onlineName    String?  @map("online_name") @db.VarChar(160)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  network Network @relation(fields: [networkId], references: [id])

  @@id([networkId, key])
  @@map("network_service_category_links")
}

/// Запрет правки цены/описания сетевой услуги в филиале (F-11-082/083) — ключ по совпадению имени, как выше
model NetworkServiceLock {
  networkId         String   @map("network_id") @db.VarChar(32)
  key               String   @db.VarChar(160)
  priceLocked       Boolean  @default(false) @map("price_locked")
  descriptionLocked Boolean  @default(false) @map("description_locked")
  onlineName        String?  @map("online_name") @db.VarChar(160)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  network Network @relation(fields: [networkId], references: [id])

  @@id([networkId, key])
  @@map("network_service_locks")
}

/// Сетевая категория товаров — надстройка сверх product_categories (F-11-111/112), тот же приём, что услуги
/// выше: своя строка только хранит имя/родителя сети, состав по филиалам — совпадение имени категории.
model NetworkGoodsCategoryLink {
  id        String   @id @db.VarChar(32)
  networkId String   @map("network_id") @db.VarChar(32)
