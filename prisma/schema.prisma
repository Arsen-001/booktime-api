// === stage 21 ===
// Аудит фасадов, лейн «resources» (PLAN §6 строка 21): src/api/resources.ts зовёт readCore/readArea мимо
// сервера в 40 функциях (docs/PROGRESS.md, этап 21 попытка 2). Групповые события/участники/лист ожидания уже
// на сервере (этап 7, GroupEvent/Booking/WaitlistEntry) — здесь только то, чего там нет: расписание серии
// событий по дням недели (F-16-067…077, отдельно от BookingSeries — та серия про ОДНУ повторяющуюся запись
// клиента, не про правило нескольких дней недели группового события) и расписание посещений клиента (F-16-078…080).
// Ассистенты/автосписание/товары участника/оплата участника (F-16-059…062, 136…147) хранятся в Booking.extras
// (уже JSON, уже общий для всех разделов) — без своей таблицы. Настройки-списки (шаблоны повтора, категории
// событий, настройки ассистентов, «несколько мест», тонкие права) — в BusinessSetting(area='resources'),
// тот же приём, что splitByResource этапа 4.

/// Расписание (серия) группового события по дням недели (F-16-067…077) — надстройка над GroupEvent.seriesId:
/// правило по дням, дата окончания, какие события серии стали «уникальными» (правились отдельно, F-16-074/075).
model EventSeriesDef {
  id             String   @id @db.VarChar(32)
  businessId     String   @map("business_id") @db.VarChar(32)
  locationId     String   @map("location_id") @db.VarChar(32)
  staffId        String   @map("staff_id") @db.VarChar(32)
  serviceId      String   @map("service_id") @db.VarChar(32)
  capacity       Int
  /// SeriesDayRule[]: { weekday, startTime, durationMin, resourceIds }
  days           Json
  /// Местная дата 'YYYY-MM-DD'
  endDate        String   @map("end_date") @db.VarChar(10)
  sourceEventId  String   @map("source_event_id") @db.VarChar(32)
  /// Id событий серии, изменённых отдельно — правки серии их больше не трогают (F-16-074/075)
  uniqueEventIds Json     @map("unique_event_ids")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy      String?  @map("created_by") @db.VarChar(32)

  @@index([businessId])
  @@map("event_series_defs")
}

/// «Абонемент на серию» (F-16-078…080): клиент попадает во все события серии в отмеченные дни недели
model VisitScheduleEntry {
  id          String   @id @db.VarChar(32)
  seriesId    String   @map("series_id") @db.VarChar(32)
  businessId  String   @map("business_id") @db.VarChar(32)
  clientId    String?  @map("client_id") @db.VarChar(32)
  clientName  String   @map("client_name") @db.VarChar(160)
  clientPhone String   @map("client_phone") @db.VarChar(20)
  /// 0 = понедельник … 6 = воскресенье
  weekdays    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([seriesId])
  @@map("visit_schedule_entries")
}

// Аудит фасадов, лейн «client» (PLAN §6 строка 21, docs/PROGRESS.md «этап 21, лейн client»): отзывы (В-24,
// F-14-013/F-14-014) — единственная часть исходного счёта «63», для которой на сервере не было вообще
// никакого модуля (StaffReview заменяет StarRating, когда online.reviewMode='text'; LocationReview — отзыв о
// месте, без модерации). Обе — новые таблицы, читают/пишут только src/modules/client/me.service.ts +
// catalog.service.ts, не трогают ничего из блока «resources» выше.

/// Отзыв о мастере — оценка 1–5 и необязательный текст (В-24, F-14-013 1:1 с Altegio), заменяет StarRating для
/// бизнеса с online.reviewMode='text'. Одна запись на клиента на мастера (можно менять, пока не удалил визит —
/// правило проверяет me.service.ts по каждому submit, а не хранится здесь). Текст (если есть) уходит на
/// модерацию платформы отдельным ModerationItem(kind='review', refId=этот id) — рейтинг виден сразу, текст —
/// только после ModerationService.isVisibleToClients(refId).
model StaffReview {
  id         String   @id @db.VarChar(32)
  appUserId  String   @map("app_user_id") @db.VarChar(32)
  staffId    String   @map("staff_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  bookingId  String   @map("booking_id") @db.VarChar(32)
  rating     Int
  text       String?  @db.VarChar(2000)
  /// F-12-069 (В-24, 1:1 с Altegio): бизнес прячет отзыв из онлайн-записи, не удаляя (этап 21 «network+reports»)
  hidden     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([appUserId, staffId])
  @@index([staffId])
  @@index([businessId])
  @@map("staff_reviews")
}

/// Отзыв о месте (F-14-014) — свободный текст, один на визит «пришёл» (не один на бизнес — разные визиты
/// можно оценить отдельно). Публичный список — GET /v1/public/places/:businessId/reviews; фронтовый мок не
/// зовёт submitForModeration для этого отзыва (в отличие от StaffReview.text), поэтому здесь тоже без очереди.
model LocationReview {
  id         String   @id @db.VarChar(32)
  appUserId  String   @map("app_user_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  bookingId  String   @map("booking_id") @db.VarChar(32)
  text       String   @db.VarChar(2000)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@unique([appUserId, bookingId])
  @@index([businessId])
  @@map("location_reviews")
}

