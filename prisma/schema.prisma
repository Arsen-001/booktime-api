// Аудит фасадов, лейн «client+online» (PLAN §6 строка 21, docs/PROGRESS.md): src/api/online.ts зовёт
// readCore/readArea мимо сервера в 51 используемой функции. Бо́льшая часть (заявки на подтверждение,
// правила отмены/переноса, ссылки, свободные окна) уже читает существующие таблицы (Booking.onlineMeta,
// BookingEvent, BookingLink.config) — своей таблицы здесь требует только «Экран данных клиента»
// (F-03-071…075): своих полей у Client/Business для этого нет, и это настройка кабинета, а не срез факта.

/// Настройка экрана «Данные клиента» онлайн-записи (F-03-071…075) — одна строка на бизнес.
model OnlineClientFieldsConfig {
  businessId         String   @id @map("business_id") @db.VarChar(32)
  commentHidden      Boolean  @default(false) @map("comment_hidden")
  commentRequired    Boolean  @default(false) @map("comment_required")
  commentLabel       String   @default("Комментарий к записи") @map("comment_label") @db.VarChar(60)
  emailHidden        Boolean  @default(false) @map("email_hidden")
  emailRequired      Boolean  @default(false) @map("email_required")
  lastNameEnabled    Boolean  @default(false) @map("last_name_enabled")
  lastNameRequired   Boolean  @default(false) @map("last_name_required")
  patronymicEnabled  Boolean  @default(false) @map("patronymic_enabled")
  patronymicRequired Boolean  @default(false) @map("patronymic_required")
  /// CustomClientField[] фронта
  customFields       Json     @map("custom_fields")
  /// LocalizedText фронта
  widgetText         Json     @map("widget_text")
  /// string[]
  partnerBrands      Json     @map("partner_brands")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy          String?  @map("updated_by") @db.VarChar(32)

  @@map("online_client_fields_configs")
}

// === stage 21 (лейн client+online), попытка 2 ===
// Продолжение того же лейна (см. докстринг выше): остаток `online.ts` — 35 функций, тем же приёмом, что уже
// применил лейн finance+stock у FinRecord ниже (одна общая таблица вместо шести маленьких): промоблок
// (F-03-106), пакет услуг (F-03-130), звёздочка-отзыв (F-00-116/117), событие виджета (F-03-121), приглашение
// в окно (F-03-052), лист ожидания виджета (F-03-086, стенд-ин — см. WaitlistRequest в domain/online.ts).
// Фильтрация по полям внутри `data` — в JS, не JSON-путём MySQL (тот же приём, что уже у isSubdomainAvailable
// этого файла и у FinRecord) — масштаб Р20 (500 бизнесов) это позволяет.

model OnlineRecord {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// promoBlock | package | review | widgetEvent | slotInvite | serviceConfig (waitlist — до 01.10.2026, теперь waitlist_entries)
  kind       String   @db.VarChar(20)
  /// widgetEvent: BookingLink.id — фильтр «журнал этой ссылки»
  linkId     String?  @map("link_id") @db.VarChar(32)
  /// review: Booking.id (дедуп «уже поставил звёздочку»); serviceConfig: Service.id
  refId      String?  @map("ref_id") @db.VarChar(32)
  data       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId, kind])
  @@index([linkId, kind])
  @@index([refId, kind])
  @@map("online_records")
}

// === end stage 21 (лейн client+online) ===

// === stage 21 (лейн finance+stock) ===

/// Демо-состояние онлайн-платежей без настоящего провайдера (Р14, F-00-028): ссылки на оплату, снимки и счёт
/// политики оплаты, транзакции Adyen, заказы «оплачено другим способом». Деньги (FinOp/BookingPayment) пишутся
/// своими таблицами — здесь только сам документ-имитация в форме сущности фронта (domain/finance.ts).
model FinRecord {
  id         String   @id @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// paymentLink | policySnapshot | policyEntry | adyenTxn | manualOrder
  kind       String   @db.VarChar(20)
  /// bookingId (ссылка/снимок) или id заказа
  refId      String?  @map("ref_id") @db.VarChar(32)
  clientId   String?  @map("client_id") @db.VarChar(32)
  data       Json
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([businessId, kind, refId])
  @@index([businessId, kind, clientId])
  @@map("fin_records")
}

/// Кассовая смена наличной кассы и её Z-отчёт (fin-review Ф1): пересчёт ящика на открытии и закрытии,
/// расхождение с учётом — отдельной операцией-поправкой (FinOp), её id — в adjustmentOperationIds.
model CashShift {
  id                     String    @id @db.VarChar(32)
  businessId             String    @map("business_id") @db.VarChar(32)
  accountId              String    @map("account_id") @db.VarChar(32)
  /// open | closed
  status                 String    @db.VarChar(10)
  /// Держит «одна открытая смена на кассу» уникальным индексом: = accountId у открытой, NULL у закрытой
  openKey                String?   @unique @map("open_key") @db.VarChar(32)
  openedAt               DateTime  @map("opened_at") @db.DateTime(3)
  openedBy               String    @map("opened_by") @db.VarChar(32)
  openingCash            BigInt    @map("opening_cash")
  expectedAtOpen         BigInt    @map("expected_at_open")
  closedAt               DateTime? @map("closed_at") @db.DateTime(3)
  closedBy               String?   @map("closed_by") @db.VarChar(32)
  countedCash            BigInt?   @map("counted_cash")
  expectedAtClose        BigInt?   @map("expected_at_close")
  adjustmentOperationIds Json      @map("adjustment_operation_ids")
  comment                String?   @db.VarChar(500)

  @@index([businessId, accountId, openedAt])
  @@map("cash_shifts")
}

// === end stage 21 (лейн finance+stock) ===

// === stage 21 (лейн rest), попытка 2 ===

/// Своё напоминание клиенту и приглашение на повторный визит поверх одной записи (F-04-100,
/// clients/settings.ts::getBookingReminder/setBookingReminder) — не общие настройки уведомлений раздела
/// «журнал», а точечная правка одной строки Booking; bookingId не связан внешним ключом намеренно (Booking
/// живёт в модуле journal, чужой лейн — здесь только сама пометка, читающая сторона проверяет businessId сама).
model BookingReminder {
  bookingId         String    @id @map("booking_id") @db.VarChar(32)
  remindAt          DateTime? @map("remind_at") @db.DateTime(3)
  /// 0/NULL — не приглашать отдельно
  revisitInviteDays Int?      @map("revisit_invite_days")
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("booking_reminders")
}

/// Журнал массовых рассылок CRM (F-04-038…040) и разового сообщения из окна записи (F-04-100,
/// clients/bulk.ts). Одна строка на рассылку (audienceCount) или на одно сообщение клиенту (clientId).
model ClientBroadcastMessage {
  id            String   @id @db.VarChar(32)
  businessId    String   @map("business_id") @db.VarChar(32)
  /// sms | push | whatsapp
  channel       String   @db.VarChar(10)
  text          String   @db.VarChar(1000)
  audienceCount Int      @default(1) @map("audience_count")
  /// F-04-100: сообщение из окна записи адресовано одному клиенту, а не рассылке
  clientId      String?  @map("client_id") @db.VarChar(32)
  /// bulk | bookingWindow
  source        String   @default("bulk") @db.VarChar(16)
  sentAt        DateTime @default(now()) @map("sent_at") @db.DateTime(3)

  @@index([businessId, sentAt])
  @@index([clientId, sentAt])
  @@map("client_broadcast_messages")
}

// === end stage 21 (лейн rest), попытка 2 ===

// === stage 21 shortlinks ===
/// Короткие ссылки SMS `booktime.am/s/<code>` (28.09): полная ссылка на запись съедала больше половины SMS
/// (70 символов в кириллице/армянском). Один путь бизнеса — один код (уникально business_id+target).
model ShortLink {
  /// 6 знаков base62 (crypto)
  code       String    @id @db.VarChar(12)
  /// Путь на нашем домене: /b/<slug>/booking/<id>?h=…, /b/<slug>/book
  target     String    @db.VarChar(512)
  businessId String    @map("business_id") @db.VarChar(32)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)

  @@unique([businessId, target])
  @@map("short_links")
}

// === end stage 21 shortlinks ===

// === stage 21 (лейн client+online), попытка 2 ===
// Продолжение лейна client+online (см. докстринги выше в этом файле): `src/api/client.ts` — 80 используемых
// функций (facade-audit.mjs), помимо тех, что делит с лейном loyalty/finance. Три маленьких, самостоятельных
// куска, ни один не пересекается с чужими таблицами: правки автоперевода мастера (F-00-174), настройки
// «Приложение сотрудника» (F-14-116…121), демо-копилка выплат раздела «Приложение» (F-14-127 — сам мок
// называет её «демо-копилка, реальных денег нет», поэтому не через PayrollSettlementEntry/FinOp настоящего
// раздела «Зарплата», которому нужны locationId+accountId — это другая, лёгкая сущность экрана).

/// Правка мастера/бизнеса к автопереводу текста на en (F-00-174, client.ts::getTranslationOverride/
/// listTranslatable/setTranslationOverride) — ключ owner+ownerId+field, как translationKey() мока.
model TranslationOverride {
  id        String   @id @db.VarChar(32)
  owner     String   @db.VarChar(10)
  ownerId   String   @map("owner_id") @db.VarChar(32)
  field     String   @db.VarChar(40)
  text      String   @db.VarChar(4000)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy String?  @map("updated_by") @db.VarChar(32)

  @@unique([owner, ownerId, field])
  @@map("translation_overrides")
}

/// Доступ сотрудника в приложении (F-14-116…121, client.ts::EmployeeAppAccess) — одна строка на сотрудника,
/// нет строки = дефолт (DEFAULT_ACCESS мока), как ClientFineRights/StaffAccountPref у других разделов.
model EmployeeAppAccess {
  staffId    String   @id @map("staff_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  /// EmployeeAppAccess фронта минус staffId
  data       Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy  String?  @map("updated_by") @db.VarChar(32)

  @@index([businessId])
  @@map("employee_app_access")
}

/// «Payouts» раздела «Приложение» (F-14-127) — демо-копилка выплат сотруднику, своя (не настоящая финансовая
/// операция раздела «Зарплата», см. докстринг выше). Общий счётчик без периода — 1:1 с payrollPaid[staffId] мока.
model AppPayrollPayout {
  staffId    String   @id @map("staff_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  paid       BigInt   @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("app_payroll_payouts")
}

// === end stage 21 (лейн client+online), попытка 2 ===

// === stage 21 (лейн client+online), попытка 4 ===
// Продолжение лейна client+online: «Визит-микрокасса» (F-14-092…098) — `client.ts::listVisitCandidates/
// getVisitDetail/addVisitSaleLine/removeVisitSaleLine/addVisitPayment/removeVisitPayment/refundVisitPayment/
// listNoAppRemindersTomorrow/sendVisitReceipt/isVisitReceiptSent`. Мок сам документирует архитектуру (комментарий
// у VisitCashDesk в domain/client.ts): «настоящие кассы живут в разделе finance и сюда не проброшены» — то есть
// это заведомо ОТДЕЛЬНАЯ, лёгкая демо-касса приложения, а не витрина над Booking/FinOp/BookingPayment раздела
// finance (тот же принцип уже применён к AppPayrollPayout выше). Одна таблица на обе строки визита (продажа
// товара/абонемента/сертификата и оплата), как OnlineRecord/FinRecord — различает `kind`. «Квитанция отправлена»
// не хранится отдельной строкой: проверяется существованием InboxItem(kind='receipt', bookingId) — тот же приём,
// что sendOneOffPush пишет 'broadcast'.
model VisitCashRecord {
  id         String    @id @db.VarChar(32)
  businessId String    @map("business_id") @db.VarChar(32)
  bookingId  String    @map("booking_id") @db.VarChar(32)
  /// saleLine | payment
  kind       String    @db.VarChar(12)
  /// saleLine: VisitSaleLine фронта минус id/bookingId; payment: VisitPaymentLine фронта минус id/bookingId
  data       Json
  /// Только у payment — «Make a refund» не стирает строку (F-14-095)
  refundedAt DateTime? @map("refunded_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([bookingId, kind])
  @@index([businessId, kind])
  @@map("visit_cash_records")
}

// === end stage 21 (лейн client+online), попытка 4 ===

// === stage 21 (сдача, попытка 4) ===
/// Настройки сети одной строкой на область (как BusinessSetting у бизнеса): `planEmailSchedule` (F-12-081),
/// `telephony` (F-11-146…152 — Р19: чужая телефония, сервер хранит только «подключено» + маршруты/правила).
model NetworkSetting {
  networkId String   @map("network_id") @db.VarChar(32)
  area      String   @db.VarChar(40)
  data      Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy String?  @map("updated_by") @db.VarChar(32)

  @@id([networkId, area])
  @@map("network_settings")
}
// === end stage 21 (сдача, попытка 4) ===

// === stage 21 (лейн notify-log+mailings) ===
// Журнал отправок экрана «Уведомления → Журнал» (F-05-107/108/130, Ув11/Ув16) и рассылки (F-05-095…099, Ув13).
// Строки журнала — материализованный вывод каталога типов (NotifyRichTypesService, 29+2) из booking_events/bookings/
// clients (порт src/areas/notify/lib/liveLog.ts) + служебные (рассылка, тест, разовое сообщение). Один ключ дубля на
// строку: повторный проход синхронизации не плодит строки. Пагинация по (business_id, sent_at) — фильтры экрана
// (канал/статус/тип/клиент/запись) индексированы.

model NotifyLogEntry {
  id           String    @id @db.VarChar(32)
  businessId   String    @map("business_id") @db.VarChar(32)
  /// Детерминированный ключ вывода (live:ev_<eventId>, live:rm_<bookingId>…) или ml:<mailingId> — повтор не плодит строку
  dedupeKey    String    @unique @map("dedupe_key") @db.VarChar(120)
  /// Когда ушло (UTC)
  sentAt       DateTime  @map("sent_at") @db.DateTime(3)
  /// Код типа каталога (F-05-004); нет — служебная строка (рассылка, тест…)
  typeCode     Int?      @map("type_code")
  /// LocalizedText
  typeLabel    Json      @map("type_label")
  /// push | adminApp | email | sms | brandedApp | whatsapp | telegram
  channel      String    @db.VarChar(12)
  /// LogStatus фронта
  status       String    @db.VarChar(24)
  contact      String    @db.VarChar(160)
  /// LocalizedText — текст на всех языках, `sentLanguage` — на каком ушло
  text         Json
  clientId     String?   @map("client_id") @db.VarChar(32)
  staffId      String?   @map("staff_id") @db.VarChar(32)
  bookingId    String?   @map("booking_id") @db.VarChar(32)
  sentLanguage String?   @map("sent_language") @db.VarChar(2)
  costAmd      Int       @default(0) @map("cost_amd")
  smsParts     Int?      @map("sms_parts")
  /// Исходный момент, если тихие часы перенесли отправку (Ув12)
  deferredFrom DateTime? @map("deferred_from") @db.DateTime(3)
  /// live | mailing | test | oneOff | service
  source       String    @db.VarChar(8)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  @@index([businessId, sentAt])
  @@index([businessId, channel, sentAt])
  @@index([businessId, status, sentAt])
  @@index([businessId, typeCode, sentAt])
  @@index([clientId, sentAt])
  @@index([bookingId])
  @@map("notify_log_entries")
}

/// До какого момента журнал бизнеса уже выведен из событий (синхронизация идёт окном от этого момента)
model NotifyLogSync {
  businessId  String   @id @map("business_id") @db.VarChar(32)
  syncedUntil DateTime @map("synced_until") @db.DateTime(3)

  @@map("notify_log_sync")
}

/// Рассылка (F-05-095…099, Ув13): сразу или по расписанию; по сети — одна строка у бизнеса-отправителя
model NotifyMailing {
  id              String    @id @db.VarChar(32)
  businessId      String    @map("business_id") @db.VarChar(32)
  /// sms | pushOwnApp | pushClientApp
  channel         String    @db.VarChar(16)
  text            String    @db.Text
  audienceLabel   String    @map("audience_label") @db.VarChar(400)
  recipientsCount Int       @default(0) @map("recipients_count")
  /// sent | sending | failed | scheduled
  status          String    @db.VarChar(10)
  network         Boolean   @default(false)
  /// string[] — филиалы-получатели
  businessIds     Json      @map("business_ids")
  /// AudienceFilter фронта — для отложенной отправки аудитория считается в момент отправки
  filter          Json
  scheduledAt     DateTime? @map("scheduled_at") @db.DateTime(3)
  sentAt          DateTime? @map("sent_at") @db.DateTime(3)
  costAmd         Int       @default(0) @map("cost_amd")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  createdBy       String?   @map("created_by") @db.VarChar(32)

  @@index([businessId, createdAt])
  @@index([status, scheduledAt])
  @@map("notify_mailings")
}

/// Кто получил рассылку (F-05-096 «получал / не получал рассылку за N дней»)
model NotifyMailingRecipient {
  mailingId  String   @map("mailing_id") @db.VarChar(32)
  clientId   String   @map("client_id") @db.VarChar(32)
  businessId String   @map("business_id") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@id([mailingId, clientId])
  @@index([businessId, createdAt])
  @@index([clientId])
  @@map("notify_mailing_recipients")
}
// === end stage 21 (лейн notify-log+mailings) ===

// === stage 21 (сдача, попытка 6: маркетплейс интеграций) ===
/// Каталог приложений маркетплейса (F-13-002…013, F-13-210). Раньше жил только во фронте (этап 17, Р19 — «витрина»);
/// этап 21 требует все фасады на сервере, поэтому карточка целиком хранится здесь, сид — из того же каталога мока
