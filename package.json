{
  "name": "booktime-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BookTime — сервер для booking-platform (docs/backend/PLAN.md во фронте)",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "start:api": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "openapi": "npm run build && node dist/openapi.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "commit": "node scripts/commit.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "build:prod": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node scripts/railway-start.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.4.0",
    "@types/web-push": "^3.6.4",
    "bullmq": "^6.3.9",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.4",
    "ioredis": "^6.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "isomorphic-git": "^1.42.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
