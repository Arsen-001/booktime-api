# BookTime backend — только переменные окружения, никаких адресов хостинга в коде (PLAN.md §2).
# Локально: cp .env.example .env && npm run db:up

NODE_ENV=development
# HTTP API (фронт booking-platform — на :3710)
PORT=4010
# Откуда разрешены запросы с cookie сессии (через запятую)
CORS_ORIGINS=http://localhost:3710

# MySQL (docker-compose.yml → порт 3316 на машине). Всё в UTC (PLAN.md §4.1)
DATABASE_URL=mysql://booktime:booktime@localhost:3316/booktime
# Отдельная база для prisma migrate dev (теневая)
SHADOW_DATABASE_URL=mysql://root:booktime-root@localhost:3316/booktime_shadow

# Redis (очереди BullMQ, кеш окон, лимиты, SSE pub/sub) — порт 6389
REDIS_URL=redis://localhost:6389

# Хранилище файлов: local — папка на диске; s3 — любое хранилище с API S3 (адаптер, PLAN.md §2)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=booktime
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Логи: trace | debug | info | warn | error
LOG_LEVEL=info
