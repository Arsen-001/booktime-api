# BookTime backend — только переменные окружения, никаких адресов хостинга в коде (PLAN.md §2).
# Локально: cp .env.example .env && npm run db:up

NODE_ENV=development
# HTTP API (фронт booking-platform — на :3710)
PORT=4010
# Откуда разрешены запросы с cookie сессии (через запятую)
CORS_ORIGINS=http://localhost:3710

# MySQL (docker-compose.yml → порт 3316 на машине). Всё в UTC (PLAN.md §4.1)
DATABASE_URL=mysql://booktime:booktime@localhost:3316/booktime
# Отдельная база для prisma migrate dev (теневая)
SHADOW_DATABASE_URL=mysql://root:booktime-root@localhost:3316/booktime_shadow

# Redis (очереди BullMQ, кеш окон, лимиты, SSE pub/sub) — порт 6389
REDIS_URL=redis://localhost:6389

# Хранилище файлов: local — папка на диске; s3 — любое хранилище с API S3 (адаптер, PLAN.md §2)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=booktime
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Логи: trace | debug | info | warn | error
LOG_LEVEL=info

# Вход (этап 2). Telegram Gateway: токен из https://gateway.telegram.org — без него код пишется в лог (заглушка)
TELEGRAM_GATEWAY_TOKEN=
# WhatsApp Business Cloud API (Meta): заданы токен и Phone number ID — канал «WhatsApp» включён (по просьбе человека
# и запасной, если Telegram не доставил); пусто — канала нет. Шаблон — категория AUTHENTICATION с кнопкой «Copy code».
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=booktime_login_code
# Языки, на которых шаблон одобрен (первый — для остальных локалей): ru,en или ru,hy,en
WHATSAPP_TEMPLATE_LANGS=ru,en
WHATSAPP_API_VERSION=v23.0
# SMS — последний запасной канал (дорогой). Пусто — канала нет. Провайдер: twilio (армянский — потом, тем же интерфейсом)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Отправитель: номер Twilio или Alphanumeric Sender ID (BookTime) — либо Messaging Service SID (MG…), он предпочтительнее
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Защита от накрутки SMS: только эти префиксы номеров и не больше стольких SMS с кодом в час на весь сервис
SMS_ALLOWED_PREFIXES=+374
SMS_MAX_PER_HOUR=100
# «Войти через Google»: OAuth Client ID (Google Cloud Console → Credentials). Несколько (web, android, ios) — через
# запятую. Пусто — вход через Google выключен. Фронту — тот же web Client ID в NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Постоянный код входа — ТОЛЬКО при NODE_ENV=development (в остальных средах сервер его не принимает)
DEV_LOGIN_CODE=0000
# Cookie сессии: домен (прод: .booktime.am) и только-HTTPS (прод: 1)
COOKIE_DOMAIN=
COOKIE_SECURE=0
SESSION_TTL_DAYS=60

# Уведомления (этап 10). VAPID: `npx web-push generate-vapid-keys` — есть ключ, Web Push уходит по-настоящему,
# нет — заглушка пишет в лог. FCM: JSON сервисного аккаунта Firebase (Project Settings → Service accounts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@booktime.am
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Telegram-бот напоминаний (30.09.2026). Токен — у @BotFather (/newbot); без токена сообщения бота пишутся в лог.
# Прод: вебхук https://<api>/v1/telegram/webhook с секретом (setWebhook secret_token = TELEGRAM_WEBHOOK_SECRET).
# Разработка без публичного адреса: TELEGRAM_BOT_POLLING=1 — воркер сам забирает обновления (getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=booktime_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_POLLING=0
# Адрес сайта для ссылок в сообщениях бота (кнопка «Перенести» → <адрес>/b/<slug>)
PUBLIC_SITE_URL=https://booktime.am

# Сид (только `npx prisma db seed`, сервер их не читает): папка фронта с моком (по умолчанию ../booking-platform)
# и «сегодня» демо-данных (по умолчанию — текущий момент), напр. 2026-09-27T09:00:00Z
# FRONTEND_DIR=
# SEED_NOW=
