# BookTime backend — только переменные окружения, никаких адресов хостинга в коде (PLAN.md §2).
# Локально: cp .env.example .env && npm run db:up

NODE_ENV=development
# HTTP API (фронт booking-platform — на :3710)
PORT=4010
# Откуда разрешены запросы с cookie сессии (через запятую)
CORS_ORIGINS=http://localhost:3710
# Сколько прокси перед API: Railway — 1 (IP для лимитов — из X-Forwarded-For); локально — пусто
TRUST_PROXY=
# Общий секрет с сайтом (заголовок X-BT-SSR от SSR на Vercel): публичные GET-лимиты × SSR_RATE_MULTIPLIER. Пусто — обычные лимиты.
# То же значение — SSR_SHARED_SECRET в проекте Vercel. Сгенерировать: openssl rand -hex 32
SSR_SHARED_SECRET=
SSR_RATE_MULTIPLIER=20

# MySQL (docker-compose.yml → порт 3316 на машине). Всё в UTC (PLAN.md §4.1)
DATABASE_URL=mysql://booktime:booktime@localhost:3316/booktime
# Отдельная база для prisma migrate dev (теневая)
SHADOW_DATABASE_URL=mysql://root:booktime-root@localhost:3316/booktime_shadow

# Redis (очереди BullMQ, кеш окон, лимиты, SSE pub/sub) — порт 6389
REDIS_URL=redis://localhost:6389

# Файлы и фото (04.10.2026). Заданы все четыре S3_BUCKET, S3_ENDPOINT, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY — фото
# и выгрузки идут в S3-совместимое хранилище (AWS S3, Cloudflare R2, Railway Buckets); иначе диск: фото — UPLOADS_DIR
# (по умолчанию ./.uploads, в production /data/uploads), раздаёт API по GET /v1/files/<key>; выгрузки — STORAGE_DIR.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# UPLOADS_DIR=./.uploads
S3_ENDPOINT=
# R2: auto; AWS: регион бакета
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес бакета (https://files.booktime.am) — ссылки на фото прямо туда; пусто — фото раздаёт API
S3_PUBLIC_URL=
# S3_FORCE_PATH_STYLE=1
# Адрес API для ссылок на фото (https://api.booktime.am); пусто — из заголовков запроса
PUBLIC_API_URL=
# Предел фото и документов клиентов на бизнес, МБ
# UPLOADS_QUOTA_MB=2048
# Документы клиентов на диске — закрытые, не раздаются /v1/files (production: /data/private)
# PRIVATE_FILES_DIR=./.private
# Ночная уборка неиспользуемых загрузок (старше 7 дней, без ссылок): 1 — удалять, пусто — только отчёт в лог воркера
UPLOADS_CLEANUP=

# Логи: trace | debug | info | warn | error
LOG_LEVEL=info

# Вход (этап 2). Telegram Gateway: токен из https://gateway.telegram.org — без него код пишется в лог (заглушка)
TELEGRAM_GATEWAY_TOKEN=
# WhatsApp Business Cloud API (Meta): заданы токен и Phone number ID — канал «WhatsApp» включён (по просьбе человека
# и запасной, если Telegram не доставил); пусто — канала нет. Шаблон — категория AUTHENTICATION с кнопкой «Copy code».
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=booktime_login_code
# Языки, на которых шаблон одобрен (первый — для остальных локалей): ru,en или ru,hy,en
WHATSAPP_TEMPLATE_LANGS=ru,en
WHATSAPP_API_VERSION=v23.0
# SMS — последний запасной канал (дорогой). Пусто — канала нет. Провайдер: twilio (армянский — потом, тем же интерфейсом)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Отправитель: номер Twilio или Alphanumeric Sender ID (BookTime) — либо Messaging Service SID (MG…), он предпочтительнее
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Защита от накрутки SMS: только эти префиксы номеров и не больше стольких SMS с кодом в час на весь сервис
SMS_ALLOWED_PREFIXES=+374
SMS_MAX_PER_HOUR=100
# «Войти через Google»: OAuth Client ID (Google Cloud Console → Credentials). Несколько (web, android, ios) — через
# запятую. Пусто — вход через Google выключен. Фронту — тот же web Client ID в NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# «Войти через Apple»: bundle id приложений и Services ID сайта (Apple Developer → Identifiers) через запятую, например
# am.booktime.app,am.booktime.business. Пусто — вход через Apple выключен.
APPLE_CLIENT_IDS=
# Отзыв входа через Apple при удалении аккаунта (App Store 5.1.1(v)): ключ Sign in with Apple (Apple Developer → Keys,
# .p8). Пусто — вход работает, токены не сохраняются и не отзываются (предупреждение в логе).
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Содержимое .p8 целиком (переводы строк можно \n)
APPLE_PRIVATE_KEY=
# Ключ шифрования секретов в базе (refresh token Apple): openssl rand -base64 32. Не менять после запуска.
SECRETS_KEY=
# Постоянный код входа — ТОЛЬКО при NODE_ENV=development (в остальных средах сервер его не принимает)
DEV_LOGIN_CODE=0000
# Оплата подписки и монет: провайдер (ArCa / Idram / Telcell) не выбран. Пусто — заглушка «платёж прошёл» только при
# NODE_ENV=development/test; иначе оплаты выключены (503 payments_unavailable). 1 — заглушка и в production-сборке
# (на Railway НЕ задавать; в окружении Railway production игнорируется), 0 — выключить и при разработке.
PAYMENTS_FAKE=
# Вход проверяющих App Store / Google Play: оба заданы — эти номера входят постоянным кодом, сообщение не отправляется.
# Пусто — выключено (по умолчанию). Включает владелец на Railway (booking-platform/docs/store/review-notes.md).
REVIEW_LOGIN_PHONES=
REVIEW_LOGIN_CODE=
# Cookie сессии: домен (прод: .booktime.am) и только-HTTPS (прод: 1)
COOKIE_DOMAIN=
COOKIE_SECURE=0
SESSION_TTL_DAYS=60

# Уведомления (этап 10). VAPID: `npx web-push generate-vapid-keys` — есть ключ, Web Push уходит по-настоящему,
# нет — заглушка пишет в лог. FCM: JSON сервисного аккаунта Firebase (Project Settings → Service accounts).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@booktime.am
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Telegram-бот напоминаний (30.09.2026). Токен — у @BotFather (/newbot); без токена сообщения бота пишутся в лог.
# Прод: вебхук https://<api>/v1/telegram/webhook с секретом (setWebhook secret_token = TELEGRAM_WEBHOOK_SECRET).
# Разработка без публичного адреса: TELEGRAM_BOT_POLLING=1 — воркер сам забирает обновления (getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=booktime_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_POLLING=0
# Адрес сайта для ссылок в сообщениях бота (кнопка «Перенести» → <адрес>/b/<slug>)
PUBLIC_SITE_URL=https://booktime.am

# Сид (только `npx prisma db seed`, сервер их не читает): папка фронта с моком (по умолчанию ../booking-platform)
# и «сегодня» демо-данных (по умолчанию — текущий момент), напр. 2026-09-27T09:00:00Z
# FRONTEND_DIR=
# SEED_NOW=

# Ежедневная копия базы (jobs/db-backup.ts) — только production
# DB_BACKUP=1
# DB_BACKUP_DIR=/data/backups
# DB_BACKUP_KEEP=14

# Sentry (мониторинг ошибок): DSN проекта booktime-api; пусто — выключен
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=
